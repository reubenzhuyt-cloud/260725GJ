  itemId: T06
  displayName: "\u300A\u4FB5\u8680\u4F20\u64AD\u8DEF\u5F84\u8BB0\u5F55\u300B"
  hoverDescription: "\u6807\u6CE8\u6269\u6563\u8303\u56F4\u7684\u624B\u7ED8\u56FE"
  description: "\u4E00\u4EFD\u7528\u94C5\u7B14\u624B\u7ED8\u7684\u5730\u56FE\uFF0C\u88AB\u4ED4\u7EC6\u5730\u6298\u6210\u56DB\u6298\uFF0C\u585E\u5728\u4E00\u4E2A\u91D1\u5C5E\u94C5\u7B14\u76D2\u91CC\u3002\u94C5\u7B14\u76D2\u751F\u9508\u4E25\u91CD\uFF0C\u6253\u5F00\u65F6\u53D1\u51FA\u4E86\u523A\u8033\u7684\u91D1\u5C5E\u6469\u64E6\u58F0\u3002\u5730\u56FE\u672C\u8EAB\u753B\u5728\u666E\u901A\u7684\u6A2A\u7EBF\u7B14\u8BB0\u672C\u7EB8\u4E0A\uFF0C\u7EB8\u9762\u5DF2\u7ECF\u6CDB\u9EC4\u3001\u53D8\u8106\u3002\u5730\u56FE\u63CF\u7ED8\u7684\u662F\u65C5\u9986\u53CA\u5176\u5468\u8FB9\u533A\u57DF\uFF0C\u4F46\u6BD4\u4F8B\u5F88\u5947\u602A\u2014\u2014\u65C5\u9986\u88AB\u753B\u5F97\u975E\u5E38\u5DE8\u5927\uFF0C\u5360\u636E\u4E86\u56FE\u7EB8\u7684\u5927\u534A\uFF0C\u800C\u5468\u8FB9\u7684\u5C71\u4E18\u548C\u9053\u8DEF\u88AB\u538B\u7F29\u5230\u8FB9\u7F18\u3002\u56FE\u7EB8\u4E0A\u6709\u5927\u91CF\u7528\u94C5\u7B14\u6807\u6CE8\u7684\u6570\u5B57\u548C\u65E5\u671F\uFF0C\u8FD8\u6709\u4E00\u4E9B\u7BAD\u5934\uFF0C\u6307\u5411\u4E0D\u540C\u7684\u65B9\u5411\u3002"
  readableContent: "\u5730\u56FE\u4E2D\u592E\u6807\u7740\u201C\u65C5\u9986\u201D\u4E24\u4E2A\u5B57\uFF0C\u5468\u56F4\u753B\u7740\u8BB8\u591A\u540C\u5FC3\u5706\u2014\u2014\u4E0D\u662F\u6807\u51C6\u7684\u5706\u5F62\uFF0C\u800C\u662F\u4E0D\u89C4\u5219\u7684\u6CE2\u7EB9\uFF0C\u50CF\u662F\u624B\u7ED8\u7684\uFF0C\u4E00\u8FB9\u753B\u4E00\u8FB9\u6539\uFF0C\u6709\u7684\u91CD\u53E0\u8D77\u6765\u3002\u6BCF\u4E2A\u540C\u5FC3\u5706\u9644\u8FD1\u90FD\u6709\u65E5\u671F\u6807\u6CE8\uFF0C\u65F6\u95F4\u8DE8\u5EA6\u5927\u7EA6\u5728\u4E09\u5E74\u5DE6\u53F3\u3002\u6700\u5916\u5C42\u7684\u6CE2\u7EB9\u65C1\u8FB9\u6709\u4E00\u884C\u5C0F\u5B57\uFF0C\u662F\u8FD9\u4EFD\u56FE\u7EB8\u4E0A\u6700\u597D\u8FA8\u8BA4\u7684\u5B57\u8FF9\uFF1A\n\n\u201C\u6211\u753B\u4E86\u4E09\u5E74\u3002\u6BCF\u6B21\u5B83\u90FD\u4F1A\u5411\u5916\u6269\u5F20\u4E00\u70B9\u70B9\u3002\u6BCF\u6B21\u6269\u5F20\u2014\u2014\u90FD\u6709\u4EBA\u79BB\u5F00\u3002\u201D\n\n\u5730\u56FE\u53F3\u4E0A\u89D2\u6709\u53E6\u4E00\u6BB5\u6587\u5B57\uFF0C\u5B57\u8FF9\u660E\u663E\u4E0D\u540C\uFF0C\u66F4\u5C0F\u3001\u66F4\u8C28\u614E\uFF1A\n\n\u201C\u7B2C\u4E00\u6B21\u753B\u8FD9\u5F20\u5730\u56FE\u7684\u65F6\u5019\uFF0C\u6211\u89C9\u5F97\u6211\u5728\u6807\u8BB0\u5B83\u7684\u4F4D\u7F6E\u3002\u73B0\u5728\u6211\u770B\u7740\u8FD9\u5F20\u7EB8\u2014\u2014\u6211\u89C9\u5F97\u6211\u5728\u6807\u8BB0\u6211\u81EA\u5DF1\u3002\u201D\n\n\u80CC\u9762\u53EA\u6709\u4E00\u884C\u5B57\uFF0C\u7528\u975E\u5E38\u7C97\u7684\u94C5\u7B14\u5199\u7684\uFF1A\n\n\u201C\u96F6\u53F7\u70B9\u5E76\u4E0D\u5728\u7814\u7A76\u6240\u3002\u201D"
  discoveryScene: "XXX\uFF08\u524D\u5458\u5DE5\uFF09\u5728\u6253\u5F00306\u623F\u95F4\u7684\u5899\u677F\u540E\uFF0C\u4ECE\u91CC\u9762\u7684\u7A7A\u9699\u4E2D\u62BD\u51FA\u4E86\u4E00\u4E2A\u6241\u5E73\u7684\u91D1\u5C5E\u76D2\u3002\u76D2\u5B50\u91CC\u9664\u4E86\u8FD9\u4EFD\u5730\u56FE\uFF0C\u8FD8\u6709\u51E0\u652F\u5DF2\u7ECF\u5E72\u4E86\u7684\u94C5\u7B14\u3002\u5728\u5730\u56FE\u8FB9\u7F18\u6709\u4E00\u4E9B\u7A7A\u767D\u5904\uFF0C\u4E0A\u9762\u80FD\u9690\u7EA6\u8FA8\u8BA4\u51FA\u53CD\u590D\u64E6\u9664\u53C8\u91CD\u5199\u7684\u75D5\u8FF9\u2014\u2014\u65E7\u7684\u94C5\u7B14\u5370\u5DF2\u7ECF\u88AB\u6A61\u76AE\u64E6\u5F97\u5DEE\u4E0D\u591A\u4E86\uFF0C\u4F46\u5728\u7279\u5B9A\u89D2\u5EA6\u4E0B\u80FD\u770B\u5230\u51F9\u9677\u7684\u538B\u75D5\uFF0C\u50CF\u662F\u6709\u4EBA\u5728\u5199\u5B8C\u4E4B\u540E\u53C8\u51B3\u5B9A\u628A\u5B83\u64E6\u6389\uFF0C\u4F46\u94C5\u7B14\u7684\u7B14\u5C16\u7559\u4E0B\u4E86\u4E00\u9053\u9053\u6781\u7EC6\u7684\u523B\u75D5\u3002"
