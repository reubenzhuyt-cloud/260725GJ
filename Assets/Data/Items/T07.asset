  m_Script: {fileID: 11500000, guid: 1da8b08f1e628844cb283f492550575f, type: 3}
  m_Name: T07
  m_EditorClassIdentifier: 
  itemId: T07
  displayName: "\u300A\u8001\u7ECF\u7406\u7684\u7B14\u8BB0\u300B"
  hoverDescription: "\u8BB0\u6EE1\u7591\u70B9\u4E0E\u9057\u8A00\u7684\u7B14\u8BB0"
  description: "\u4E00\u672C\u6DF1\u7EFF\u8272\u786C\u76AE\u7B14\u8BB0\u672C\uFF0C\u6BD4\u5E38\u89C1\u7684\u53E3\u888B\u672C\u7565\u5927\u4E00\u4E9B\u3002\u5C01\u9762\u6CA1\u6709\u6807\u9898\uFF0C\u53EA\u6709\u53F3\u4E0B\u89D2\u7528\u91D1\u8272\u538B\u5370\u7740\u4E00\u4E2A\u5B57\u6BCD\u2014\u2014\u201CE\u201D\u3002\u7B14\u8BB0\u672C\u7684\u9501\u6263\u662F\u574F\u7684\uFF0C\u4E00\u6839\u65E7\u7684\u76AE\u7EF3\u4EE3\u66FF\u4E86\u539F\u6765\u7684\u91D1\u5C5E\u6263\u3002\u7EB8\u9875\u7684\u8FB9\u7F18\u5DF2\u7ECF\u6CDB\u9EC4\u53D1\u8106\uFF0C\u7FFB\u9605\u65F6\u9700\u8981\u683C\u5916\u5C0F\u5FC3\u3002\u6574\u672C\u7B14\u8BB0\u88AB\u5206\u6210\u4E09\u4E2A\u90E8\u5206\uFF0C\u7528\u4E0D\u540C\u989C\u8272\u7684\u4E66\u7B7E\u5E26\u9694\u5F00\uFF1A\u7B2C\u4E00\u90E8\u5206\u5927\u7EA6\u5360\u4E86\u5168\u4E66\u7684\u4E00\u534A\uFF0C\u8BB0\u5F55\u5BC6\u96C6\uFF1B\u7B2C\u4E8C\u90E8\u5206\u8F83\u8584\uFF0C\u8BB0\u5F55\u7A00\u758F\uFF1B\u7B2C\u4E09\u90E8\u5206\u53EA\u6709\u4E09\u9875\u7EB8\uFF0C\u4F46\u4E0A\u9762\u53EA\u5269\u4E0B\u4E00\u53E5\u8BDD\u3002"
  readableContent: "\u7B2C\u4E00\u90E8\u5206\xB7\u9009\u6BB5\uFF08\u8F83\u65E9\u671F\uFF09\n\n\u2026\u6CA1\u4EBA\u544A\u8BC9\u6211\u8FD9\u5BB6\u65C5\u9986\u662F\u8C01\u5EFA\u7684\u3002\u6211\u63A5\u624B\u7684\u65F6\u5019\u5B83\u5C31\u662F\u73B0\u5728\u7684\u6837\u5B50\u3002\u8001\u9648\u8BF4\u5B83\u81F3\u5C11\u5B58\u5728\u4E86\u56DB\u5341\u5E74\uFF0C\u4F46\u8001\u9648\u81EA\u5DF1\u4E5F\u624D\u4E94\u5341\u5C81\u3002\u4ED6\u7684\u8BF4\u6CD5\u9760\u4E0D\u4F4F\u3002\u95E8\u5ECA\u7684\u53F0\u9636\u4E0D\u662F\u8FD9\u4E2A\u5E74\u4EE3\u7684\u77F3\u5934\u2014\u2014\u5B83\u4EEC\u7684\u78E8\u635F\u7A0B\u5EA6\u4E0D\u5BF9\u3002\u6211\u627E\u4EBA\u770B\u8FC7\uFF0C\u90A3\u4EBA\u8BF4\u8FD9\u77F3\u5934\u9700\u8981\u8D70\u51E0\u767E\u5E74\u624D\u80FD\u78E8\u6210\u90A3\u6837\u3002\u51E0\u767E\u5E74\u3002\u8FD9\u5BB6\u65C5\u9986\u624D\u591A\u5C11\u5E74\uFF1F\n\n\u2026\u4ECA\u5929\u6709\u51E0\u4E2A\u623F\u5BA2\u8BF4\u4ED6\u4EEC\u623F\u95F4\u7684\u7A97\u6237\u5BF9\u7740\u4E00\u6761\u8857\u9053\u3002\u90A3\u6761\u8857\u9053\u5728\u4E09\u697C\u3002\u4F46\u697C\u4E0B\u662F\u7A7A\u5730\u3002\u6211\u95EE\u4ED6\u4EEC\u662F\u54EA\u4E00\u6247\u7A97\uFF0C\u4ED6\u4EEC\u8BF4\u201C\u4E1C\u9762\u90A3\u6247\u201D\u3002\u4E1C\u9762\u7684\u7A97\u5916\u662F\u5C71\u3002\u6CA1\u6709\u8857\u9053\u3002\u4ED6\u4EEC\u575A\u6301\u8BF4\u6709\u3002\u6211\u6CA1\u6709\u53CD\u9A73\u3002\n\n\u2026\u5730\u4E0B\u5BA4\u7684\u95E8\u4ECE\u6765\u6CA1\u6709\u6253\u5F00\u8FC7\u3002\u4ECE\u6211\u6765\u7684\u7B2C\u4E00\u5929\u5C31\u662F\u9501\u7740\u7684\u3002\u524D\u4EFB\u7ECF\u7406\u628A\u94A5\u5319\u4EA4\u7ED9\u6211\u65F6\u8BF4\u4E86\u4E00\u53E5\u8BDD\uFF1A\u201C\u4F60\u9700\u8981\u7528\u7684\u65F6\u5019\u5B83\u4F1A\u81EA\u5DF1\u5F00\u7684\u3002\u201D\u6211\u4E0D\u77E5\u9053\u8FD9\u662F\u4EC0\u4E48\u610F\u601D\u3002\n\n\u7B2C\u4E8C\u90E8\u5206\xB7\u9009\u6BB5\uFF08\u8F83\u665A\u671F\uFF09\n\n\u2026\u6211\u5F00\u59CB\u8BB0\u4E0D\u6E05\u4E00\u4E9B\u4E8B\u60C5\u3002\u6BD4\u5982\u4ECA\u5929\u662F\u661F\u671F\u51E0\u3002\u6BD4\u5982\u8FD9\u4E2A\u623F\u95F4\u662F\u4E0D\u662F\u6211\u81EA\u5DF1\u7684\u3002\u6211\u7AD9\u5728\u95E8\u53E3\u770B\u4E86\u5F88\u4E45\u624D\u786E\u5B9A\u8FD9\u662F\u6211\u7684\u623F\u95F4\u2014\u2014\u56E0\u4E3A\u684C\u5B50\u4E0A\u6709\u6211\u7684\u7B14\u3002\u8FD9\u662F\u6211\u552F\u4E00\u80FD\u786E\u8BA4\u7684\u65B9\u5F0F\u3002\u6211\u7684\u7B14\u5728\u8FD9\u91CC\uFF0C\u6240\u4EE5\u8FD9\u662F\u5C5E\u4E8E\u6211\u7684\u7A7A\u95F4\u3002\n\n\u2026\u4E1C\u9762\u7684\u7A97\u6237\u3002\u6211\u521A\u624D\u53C8\u770B\u4E86\u3002\u7A97\u5916\u662F\u5C71\u3002\u6CA1\u6709\u8857\u9053\u3002\u4F46\u90A3\u4E2A\u623F\u5BA2\u575A\u6301\u8BF4\u6709\u8857\u9053\u3002\u73B0\u5728\u6211\u770B\u7740\u4ED6\u63CF\u8FF0\u7684\u201C\u8857\u9053\u201D\u65B9\u5411\uFF0C\u6211\u5F00\u59CB\u6000\u7591\u2014\u2014\u4E5F\u8BB8\u6211\u770B\u5230\u7684\u662F\u4E0D\u4E00\u6837\u7684\u4E1C\u897F\u3002\u4E5F\u8BB8\u4ED6\u770B\u5230\u7684\u662F\u522B\u7684\u4EC0\u4E48\u3002\u4E5F\u8BB8\u90A3\u6247\u7A97\u6237\u5728\u4E0D\u540C\u7684\u4EBA\u773C\u91CC\u901A\u5F80\u4E0D\u540C\u7684\u5730\u65B9\u3002\n\n\u2026\u8001\u9648\u8D70\u4E86\u3002\u4ED6\u6CA1\u6709\u8BF4\u518D\u89C1\u3002\u4ED6\u5728\u684C\u5B50\u4E0A\u7559\u4E86\u4E00\u4E2A\u7EB8\u6761\uFF1A\u201C\u6211\u77E5\u9053\u90A3\u6247\u95E8\u901A\u5411\u54EA\u91CC\u3002\u4F60\u522B\u8DDF\u8FC7\u6765\u3002\u201D\n\n\u7B2C\u4E09\u90E8\u5206\uFF08\u53EA\u6709\u4E09\u9875\uFF0C\u524D\u4E24\u9875\u88AB\u6495\u6389\u4E86\uFF0C\u53EA\u5269\u7B2C\u4E09\u9875\uFF09\n\n\u201C\u8FD9\u5BB6\u65C5\u9986\u6CA1\u6709\u5730\u4E0B\u5BA4\u3002\u201D"
  discoveryScene: "306\u623F\u95F4\u4F4D\u4E8E\u4E09\u697C\u7684\u5C3D\u7AEF\u3002\u5B83\u6BD4\u522B\u7684\u623F\u95F4\u7A0D\u5927\u4E00\u4E9B\uFF0C\u4F46\u7A97\u6237\u7684\u671D\u5411\u5F88\u7279\u522B\u2014\u2014\u671D\u4E1C\uFF0C\u6B63\u5BF9\u7740\u8FDC\u5904\u7684\u5C71\u810A\u3002\u623F\u95F4\u91CC\u53EA\u6709\u4E00\u5F20\u5E8A\u3001\u4E00\u5F20\u684C\u5B50\u548C\u4E00\u628A\u6905\u5B50\u3002\u684C\u5B50\u9760\u7A97\u6446\u653E\uFF0C\u684C\u9762\u4E0A\u6709\u88AB\u957F\u65F6\u95F4\u653E\u7F6E\u7269\u4F53\u7559\u4E0B\u7684\u538B\u75D5\u2014\u2014\u4E00\u4E2A\u65B9\u5F62\u7684\u8F6E\u5ED3\uFF0C\u5927\u5C0F\u4E0E\u6DF1\u7EFF\u8272\u7B14\u8BB0\u672C\u4E00\u81F4\u3002\u4F60\u62FF\u8D77\u7B14\u8BB0\u672C\u65F6\uFF0C\u7A97\u5916\u6709\u6781\u77ED\u6682\u7684\u4E00\u77AC\u95F4\u53D8\u5F97\u660E\u4EAE\uFF0C\u50CF\u662F\u9633\u5149\u7A7F\u900F\u4E91\u5C42\u2014\u2014\u4F46\u62AC\u8D77\u5934\u65F6\uFF0C\u7A97\u5916\u7684\u5929\u662F\u9634\u7684\u3002"
