  itemId: T08
  displayName: "\u300A\u5DE1\u903B\u62A5\u544A\xB7\u5F02\u5E38\u65E5\u300B"
  hoverDescription: "\u8BB0\u5F55\u8BE1\u5F02\u5F02\u8C61\u7684\u5DE1\u903B\u5355"
  description: "\u4E00\u4EFD\u6807\u51C6\u683C\u5F0F\u7684\u5DE1\u903B\u65E5\u5FD7\uFF0C\u5199\u5728\u683C\u7EB8\u4E0A\uFF0C\u7528\u84DD\u8272\u5706\u73E0\u7B14\u586B\u5199\u3002\u65E5\u5FD7\u6709\u56FA\u5B9A\u7684\u8868\u683C\u683C\u5F0F\uFF1A\u65E5\u671F\u3001\u65F6\u95F4\u6BB5\u3001\u5DE1\u903B\u8DEF\u7EBF\u3001\u5F02\u5E38\u60C5\u51B5\u5907\u6CE8\u3001\u7B7E\u540D\u3002\u7EB8\u9762\u6709\u4E9B\u8936\u76B1\uFF0C\u8FB9\u7F18\u6709\u4E00\u5757\u6C34\u6E0D\uFF0C\u4F46\u6CA1\u6709\u5F71\u54CD\u5230\u6587\u5B57\u7684\u53EF\u8BFB\u6027\u3002\u5927\u90E8\u5206\u65E5\u671F\u7684\u5907\u6CE8\u680F\u90FD\u5199\u7740\u201C\u65E0\u5F02\u5E38\u201D\u6216\u201C\u4E00\u5207\u6B63\u5E38\u201D\u4E4B\u7C7B\u7684\u5185\u5BB9\uFF0C\u5B57\u8FF9\u5DE5\u6574\u3001\u7B14\u753B\u6E05\u6670\u3002\u4F46\u5728\u8FDE\u7EED\u51E0\u5929\u7684\u62A5\u544A\u4E4B\u540E\uFF0C\u51FA\u73B0\u4E86\u51E0\u9875\u660E\u663E\u4E0D\u540C\u7684\u5185\u5BB9\u2014\u2014\u5B57\u8FF9\u53D8\u5F97\u7D27\u5F20\uFF0C\u7B14\u753B\u66F4\u7528\u529B\uFF0C\u4F3C\u4E4E\u5728\u72B9\u8C6B\u8981\u4E0D\u8981\u5199\u4E0B\u67D0\u4E9B\u5185\u5BB9\u3002"
  readableContent: "\u65E5\u671F\uFF1A\u7B2C14\u5929\n\n\u65F6\u95F4\uFF1A23:00 -
    1:00\n\n\u8DEF\u7EBF\uFF1A\u4E00\u697C\u8D70\u5ECA \u2192 \u4E8C\u697C\u4E1C\u4FA7
    \u2192 \u4E09\u697C\u697C\u68AF\u53E3\n\n\u5F02\u5E38\u60C5\u51B5\uFF1A\u4E00\u5207\u6B63\u5E38\u3002\u6CA1\u6709\u542C\u5230\u58F0\u97F3\u3002\u6CA1\u6709\u770B\u5230\u4EBA\u5F71\u3002\n\n\u7B7E\u540D\uFF1A\u6797\n\n\u65E5\u671F\uFF1A\u7B2C15\u5929\n\n\u65F6\u95F4\uFF1A23:00
    - 1:00\n\n\u8DEF\u7EBF\uFF1A\u4E00\u697C\u8D70\u5ECA \u2192 \u4E8C\u697C\u4E1C\u4FA7
    \u2192 \u4E09\u697C\u697C\u68AF\u53E3\n\n\u5F02\u5E38\u60C5\u51B5\uFF1A\u4E00\u5207\u6B63\u5E38\u3002\u8D70\u5ECA\u706F\u6709\u4E00\u76CF\u5728\u95EA\uFF0C\u540E\u6765\u6CA1\u95EA\u4E86\u3002\u53EF\u80FD\u662F\u7EBF\u8DEF\u95EE\u9898\u3002\n\n\u7B7E\u540D\uFF1A\u6797\n\n\u65E5\u671F\uFF1A\u7B2C16\u5929\n\n\u65F6\u95F4\uFF1A23:00
    - 1:00\n\n\u8DEF\u7EBF\uFF1A\u4E00\u697C\u8D70\u5ECA \u2192 \u4E8C\u697C\u4E1C\u4FA7
    \u2192 \u4E09\u697C\u697C\u68AF\u53E3\n\n\u5F02\u5E38\u60C5\u51B5\uFF1A\u4E00\u5207\u6B63\u5E38\u3002\u697C\u4E0B\u5927\u5385\u91CC\u6709\u4E00\u4E2A\u4EBA\u7684\u8F6E\u5ED3\u7AD9\u5728\u7A97\u8FB9\u3002\u4F46\u6211\u8D70\u8FC7\u53BB\u7684\u65F6\u5019\u90A3\u91CC\u6CA1\u6709\u4EBA\u3002\u7A97\u53F0\u4E0A\u6709\u4E00\u5C42\u7070\uFF0C\u6CA1\u6709\u811A\u5370\u3002\n\n\u7B7E\u540D\uFF1A\u6797\n\n\u65E5\u671F\uFF1A\u7B2C17\u5929\n\n\u65F6\u95F4\uFF1A23:00
    - 1:00\n\n\u8DEF\u7EBF\uFF1A\u4E00\u697C\u8D70\u5ECA \u2192 \u4E8C\u697C\u4E1C\u4FA7
    \u2192 \u4E09\u697C\u697C\u68AF\u53E3\n\n\u5F02\u5E38\u60C5\u51B5\uFF1A\uFF08\u8FD9\u4E00\u884C\u88AB\u53CD\u590D\u6D82\u6539\uFF0C\u6700\u540E\u53EA\u7559\u4E0B\u51E0\u4E2A\u5B57\uFF09\u2026\u2026\u90A3\u4E2A\u4EBA\u3002\u4ED6\u8FD8\u5728\u7A97\u8FB9\u3002\n\n\u7B7E\u540D\uFF1A\u6797\n\n\u65E5\u671F\uFF1A\u7B2C18\u5929\n\n\u65F6\u95F4\uFF1A23:00
    - 1:00\n\n\u8DEF\u7EBF\uFF1A\u4E00\u697C\u8D70\u5ECA \u2192 \u4E8C\u697C\u4E1C\u4FA7
    \u2192 \u4E09\u697C\u697C\u68AF\u53E3\n\n\u5F02\u5E38\u60C5\u51B5\uFF1A\u6211\u628A\u5DE1\u903B\u8DEF\u7EBF\u6539\u6210\u4E86\u897F\u4FA7\u3002\u6211\u6CA1\u6709\u8D70\u4E1C\u8FB9\u3002\u6211\u6CA1\u6709\u53BB\u770B\u90A3\u6247\u7A97\u3002\n\n\u7B7E\u540D\uFF1A\u6797\n\n\uFF08\u8FD9\u4EFD\u65E5\u5FD7\u4E4B\u540E\u8FD8\u6709\u51E0\u9875\uFF0C\u5185\u5BB9\u9010\u6E10\u53D8\u5F97\u7B80\u77ED\uFF0C\u6700\u540E\u4E00\u5929\u7684\u5907\u6CE8\u680F\u91CC\u53EA\u5199\u4E86\u56DB\u4E2A\u5B57\uFF1A\u201C\u4ED6\u8BA4\u8BC6\u6211\u3002\u201D\uFF09"
  discoveryScene: "XXX\uFF08\u5B88\u591C\u4EBA\uFF09\u628A\u5DE1\u903B\u65E5\u5FD7\u4EA4\u7ED9\u4E86\u4F60\uFF0C\u6CA1\u6709\u8BF4\u592A\u591A\u8BDD\u3002\u4ED6\u770B\u8D77\u6765\u75B2\u60EB\uFF0C\u4F46\u4E0D\u50CF\u5BB3\u6015\u3002\u4ED6\u5728\u628A\u65E5\u5FD7\u9012\u7ED9\u4F60\u7684\u65F6\u5019\u8BF4\u4E86\u4E00\u53E5\uFF1A\u201C\u6211\u4E0D\u77E5\u9053\u8FD9\u662F\u4E0D\u662F\u5F88\u91CD\u8981\u3002\u6211\u53EA\u662F\u89C9\u5F97\u2014\u2014\u4F60\u5E94\u8BE5\u770B\u770B\u3002\u201D\u65E5\u5FD7\u7FFB\u5F00\u7684\u90A3\u4E00\u9875\u6B63\u597D\u662F\u7B2C17\u5929\u3002\u4F60\u6CA1\u6709\u8FFD\u95EE\u4ED6\u662F\u600E\u4E48\u53D1\u73B0\u8FD9\u4EFD\u65E5\u5FD7\u7684\u3002\u4ED6\u4E5F\u6682\u65F6\u6CA1\u6709\u8BF4\u51FA\u6765\u6E90\u3002"
