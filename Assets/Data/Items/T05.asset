  itemId: T05
  displayName: "\u300A\u9519\u4F4D\u7684\u65E7\u7167\u7247\u300B"
  hoverDescription: "\u8DE8\u8D8A\u4E0D\u540C\u5E74\u4EE3\u7684\u5408\u5F71"
  description: "\u4E00\u5F20\u5F69\u8272\u7167\u7247\uFF0C\u8868\u9762\u8986\u76D6\u7740\u4E00\u5C42\u6CDB\u9EC4\u7684\u5851\u6599\u819C\u3002\u7167\u7247\u7684\u8FB9\u89D2\u6709\u6298\u75D5\uFF0C\u5176\u4E2D\u4E00\u89D2\u66FE\u7ECF\u88AB\u6495\u6389\uFF0C\u53C8\u7528\u900F\u660E\u80F6\u5E26\u7C98\u4E86\u56DE\u6765\u3002\u7167\u7247\u4E2D\u662F\u4E00\u7FA4\u4EBA\u5728\u4E00\u5BB6\u65C5\u9986\u7684\u95E8\u53E3\u5408\u5F71\u2014\u2014\u5927\u7EA6\u5341\u51E0\u4E2A\u4EBA\uFF0C\u7A7F\u7740\u660E\u663E\u5C5E\u4E8E\u4E0D\u540C\u5E74\u4EE3\u7684\u8863\u670D\uFF1A\u524D\u6392\u6709\u4EBA\u7A7F\u77401970\u5E74\u4EE3\u7684\u683C\u5B50\u886C\u886B\uFF0C\u6709\u4EBA\u7A7F\u77401980\u5E74\u4EE3\u7684\u76AE\u5939\u514B\uFF0C\u540E\u6392\u6709\u4EBA\u7A7F\u7740\u66F4\u8FD1\u671F\u7684\u6DF1\u8272\u536B\u8863\u3002\u62CD\u6444\u65F6\u95F4\u770B\u8D77\u6765\u4E0D\u50CF\u662F\u5728\u540C\u4E00\u5E74\u4EE3\u3002\u7167\u7247\u7684\u6784\u56FE\u4E0D\u6574\u9F50\uFF0C\u50CF\u662F\u4E00\u5F20\u6293\u62CD\uFF0C\u6240\u6709\u4EBA\u7684\u89C6\u7EBF\u90FD\u843D\u5728\u4E0D\u540C\u7684\u65B9\u5411\uFF0C\u6CA1\u6709\u4E00\u4E2A\u4EBA\u5728\u770B\u4F60\u3002"
  readableContent: "\u7167\u7247\u672C\u8EAB\u6CA1\u6709\u6587\u5B57\uFF0C\u4F46\u7167\u7247\u80CC\u9762\u6709\u4EBA\u7528\u6DF1\u8272\u58A8\u6C34\u7B14\u5199\u4E86\u51E0\u4E2A\u5B57\uFF1A\n\n\u201C\u8FD9\u5BB6\u5E97\u2014\u2014\u95E8\u53E3\u603B\u662F\u6709\u4EBA\u3002\u4F46\u6211\u6BCF\u6B21\u6765\u90FD\u770B\u4E0D\u5230\u4ED6\u4EEC\u5728\u91CC\u9762\u3002\u201D\n\n\u5B57\u8FF9\u5F88\u5C0F\uFF0C\u50CF\u662F\u968F\u624B\u5199\u7684\uFF0C\u6709\u4E9B\u6F66\u8349\u3002\u540C\u4E00\u884C\u5B57\u7684\u65C1\u8FB9\uFF0C\u8FD8\u6709\u4E00\u4E2A\u66F4\u6D45\u7684\u94C5\u7B14\u5B57\u8FF9\uFF1A\n\n\u201C\u4F60\u8BF4\u5F97\u5BF9\u3002\u56E0\u4E3A\u5B83\u4E0D\u662F\u7ED9\u4EBA\u4F4F\u7684\u3002\u201D\n\n\u8FD9\u4E24\u79CD\u7B14\u8FF9\u770B\u8D77\u6765\u50CF\u662F\u6765\u81EA\u4E24\u4E2A\u4E0D\u540C\u7684\u65F6\u4EE3\u2014\u2014\u58A8\u6C34\u7684\u989C\u8272\u4E0D\u540C\uFF0C\u4E66\u5199\u7684\u5DE5\u5177\u4E0D\u540C\u3002\u4F46\u6CA1\u6709\u65E5\u671F\u3002\u65E0\u6CD5\u5224\u65AD\u8C01\u5148\u8C01\u540E\u3002"
  discoveryScene: "\u8001\u4EBA\u6CA1\u6709\u7559\u4E0B\u59D3\u540D\u3002\u4ED6\u5728\u65C5\u9986\u4F4F\u4E86\u4E00\u665A\uFF0C\u7B2C\u4E8C\u5929\u6E05\u6668\uFF0C\u4F60\u6572\u4ED6\u7684\u95E8\u60F3\u53EB\u4ED6\u5403\u65E9\u996D\u65F6\uFF0C\u623F\u95F4\u5DF2\u7ECF\u7A7A\u4E86\u3002\u88AB\u5B50\u53E0\u5F97\u6574\u6574\u9F50\u9F50\uFF0C\u6795\u5934\u4E0A\u6709\u4E00\u4E9B\u94F6\u7070\u8272\u7684\u5934\u53D1\u3002\u7167\u7247\u5C31\u653E\u5728\u6795\u5934\u4E0A\u3002\u7167\u7247\u8FB9\u7F18\u6709\u4E00\u5C0F\u5757\u6697\u7EA2\u8272\u6C61\u6E0D\uFF0C\u4E0D\u50CF\u8840\u8FF9\uFF0C\u66F4\u50CF\u67D0\u79CD\u67D3\u6599\u6216\u9648\u5E74\u7684\u58A8\u6C34\u3002\u95E8\u6CA1\u6709\u9501\u3002\u8D70\u5ECA\u91CC\u6CA1\u6709\u4EBA\u3002\u4F60\u7AD9\u5728\u95E8\u53E3\u4E0D\u77E5\u9053\u8BE5\u4E0D\u8BE5\u628A\u7167\u7247\u6536\u8D77\u6765\u3002\u6700\u540E\u4F60\u6536\u4E86\u3002"
  icon: {fileID: 21300000, guid: a583f64900df7c548b307665fa14f17a, type: 3}
