  displayName: "\u5218\u963f\u59e8"
  avatarColor: {r: 0.2, g: 0.7, b: 0.7, a: 1}
  shortDescription: "\u5218\u963f\u59e8\uff0c\u4e94\u5341\u516b\u5c81\uff0c\u9000\u4f11\u524d\u662f\u4e09\u7532\u533b\u9662\u7684\u62a4\u58eb\u957f\u3002\u6709\u4e25\u91cd\u7684\u6d01\u7656\uff0c\u6bcf\u5929\u81f3\u5c11\u62d6\u4e09\u904d\u5730\uff0c\u5bb6\u91cc\u7684\u5730\u677f\u5e72\u51c0\u5f97\u80fd\u7167\u51fa\u4eba\u5f71\u3002\n\u770b\u5230\u90bb\u5c45\u95e8\u53e3\u6709\u5783\u573e\u5c31\u4f1a\u5e2e\u5fd9\u6e05\u7406\uff0c\u4f46\u6e05\u7406\u5b8c\u4f1a\u8d34\u4e00\u5f20\"\u8bf7\u6ce8\u610f\u536b\u751f\"\u7684\u7eb8\u6761\uff0c\u63aa\u8f9e\u867d\u7136\u5ba2\u6c14\u4f46\u90a3\u79cd\u65e0\u5f62\u7684\u538b\u8feb\u611f\u8ba9\u4eba\u538b\u529b\u5f88\u5927\u3002\u6d88\u6bd2\u6c34\u662f\u5979\u7684\u9999\u6c34\uff0c\u8d70\u5230\u54ea\u513f\u90fd\u5e26\u7740\u4e00\u80a184\u6d88\u6bd2\u6db2\u7684\u5473\u9053\u3002\n\u4e3a\u4eba\u5584\u826f\u70ed\u5fc3\uff0c\u5c31\u662f\u592a\u7231\u5e72\u51c0\u4e86\u70b9\uff0c\u90bb\u5c45\u5bb6\u7684\u5b69\u5b50\u90fd\u6015\u53bb\u5979\u5bb6\u4e32\u95e8\uff0c\u56e0\u4e3a\u8fdb\u95e8\u5f97\u5148\u6362\u978b\u5957\u3001\u6234\u53e3\u7f69\u3001\u7528\u514d\u6d17\u6d17\u624b\u6db2\u6d88\u6bd2\u4e09\u904d\u3002"
  detailedDescription: "\u5218\u963f\u59e8\uff0c\u672c\u540d\u5218\u79c0\u73cd\uff0c\u4e94\u5341\u516b\u5c81\uff0c\u9000\u4f11\u524d\u662f\u5e02\u4e2d\u5fc3\u4e09\u7532\u533b\u9662\u547c\u5438\u79d1\u7684\u62a4\u58eb\u957f\uff0c\u5e72\u4e86\u6574\u6574\u4e09\u5341\u4e94\u5e74\u3002\u5728\u533b\u9662\u7684\u65f6\u5019\u5c31\u662f\u51fa\u4e86\u540d\u7684\u4e25\u683c\uff0c\u75c5\u623f\u536b\u751f\u6807\u51c6\u5bb9\u4e0d\u5f97\u534a\u70b9\u9a6c\u864e\u3002\u9000\u4f11\u540e\u8fd9\u80a1\u52b2\u513f\u4e00\u70b9\u6ca1\u51cf\uff0c\u53cd\u800c\u628a\u6574\u680b\u697c\u90fd\u5f53\u6210\u4e86\u81ea\u5df1\u7684\u7ba1\u8f96\u8303\u56f4\u3002\n\u5218\u963f\u59e8\u7684\u6d01\u7656\u7a0b\u5ea6\u582a\u79f0\u5c0f\u533a\u4e4b\u6700\u3002\u5979\u5bb6\u7684\u5730\u677f\u6bcf\u5929\u81f3\u5c11\u62d6\u4e09\u904d\uff0c\u65e9\u4e0a\u4e00\u904d\u3001\u4e2d\u5348\u4e00\u904d\u3001\u665a\u4e0a\u4e00\u904d\uff0c\u62d6\u5b8c\u8fd8\u8981\u7528\u5e72\u62b9\u5e03\u518d\u64e6\u4e00\u904d\uff0c\u786e\u4fdd\u6ca1\u6709\u4e00\u4e1d\u6c34\u6e0d\u3002\u53a8\u623f\u7684\u7076\u53f0\u6bcf\u6b21\u505a\u5b8c\u996d\u90fd\u8981\u64e6\u5f97\u9503\u4eae\uff0c\u536b\u751f\u95f4\u7684\u74f7\u7816\u7f1d\u5979\u6bcf\u5468\u7528\u7259\u5237\u5237\u4e00\u6b21\u3002\u6709\u90bb\u5c45\u53bb\u5979\u5bb6\u4e32\u95e8\uff0c\u8bf4\u5979\u5bb6\u5e72\u51c0\u5f97\u50cf\u662f\u6837\u677f\u95f4\uff0c\u6bd4\u552e\u697c\u5904\u8fd8\u6574\u6d01\u3002\n\u5979\u4e0d\u4ec5\u81ea\u5df1\u5bb6\u5e72\u51c0\uff0c\u8fd8\u770b\u4e0d\u5f97\u516c\u5171\u533a\u57df\u6709\u4e00\u70b9\u810f\u3002\u697c\u9053\u91cc\u6709\u4eba\u968f\u624b\u6254\u4e86\u4e2a\u70df\u5934\uff0c\u5979\u4f1a\u6361\u8d77\u6765\uff0c\u7136\u540e\u5728\u7fa4\u91cc\u53d1\u4e00\u6bb5\u957f\u957f\u7684\u516c\u5171\u536b\u751f\u5021\u8bae\u4e66\u3002\u90bb\u5c45\u95e8\u53e3\u5806\u4e86\u5feb\u9012\u76d2\u5b50\u6ca1\u53ca\u65f6\u6e05\u7406\uff0c\u5979\u4f1a\u5e2e\u5fd9\u6536\u8d70\uff0c\u4f46\u540c\u65f6\u4f1a\u5728\u95e8\u4e0a\u8d34\u4e00\u5f20\u624b\u5199\u7684\u7eb8\u6761\uff0c\u4e0a\u9762\u5de5\u5de5\u6574\u6574\u5730\u5199\u7740\"\u8bf7\u53ca\u65f6\u6e05\u7406\u6742\u7269\uff0c\u5171\u540c\u7ef4\u62a4\u697c\u9053\u73af\u5883\"\u3002\u63aa\u8f9e\u867d\u7136\u5ba2\u6c14\uff0c\u4f46\u90a3\u79cd\u65e0\u5f62\u7684\u538b\u529b\u8ba9\u6536\u5230\u7eb8\u6761\u7684\u90bb\u5c45\u5982\u5750\u9488\u6be1\u3002\n\u5218\u963f\u59e8\u51fa\u95e8\u968f\u8eab\u643a\u5e26\u4e00\u4e2a\u5c0f\u5305\uff0c\u91cc\u9762\u88c5\u7740\u9152\u7cbe\u55b7\u96fe\u3001\u6d88\u6bd2\u6e7f\u5dfe\u3001\u4e00\u6b21\u6027\u624b\u5957\u548c\u5907\u7528\u53e3\u7f69\uff0c\u6d3b\u50cf\u4e00\u4e2a\u79fb\u52a8\u7684\u6d88\u6bd2\u7ad9\u3002\u5979\u5750\u7535\u68af\u524d\u8981\u5148\u7528\u6e7f\u5dfe\u64e6\u6309\u94ae\uff0c\u53bb\u8d85\u5e02\u63a8\u8d2d\u7269\u8f66\u524d\u8981\u55b7\u4e00\u904d\u9152\u7cbe\uff0c\u8fde\u94f6\u884c\u7684\u53d6\u6b3e\u673a\u952e\u76d8\u5979\u90fd\u8981\u64e6\u4e86\u624d\u80af\u7528\u3002\u90bb\u5c45\u4eec\u79c1\u5e95\u4e0b\u5f00\u73a9\u7b11\u8bf4\uff0c\u8ddf\u5979\u8d70\u5728\u4e00\u8d77\uff0c\u6d51\u8eab\u4e0a\u4e0b\u90fd\u5f25\u6f2b\u7740\u4e00\u80a184\u6d88\u6bd2\u6db2\u7684\u5473\u9053\uff0c\u8fd9\u5927\u6982\u5c31\u662f\"\u5e72\u51c0\u7684\u5473\u9053\"\u3002\n\u8bdd\u867d\u5982\u6b64\uff0c\u5218\u963f\u59e8\u7684\u5fc3\u5730\u662f\u771f\u7684\u5584\u826f\u3002\u8c01\u5bb6\u6709\u4e2a\u5934\u75bc\u8111\u70ed\uff0c\u5979\u6bd4\u8c01\u90fd\u7740\u6025\uff0c\u63d0\u7740\u836f\u7bb1\u5c31\u4e0a\u95e8\u4e86\uff0c\u91cf\u8840\u538b\u3001\u6d4b\u4f53\u6e29\u3001\u53ee\u5631\u7528\u836f\uff0c\u4e00\u5957\u6d41\u7a0b\u6bd4\u793e\u533a\u8bca\u6240\u8fd8\u4e13\u4e1a\u3002\u75ab\u60c5\u671f\u95f4\u5979\u4e3b\u52a8\u5f53\u5fd7\u613f\u8005\uff0c\u6328\u5bb6\u6328\u6237\u6559\u8001\u4eba\u600e\u4e48\u6b63\u786e\u6234\u53e3\u7f69\u3001\u600e\u4e48\u6d17\u624b\uff0c\u6bd4\u793e\u533a\u5de5\u4f5c\u4eba\u5458\u8fd8\u4e13\u4e1a\u3002\u90bb\u5c45\u4eec\u5634\u4e0a\u5acc\u5979\u7ba1\u5f97\u5bbd\u3001\u6d01\u7656\u592a\u91cd\uff0c\u4f46\u5fc3\u91cc\u90fd\u6e05\u695a\uff0c\u6709\u5218\u963f\u59e8\u5728\uff0c\u8fd9\u680b\u697c\u7684\u536b\u751f\u548c\u5065\u5eb7\u90fd\u6709\u4e86\u4fdd\u969c\u3002\u5979\u5e38\u8bf4\u5e72\u51c0\u662f\u4e00\u79cd\u4e60\u60ef\uff0c\u4e5f\u662f\u4e00\u79cd\u5bf9\u751f\u6d3b\u7684\u5c0a\u91cd\u3002"
