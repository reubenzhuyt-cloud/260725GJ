  m_Script: {fileID: 11500000, guid: 6a725b000eb23c446b734e1ebfb811a4, type: 3}
  m_Name: tenant_theta
  m_EditorClassIdentifier: 
  candidateId: tenant_theta
  displayName: "\u674E\u7FE0\u82B1"
  avatarColor: {r: 0.6, g: 0.4, b: 0.2, a: 1}
  shortDescription: "\u674e\u7fe0\u82b1\uff0c\u56db\u5341\u516b\u5c81\uff0c\u83dc\u5e02\u573a\u5356\u83dc\u644a\u4e3b\uff0c\u55d3\u95e8\u5927\u5f97\u9694\u7740\u4e09\u6761\u8857\u90fd\u80fd\u542c\u89c1\u5979\u7684\u5406\u559d\u58f0\u3002\u7cbe\u660e\u80fd\u5e72\uff0c\u7b97\u8d26\u6bd4\u8ba1\u7b97\u5668\u8fd8\u5feb\uff0c\u773c\u775b\u4e00\u626b\u5c31\u77e5\u9053\u83dc\u65b0\u4e0d\u65b0\u9c9c\u3002\u4e3a\u4eba\u4ed7\u4e49\uff0c\u7ecf\u5e38\u7ed9\u90bb\u5c45\u9001\u5356\u4e0d\u5b8c\u7684\u83dc\uff0c\u4f46\u4ece\u4e0d\u627f\u8ba4\u662f\u5356\u5269\u7684\uff0c\u603b\u8bf4\u662f\u7279\u610f\u7559\u7684\u597d\u8d27\u3002\u6bcf\u5929\u51cc\u6668\u4e09\u70b9\u8e6c\u4e09\u8f6e\u53bb\u6279\u53d1\u5e02\u573a\u8fdb\u8d27\uff0c\u98ce\u96e8\u65e0\u963b\u575a\u6301\u4e86\u4e8c\u5341\u591a\u5e74\u3002\u65a4\u65a4\u8ba1\u8f83\u8d77\u6765\u51fa\u4e86\u540d\uff0c\u4e00\u6bdb\u94b1\u80fd\u63b0\u626f\u534a\u5929\u3002"
  detailedDescription: "\u674e\u7fe0\u82b1\uff0c\u56db\u5341\u516b\u5c81\uff0c\u83dc\u5e02\u573a\u91cc\u5356\u4e86\u4e8c\u5341\u591a\u5e74\u83dc\u7684\u8001\u644a\u4e3b\u3002\u7cbe\u660e\u80fd\u5e72\u662f\u51fa\u4e86\u540d\u7684\uff0c\u7b97\u8d26\u6bd4\u8ba1\u7b97\u5668\u8fd8\u5feb\uff0c\u5ba2\u4eba\u8fd8\u6ca1\u638f\u51fa\u624b\u673a\u5979\u5df2\u7ecf\u628a\u96f6\u94b1\u627e\u597d\u4e86\u3002\u773c\u775b\u6bd2\u8fa3\u5f97\u5f88\uff0c\u968f\u4fbf\u4e00\u628a\u83dc\u626b\u4e00\u773c\u5c31\u77e5\u9053\u65b0\u4e0d\u65b0\u9c9c\u3001\u6709\u6ca1\u6709\u6253\u8fc7\u836f\uff0c\u9694\u58c1\u644a\u4f4d\u60f3\u4ee5\u6b21\u5145\u597d\u90fd\u7792\u4e0d\u8fc7\u5979\u3002\u55d3\u95e8\u5927\uff0c\u9694\u7740\u4e09\u6761\u8857\u90fd\u80fd\u542c\u5230\u5979\u4e2d\u6c14\u5341\u8db3\u7684\u5406\u559d\u58f0\uff0c\u6574\u6761\u8857\u5c31\u6570\u5979\u644a\u4f4d\u524d\u56f4\u7684\u4eba\u6700\u591a\u3002\n\n\u6bcf\u5929\u51cc\u6668\u4e09\u70b9\u5c31\u8e6c\u7740\u90a3\u8f86\u8001\u4e09\u8f6e\u8f66\u53bb\u6279\u53d1\u5e02\u573a\u8fdb\u8d27\uff0c\u98ce\u91cc\u6765\u96e8\u91cc\u53bb\uff0c\u4e8c\u5341\u591a\u5e74\u4ece\u672a\u95f4\u65ad\u3002\u5bd2\u51ac\u814a\u6708\u522b\u4eba\u7f29\u5728\u88ab\u7a9d\u91cc\uff0c\u5979\u5df2\u7ecf\u8e72\u5728\u6279\u53d1\u5e02\u573a\u91cc\u4e00\u68f5\u4e00\u68f5\u5730\u6311\u83dc\u4e86\u3002\u56de\u6765\u540e\u8fd8\u8981\u7801\u83dc\u3001\u79f0\u91cd\u3001\u7b97\u8d26\u3001\u627e\u96f6\uff0c\u4e00\u76f4\u5fd9\u5230\u4e0b\u5348\u56db\u4e94\u70b9\u624d\u6536\u644a\u3002\u6536\u644a\u540e\u8fd8\u5f97\u628a\u5356\u5269\u7684\u83dc\u5206\u62e3\u51fa\u6765\uff0c\u597d\u7684\u7559\u7740\u660e\u5929\u5356\uff0c\u4e0d\u597d\u7684\u5c31\u6253\u5305\u5e26\u56de\u53bb\u5582\u9e21\uff0c\u5979\u5728\u90ca\u533a\u8fd8\u517b\u4e86\u5341\u51e0\u53ea\u9e21\u3002\n\n\u4e3a\u4eba\u4ed7\u4e49\u662f\u516c\u8ba4\u7684\uff0c\u7ecf\u5e38\u7ed9\u90bb\u5c45\u9001\u5356\u4e0d\u5b8c\u7684\u83dc\uff0c\u4f46\u5634\u4e0a\u7edd\u4e0d\u627f\u8ba4\u662f\u5356\u5269\u7684\uff0c\u603b\u8bf4\u662f\u7279\u610f\u7ed9\u4eba\u7559\u7684\u597d\u83dc\u3002\u5c0f\u533a\u91cc\u7684\u8001\u4eba\u4eec\u90fd\u77e5\u9053\uff0c\u53bb\u7fe0\u82b1\u644a\u4e0a\u4e70\u83dc\uff0c\u96f6\u5934\u5979\u4ece\u6765\u4e0d\u6536\uff0c\u6709\u65f6\u5019\u8fd8\u591a\u585e\u4e24\u628a\u8471\u3002\u4f46\u5979\u65a4\u65a4\u8ba1\u8f83\u8d77\u6765\u4e5f\u786e\u5b9e\u8ba9\u4eba\u5934\u75bc\uff0c\u6709\u6b21\u4e00\u4e2a\u987e\u5ba2\u5c11\u7ed9\u4e86\u4e00\u6bdb\u94b1\uff0c\u5979\u8ffd\u51fa\u534a\u6761\u8857\u786c\u662f\u628a\u94b1\u8981\u4e86\u56de\u6765\uff0c\u56de\u6765\u8fd8\u6c14\u547c\u547c\u5730\u5ff5\u53e8\u4e86\u534a\u5929\u3002\n\n\u6d88\u606f\u7075\u901a\u5f97\u5f88\uff0c\u559c\u6b22\u8fb9\u62e9\u83dc\u8fb9\u8ddf\u4eba\u62c9\u5bb6\u5e38\uff0c\u5c0f\u533a\u91cc\u8c01\u5bb6\u5435\u67b6\u4e86\u3001\u8c01\u5bb6\u5b69\u5b50\u8003\u4e0a\u5927\u5b66\u4e86\u3001\u8c01\u5bb6\u5ab3\u5987\u6000\u5b55\u4e86\uff0c\u5979\u6bd4\u5f53\u4e8b\u4eba\u77e5\u9053\u5f97\u8fd8\u6e05\u695a\uff0c\u5927\u5bb6\u7ed9\u5979\u8d77\u4e86\u4e2a\u5916\u53f7\u53eb\u5c0f\u533a\u5e7f\u64ad\u7ad9\u3002\u5979\u4e5f\u4e0d\u751f\u6c14\uff0c\u7b11\u563b\u563b\u5730\u8bf4\u8fd9\u53eb\u5173\u5fc3\u90bb\u91cc\u751f\u6d3b\uff0c\u4e0d\u662f\u516b\u5366\u3002\u8c01\u5bb6\u6709\u4e2a\u7ea2\u767d\u559c\u4e8b\u5979\u8dd1\u5f97\u6bd4\u8c01\u90fd\u5feb\uff0c\u5e2e\u5fd9\u5f20\u7f57\u5f97\u59a5\u59a5\u5e16\u5e16\uff0c\u4ece\u6765\u4e0d\u6536\u4e00\u5206\u94b1\u3002\n\n\u5634\u4e0a\u4e0d\u9976\u4eba\u4f46\u5fc3\u80a0\u70ed\u5f97\u5f88\u3002\u524d\u5e74\u9694\u58c1\u697c\u5c0f\u4e24\u53e3\u95f9\u79bb\u5a5a\u95f9\u5f97\u9e21\u98de\u72d7\u8df3\uff0c\u5979\u786c\u662f\u62c9\u7740\u4e24\u53e3\u5b50\u5728\u81ea\u5bb6\u644a\u4f4d\u65c1\u5403\u4e86\u987f\u5979\u4eb2\u624b\u505a\u7684\u624b\u64c0\u9762\uff0c\u82e6\u53e3\u5a46\u5fc3\u529d\u4e86\u4e00\u4e0b\u5348\uff0c\u6700\u540e\u8fd8\u771f\u7ed9\u529d\u548c\u4e86\u3002\u5c0f\u533a\u91cc\u7684\u4eba\u90fd\u8bf4\u7fe0\u82b1\u59d0\u8fd9\u5f20\u5634\u80fd\u8bf4\u54ed\u4e5f\u80fd\u8bf4\u7b11\uff0c\u5168\u770b\u5979\u7ad9\u54ea\u8fb9\u3002\u5979\u4e08\u592b\u5acc\u5979\u592a\u7231\u7ba1\u95f2\u4e8b\uff0c\u5979\u56de\u603c\u8bf4\u8fdc\u4eb2\u4e0d\u5982\u8fd1\u90bb\uff0c\u6211\u4e0d\u5e2e\u8c01\u5e2e\u3002"
