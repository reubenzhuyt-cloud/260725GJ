  displayName: "\u5468\u6587\u535A"
  avatarColor: {r: 0.75, g: 0.75, b: 0.75, a: 1}
  shortDescription: "\u5468\u6587\u535a\uff0c\u4e94\u5341\u4e8c\u5c81\uff0c\u5927\u5b66\u4e2d\u6587\u7cfb\u6559\u6388\uff0c\u8bf4\u8bdd\u5f15\u7ecf\u636e\u5178\u4e09\u53e5\u8bdd\u4e0d\u79bb\u53e4\u6587\uff0c\u90bb\u5c45\u4eec\u6709\u65f6\u5f97\u67e5\u5b57\u5178\u624d\u80fd\u542c\u61c2\u4ed6\u5728\u8bf4\u4ec0\u4e48\u3002\u4e3a\u4eba\u5112\u96c5\u6709\u793c\uff0c\u4ece\u4e0d\u5927\u58f0\u8bf4\u8bdd\uff0c\u89c1\u8c01\u90fd\u5fae\u5fae\u70b9\u5934\u81f4\u610f\u3002\u6709\u4e2a\u602a\u7656\uff0c\u75af\u72c2\u6536\u96c6\u65e7\u4e66\uff0c\u623f\u95f4\u91cc\u4e66\u5806\u5f97\u8fde\u4e0b\u811a\u7684\u5730\u65b9\u90fd\u6ca1\u6709\uff0c\u5ba2\u5385\u53ea\u7559\u4e00\u6761\u7a84\u7a84\u7684\u8fc7\u9053\u901a\u5367\u5ba4\u3002\u66fe\u88ab\u90bb\u5c45\u8bef\u8ba4\u662f\u5e9f\u54c1\u56de\u6536\u7ad9\uff0c\u8fd8\u6709\u6b21\u7ffb\u5783\u573e\u6876\u62a2\u6551\u4e86\u4e00\u7bb1\u73cd\u8d35\u65e7\u4e66\u3002"
  detailedDescription: "\u5468\u6587\u535a\uff0c\u4e94\u5341\u4e8c\u5c81\uff0c\u5927\u5b66\u4e2d\u6587\u7cfb\u6559\u6388\uff0c\u4e13\u653b\u53e4\u5178\u6587\u5b66\u3002\u8bf4\u8bdd\u5f15\u7ecf\u636e\u5178\uff0c\u4e09\u53e5\u8bdd\u4e0d\u79bb\u53e4\u6587\uff0c\u90bb\u5c45\u4eec\u8ddf\u4ed6\u804a\u5929\u6709\u65f6\u5019\u5f97\u5077\u5077\u67e5\u5b57\u5178\u624d\u80fd\u8ddf\u4e0a\u8282\u594f\u3002\u4e3a\u4eba\u5112\u96c5\u6709\u793c\uff0c\u4ece\u4e0d\u5927\u58f0\u8bf4\u8bdd\uff0c\u89c1\u8c01\u90fd\u5fae\u5fae\u70b9\u5934\u81f4\u610f\uff0c\u8bf4\u8bdd\u6162\u6761\u65af\u7406\u7684\uff0c\u50cf\u968f\u65f6\u5728\u7ed9\u4eba\u4e0a\u8bfe\u3002\u7a7f\u7740\u4e5f\u662f\u4e00\u8d2f\u7684\u65e7\u5f0f\u98ce\u683c\uff0c\u56db\u5b63\u4e0d\u53d8\u7684\u5706\u9886\u886b\u914d\u5e03\u978b\uff0c\u770b\u7740\u50cf\u4e2a\u4ece\u6c11\u56fd\u7a7f\u8d8a\u8fc7\u6765\u7684\u4e66\u751f\u3002\n\n\u4f46\u6709\u4e2a\u602a\u7656\uff0c\u75af\u72c2\u6536\u96c6\u65e7\u4e66\u3002\u623f\u95f4\u91cc\u4e66\u5806\u5f97\u8fde\u4e0b\u811a\u7684\u5730\u65b9\u90fd\u6ca1\u6709\uff0c\u5ba2\u5385\u6c99\u53d1\u88ab\u4e66\u5360\u53bb\u4e86\u4e00\u5927\u534a\uff0c\u53ea\u7559\u4e00\u6761\u7a84\u7a84\u7684\u4fa7\u8eab\u8fc7\u9053\u901a\u5411\u5367\u5ba4\u3002\u6536\u85cf\u7684\u4e66\u4ece\u660e\u6e05\u523b\u672c\u5230\u6c11\u56fd\u6742\u5fd7\u65e0\u6240\u4e0d\u5305\uff0c\u6709\u4e9b\u4e66\u6bd4\u4ed6\u5e74\u7eaa\u8fd8\u5927\u597d\u51e0\u8f6e\u3002\u4e66\u623f\u91cc\u4e13\u95e8\u6709\u4e2a\u7ea2\u6728\u67dc\u5b50\u653e\u73cd\u85cf\u7248\uff0c\u5e38\u5e74\u4e0a\u7740\u9501\uff0c\u94a5\u5319\u6302\u5728\u8116\u5b50\u4e0a\u8c01\u90fd\u4e0d\u8ba9\u78b0\u3002\u4ed6\u5e38\u8bf4\u8fd9\u4e9b\u4e66\u662f\u6709\u751f\u547d\u7684\uff0c\u6bcf\u4e00\u672c\u90fd\u627f\u8f7d\u7740\u4e00\u6bb5\u5386\u53f2\uff0c\u6254\u6389\u5c31\u662f\u9020\u5b7d\u3002\n\n\u6bcf\u6708\u90fd\u8981\u53bb\u65e7\u4e66\u5e02\u573a\u548c\u5e9f\u54c1\u6536\u8d2d\u7ad9\u6dd8\u8d27\uff0c\u4e00\u53bb\u5c31\u662f\u5927\u534a\u5929\uff0c\u56de\u6765\u65f6\u6000\u91cc\u62b1\u7740\u4e00\u645e\u65e7\u4e66\uff0c\u90a3\u5f00\u5fc3\u52b2\u513f\u6bd4\u4e2d\u4e86\u5f69\u7968\u8fd8\u5938\u5f20\u3002\u66fe\u88ab\u90bb\u5c45\u8bef\u8ba4\u662f\u5e9f\u54c1\u56de\u6536\u7ad9\uff0c\u6709\u597d\u51e0\u6b21\u6536\u5e9f\u54c1\u7684\u4e09\u8f6e\u8f66\u76f4\u63a5\u505c\u5728\u4ed6\u5bb6\u95e8\u53e3\u95ee\u6536\u4e0d\u6536\u65e7\u62a5\u7eb8\uff0c\u4ed6\u6c14\u5f97\u4e09\u5929\u6ca1\u51fa\u95e8\u3002\u53bb\u5e74\u9694\u58c1\u642c\u5bb6\u65f6\u6254\u4e86\u4e00\u5927\u7bb1\u65e7\u4e66\uff0c\u4ed6\u6b63\u597d\u8def\u8fc7\uff0c\u4e8c\u8bdd\u4e0d\u8bf4\u625b\u56de\u5bb6\uff0c\u6e05\u70b9\u540e\u53d1\u73b0\u91cc\u5934\u6709\u51e0\u672c\u7edd\u7248\u7684\u6c11\u56fd\u8bfe\u672c\uff0c\u6fc0\u52a8\u5f97\u5dee\u70b9\u6389\u773c\u6cea\u3002\n\n\u5bf9\u5b66\u751f\u8981\u6c42\u6781\u5176\u4e25\u683c\uff0c\u8bba\u6587\u5f15\u7528\u5fc5\u987b\u7cbe\u786e\u5230\u9875\u7801\u548c\u7248\u672c\uff0c\u6807\u70b9\u683c\u5f0f\u9519\u4e00\u5904\u5c31\u8981\u63a8\u7ffb\u91cd\u5199\u3002\u7814\u7a76\u751f\u4eec\u79c1\u5e95\u4e0b\u53eb\u4ed6\u5468\u6252\u76ae\uff0c\u4f46\u6bd5\u4e1a\u591a\u5e74\u540e\u56de\u60f3\u8d77\u6765\u90fd\u8bf4\u5468\u6559\u6388\u624d\u662f\u771f\u6b63\u8d1f\u8d23\u4efb\u7684\u597d\u8001\u5e08\u3002\u4ed6\u7ecf\u5e38\u81ea\u638f\u8170\u5305\u7ed9\u8d2b\u56f0\u5b66\u751f\u4e70\u53c2\u8003\u4e66\uff0c\u4e00\u6b21\u5c31\u662f\u597d\u51e0\u767e\u5757\uff0c\u4ece\u4e0d\u8ddf\u4eba\u63d0\u8d77\u3002\u4ed6\u7684\u8bfe\u5728\u5927\u5b66\u91cc\u51fa\u4e86\u540d\u5730\u96be\u9009\uff0c\u9009\u8bfe\u7cfb\u7edf\u4e00\u5f00\u653e\u540d\u989d\u77ac\u95f4\u79d2\u5149\uff0c\u5b66\u751f\u4eec\u90fd\u8bf4\u542c\u4ed6\u8bb2\u53e4\u6587\u5c31\u50cf\u542c\u6545\u4e8b\u3002\n\n\u6bcf\u5929\u6e05\u6668\u5728\u5c0f\u533a\u82b1\u56ed\u6563\u6b65\u534a\u5c0f\u65f6\uff0c\u8fb9\u8d70\u8fb9\u4f4e\u58f0\u541f\u8bf5\u53e4\u8bd7\u8bcd\uff0c\u58f0\u97f3\u4e0d\u5927\u4f46\u97f5\u5473\u5341\u8db3\uff0c\u50cf\u5728\u54fc\u4e00\u9996\u8001\u6b4c\u3002\u90bb\u5c45\u4eec\u6e10\u6e10\u4e60\u60ef\u4e86\u8fd9\u9053\u98ce\u666f\uff0c\u5076\u5c14\u8fd8\u4f1a\u9a7b\u8db3\u542c\u4e00\u4f1a\u513f\u3002\u4ed6\u8bf4\u8bfb\u4e66\u662f\u6587\u660e\u4eba\u6700\u57fa\u672c\u7684\u4fee\u517b\uff0c\u8fd9\u4e2a\u4e60\u60ef\u4ed6\u575a\u6301\u4e86\u56db\u5341\u5e74\uff0c\u4e00\u5929\u4e0d\u8bfb\u5c31\u89c9\u5f97\u6d51\u8eab\u4e0d\u81ea\u5728\u3002\u591c\u91cc\u7ecf\u5e38\u770b\u4e66\u770b\u5230\u51cc\u6668\u4e24\u4e09\u70b9\uff0c\u8001\u4f34\u5ff5\u53e8\u4ed6\u628a\u773c\u775b\u770b\u574f\u4e86\uff0c\u4ed6\u7b11\u772f\u772f\u5730\u56de\u4e00\u53e5\u4e66\u5377\u591a\u60c5\u4f3c\u6545\u4eba\uff0c\u6668\u660f\u5fe7\u4e50\u6bcf\u76f8\u4eb2\u3002"
