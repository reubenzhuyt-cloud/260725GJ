  candidateId: tenant_upsilon
  portrait: {fileID: 0}
  ability: 0
  activityType: 0
  displayName: "\u97E9\u6885\u6885"
  avatarColor: {r: 0.3, g: 0.6, b: 0.5, a: 1}
  shortDescription: "\u97E9\u6885\u6885\uFF0C\u4E09\u5341\u4E09\u5C81\uFF0C\u5C0F\u5B66\u8BED\u6587\u8001\u5E08\u517C\u73ED\u4E3B\u4EFB\uFF0C\u6559\u9F84\u5341\u5E74\uFF0C\u8BF4\u8BDD\u8F7B\u58F0\u7EC6\u8BED\uFF0C\u4ECE\u6765\u4E0D\u53D1\u813E\u6C14\uFF0C\u5BF9\u8C01\u90FD\u6781\u6709\u8010\u5FC3\u3002\u8FDE\u90BB\u5C45\u5BB6\u6700\u8C03\u76AE\u7684\u718A\u5B69\u5B50\u90FD\u559C\u6B22\u5979\uFF0C\u89C1\u4E86\u9762\u5C31\u4E56\u4E56\u53EB\u97E9\u8001\u5E08\u597D\uFF0C\u6BD4\u89C1\u4E86\u4EB2\u5988\u8FD8\u542C\u8BDD\u3002\u4F46\u5979\u6709\u4E2A\u8BA9\u4EBA\u54ED\u7B11\u4E0D\u5F97\u7684\u6BDB\u75C5\uFF0C\u6539\u4F5C\u4E1A\u6539\u5230\u534A\u591C\uFF0C\u7ECF\u5E38\u81EA\u8A00\u81EA\u8BED\"\u8FD9\u4E2A\u5B57\u53C8\u5199\u9519\u4E86\"\uFF0C\u58F0\u97F3\u900F\u8FC7\u8584\u8584\u7684\u5899\u58C1\u4F20\u5230\u9694\u58C1\uFF0C\u90BB\u5C45\u521A\u642C\u6765\u65F6\u4EE5\u4E3A\u5979\u6709\u53CC\u91CD\u4EBA\u683C\u3002\u5979\u8BF4\u5F53\u8001\u5E08\u5C31\u662F\u64CD\u5FC3\u7684\u547D\uFF0C\u770B\u5230\u5B66\u751F\u7684\u9519\u522B\u5B57\u6BD4\u81EA\u5DF1\u5199\u9519\u8FD8\u96BE\u53D7\u3002"
  detailedDescription: "\u97E9\u6885\u6885\uFF0C\u4ECA\u5E74\u4E09\u5341\u4E09\u5C81\uFF0C\u5728\u9644\u8FD1\u7684\u4E00\u6240\u5C0F\u5B66\u62C5\u4EFB\u8BED\u6587\u8001\u5E08\u517C\u73ED\u4E3B\u4EFB\uFF0C\u6559\u9F84\u5DF2\u7ECF\u5341\u5E74\u4E86\u3002\u5979\u8BF4\u8BDD\u6C38\u8FDC\u8F7B\u58F0\u7EC6\u8BED\uFF0C\u8D70\u8DEF\u4E5F\u662F\u5B89\u5B89\u9759\u9759\u7684\uFF0C\u50CF\u4E00\u9635\u6E29\u67D4\u7684\u6625\u98CE\u3002\u5728\u5B66\u6821\u7684\u53E3\u7891\u6781\u597D\uFF0C\u5BB6\u957F\u4EEC\u6324\u7834\u5934\u60F3\u628A\u5B69\u5B50\u9001\u5230\u5979\u73ED\u4E0A\uFF0C\u8BF4\u5979\u662F\u5168\u6821\u6700\u6709\u8010\u5FC3\u7684\u8001\u5E08\uFF0C\u6CA1\u6709\u4E4B\u4E00\u3002\n\n\u5979\u7684\u8010\u5FC3\u662F\u51FA\u4E86\u540D\u7684\u3002\u73ED\u4E0A\u6709\u4E2A\u7279\u522B\u8C03\u76AE\u7684\u7537\u751F\uFF0C\u4E0A\u8BFE\u5750\u4E0D\u4F4F\u8FD8\u7231\u6363\u4E71\uFF0C\u522B\u7684\u8001\u5E08\u90FD\u5934\u75BC\uFF0C\u552F\u72EC\u97E9\u6885\u6885\u4ECE\u6765\u4E0D\u53D1\u706B\u3002\u5979\u4F1A\u8E72\u4E0B\u6765\u8DDF\u90A3\u5B69\u5B50\u5E73\u89C6\uFF0C\u4E00\u5B57\u4E00\u53E5\u5730\u8DDF\u4ED6\u8BB2\u9053\u7406\uFF0C\u58F0\u97F3\u67D4\u548C\u5F97\u50CF\u5728\u54C4\u5C0F\u732B\u3002\u90A3\u4E2A\u7537\u751F\u540E\u6765\u6210\u4E86\u73ED\u4E0A\u6700\u542C\u5979\u8BDD\u7684\u5B66\u751F\uFF0C\u4ED6\u5988\u5988\u611F\u6FC0\u5F97\u5DEE\u70B9\u7ED9\u5979\u9001\u9526\u65D7\u3002\u5C31\u8FDE\u5C0F\u533A\u91CC\u90BB\u5C45\u5BB6\u7684\u51E0\u4E2A\u718A\u5B69\u5B50\uFF0C\u89C1\u4E86\u5979\u4E5F\u89C4\u89C4\u77E9\u77E9\u5730\u558A\"\u97E9\u8001\u5E08\u597D\"\uFF0C\u5BB6\u957F\u4EEC\u90FD\u8BF4\u97E9\u6885\u6885\u5929\u751F\u5C31\u662F\u5F53\u8001\u5E08\u7684\u6599\u3002\n\n\u4E0D\u8FC7\u5979\u6709\u4E00\u4E2A\u8BA9\u4EBA\u54ED\u7B11\u4E0D\u5F97\u7684\u4E60\u60EF\uFF0C\u5C31\u662F\u6539\u4F5C\u4E1A\u6539\u5230\u8D70\u706B\u5165\u9B54\u3002\u6BCF\u5929\u665A\u4E0A\u6279\u6539\u56DB\u5341\u591A\u672C\u4F5C\u4E1A\u672C\uFF0C\u4E00\u5750\u5C31\u662F\u4E09\u56DB\u4E2A\u5C0F\u65F6\uFF0C\u5E38\u5E38\u6539\u5230\u51CC\u6668\u4E00\u4E24\u70B9\u3002\u5979\u5BF9\u5B66\u751F\u7684\u4E66\u5199\u8981\u6C42\u6781\u9AD8\uFF0C\u4E00\u4E2A\u7B14\u753B\u4E0D\u5230\u4F4D\u90FD\u8981\u5708\u51FA\u6765\u91CD\u5199\u3002\u6539\u5230\u6FC0\u52A8\u5904\uFF0C\u5979\u4F1A\u4E0D\u7531\u81EA\u4E3B\u5730\u81EA\u8A00\u81EA\u8BED\uFF1A\"\u8FD9\u4E2A\u5B57\u53C8\u5199\u9519\u4E86\"\"\u6487\u4E0D\u662F\u8FD9\u4E48\u5199\u7684\"\"\u7B2C\u4E09\u7B14\u5E94\u8BE5\u662F\u6A2A\u6298\u94A9\"\u3002\u58F0\u97F3\u900F\u8FC7\u8584\u8584\u7684\u5899\u58C1\u4F20\u5230\u9694\u58C1\uFF0C\u90BB\u5C45\u521A\u642C\u6765\u7684\u65F6\u5019\u8FD8\u4EE5\u4E3A\u5979\u5BB6\u91CC\u4F4F\u4E86\u4E24\u4E2A\u4EBA\u5728\u5435\u67B6\uFF0C\u540E\u6765\u624D\u77E5\u9053\u662F\u5979\u6539\u4F5C\u4E1A\u6539\u9B54\u6014\u4E86\u3002\n\n\u97E9\u6885\u6885\u7684\u5BB6\u91CC\u5230\u5904\u90FD\u662F\u5B66\u751F\u7684\u4F5C\u4E1A\u672C\u548C\u6559\u5B66\u8D44\u6599\u3002\u5BA2\u5385\u8336\u51E0\u4E0A\u645E\u7740\u4E00\u6C93\u6C93\u4F5C\u6587\u672C\uFF0C\u9910\u684C\u4E0A\u644A\u7740\u5907\u8BFE\u7B14\u8BB0\uFF0C\u8FDE\u536B\u751F\u95F4\u7684\u67B6\u5B50\u4E0A\u90FD\u653E\u7740\u4E00\u672C\u300A\u5C0F\u5B66\u8BED\u6587\u8BFE\u7A0B\u6807\u51C6\u300B\u3002\u5979\u8001\u516C\u6709\u65F6\u5019\u62B1\u6028\u5BB6\u91CC\u5FEB\u53D8\u6210\u5B66\u6821\u529E\u516C\u5BA4\u4E86\uFF0C\u5979\u5C31\u7B11\u7B11\u8BF4\u4E60\u60EF\u4E86\u6539\u4E0D\u4E86\u3002\u5176\u5B9E\u5979\u8001\u516C\u4E5F\u7406\u89E3\u5979\uFF0C\u77E5\u9053\u5979\u662F\u771F\u5FC3\u70ED\u7231\u8FD9\u4EFD\u5DE5\u4F5C\u3002\n\n\u5468\u672B\u7684\u65F6\u5019\uFF0C\u5979\u559C\u6B22\u5728\u5C0F\u533A\u82B1\u56ED\u91CC\u6563\u6B65\uFF0C\u624B\u91CC\u7ECF\u5E38\u62FF\u7740\u4E00\u672C\u8BFE\u5916\u8BFB\u7269\uFF0C\u8BF4\u662F\u8981\u7ED9\u5B66\u751F\u627E\u5408\u9002\u7684\u63A8\u8350\u4E66\u76EE\u3002\u9047\u5230\u5C0F\u533A\u91CC\u7684\u5C0F\u670B\u53CB\uFF0C\u5979\u603B\u4F1A\u8E72\u4E0B\u6765\u95EE\u4EBA\u5BB6\u6700\u8FD1\u5728\u8BFB\u4EC0\u4E48\u4E66\uFF0C\u7136\u540E\u8BA4\u771F\u5730\u7ED9\u51FA\u9605\u8BFB\u5EFA\u8BAE\u3002\u6709\u4E9B\u5B69\u5B50\u6015\u8001\u5E08\uFF0C\u4F46\u97E9\u6885\u6885\u4E0D\u4E00\u6837\uFF0C\u5B69\u5B50\u4EEC\u90FD\u613F\u610F\u4EB2\u8FD1\u5979\uFF0C\u8BF4\u97E9\u8001\u5E08\u7B11\u8D77\u6765\u50CF\u5988\u5988\u4E00\u6837\u6E29\u6696\u3002\u5979\u542C\u4E86\u603B\u662F\u4E0D\u597D\u610F\u601D\u5730\u7EA2\u4E86\u8138\u3002"
