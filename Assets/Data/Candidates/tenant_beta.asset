  candidateId: tenant_beta
  displayName: "\u6797\u5C0F\u96E8"
  avatarKey: female_01
  portrait: {fileID: 21300000, guid: 5f9951c5269f535488fc636c51784c44, type: 3}
  avatarColor: {r: 0.3, g: 0.8, b: 0.3, a: 1}
  ability: 0
  activityType: 1
  shortDescription: "\u6797\u5C0F\u96E8\uFF0C\u4E8C\u5341\u516D\u5C81\uFF0C\u81EA\u7531\u804C\u4E1A\u63D2\u753B\u5E08\u3002\u6027\u683C\u5B89\u9759\u5185\u5411\uFF0C\u6781\u5C11\u4E0E\u4EBA\u4EA4\u6D41\uFF0C\u89C1\u4E86\u90BB\u5C45\u53EA\u662F\u5FAE\u5FAE\u70B9\u5934\u4FBF\u5306\u5306\u8D70\u8FC7\u3002\u767D\u5929\u51E0\u4E4E\u89C1\u4E0D\u5230\u4EBA\u5F71\uFF0C\u7A97\u5E18\u62C9\u5F97\u4E25\u4E25\u5B9E\u5B9E\uFF0C\u51CC\u6668\u4E24\u4E09\u70B9\u623F\u95F4\u91CC\u8FD8\u4EAE\u7740\u6696\u9EC4\u7684\u706F\uFF0C\u753B\u7B14\u5728\u6570\u4F4D\u677F\u4E0A\u6C99\u6C99\u4F5C\u54CD\u3002\u9633\u53F0\u4E0A\u79CD\u6EE1\u4E86\u5404\u5F0F\u5404\u6837\u7684\u591A\u8089\u690D\u7269\uFF0C\u6BCF\u4E00\u76C6\u90FD\u7EC6\u5FC3\u6253\u7406\u5F97\u4E95\u4E95\u6709\u6761\uFF0C\u8FD8\u8D34\u7740\u624B\u5199\u7684\u5C0F\u6807\u7B7E\u3002\u5076\u5C14\u4F1A\u753B\u90BB\u5C45\u7684\u732B\u54AA\uFF0C\u753B\u5F97\u6829\u6829\u5982\u751F\uFF0C\u90BB\u5C45\u770B\u4E86\u8D5E\u4E0D\u7EDD\u53E3\u5979\u5374\u7EA2\u7740\u8138\u8DD1\u56DE\u5C4B\u91CC\u3002\u6DF1\u591C\u623F\u95F4\u91CC\u5076\u5C14\u4F20\u6765\u8F7B\u58F0\u54FC\u6B4C\uFF0C\u65CB\u5F8B\u4F18\u7F8E\u5374\u900F\u7740\u4E00\u4E1D\u65C1\u4EBA\u542C\u4E0D\u61C2\u7684\u5FE7\u4F24\u3002\u7A7F\u7740\u6253\u626E\u6587\u827A\u6E05\u65B0\uFF0C\u603B\u662F\u6234\u7740\u5927\u8033\u673A\uFF0C\u6C89\u6D78\u5728\u81EA\u5DF1\u7684\u4E16\u754C\u91CC\u4E0D\u613F\u88AB\u6253\u6270\u3002"
  detailedDescription: "\u6797\u5C0F\u96E8\uFF0C\u4E8C\u5341\u516D\u5C81\uFF0C\u81EA\u7531\u804C\u4E1A\u63D2\u753B\u5E08\u3002\u5927\u5B66\u5B66\u7684\u662F\u89C6\u89C9\u4F20\u8FBE\u8BBE\u8BA1\uFF0C\u6BD5\u4E1A\u540E\u6CA1\u53BB\u627E\u6B63\u5F0F\u5DE5\u4F5C\uFF0C\u4E00\u76F4\u5728\u5BB6\u63A5\u5546\u4E1A\u63D2\u753B\u7684\u5355\u5B50\u3002\u5979\u6027\u683C\u5B89\u9759\u5185\u5411\uFF0C\u6781\u5C11\u4E0E\u4EBA\u4EA4\u6D41\uFF0C\u5728\u697C\u9053\u91CC\u78B0\u89C1\u90BB\u5C45\u53EA\u662F\u5FAE\u5FAE\u70B9\u5934\uFF0C\u4FBF\u5306\u5306\u4F4E\u5934\u8D70\u8FC7\u3002\u767D\u5929\u51E0\u4E4E\u89C1\u4E0D\u5230\u5979\u7684\u4EBA\u5F71\uFF0C\u7A97\u5E18\u4E5F\u603B\u662F\u62C9\u5F97\u4E25\u4E25\u5B9E\u5B9E\uFF0C\u76F4\u5230\u508D\u665A\u65F6\u5206\u624D\u4F1A\u770B\u5230\u5979\u6234\u7740\u5927\u8033\u673A\u51FA\u95E8\uFF0C\u53BB\u4FBF\u5229\u5E97\u4E70\u4E9B\u901F\u98DF\u548C\u5496\u5561\u56DE\u6765\u3002\n\n\u6797\u5C0F\u96E8\u7684\u4F5C\u606F\u65F6\u95F4\u548C\u666E\u901A\u4EBA\u5B8C\u5168\u76F8\u53CD\u3002\u767D\u5929\u7761\u89C9\uFF0C\u508D\u665A\u5F00\u59CB\u5DE5\u4F5C\uFF0C\u51CC\u6668\u4E24\u4E09\u70B9\u623F\u95F4\u91CC\u8FD8\u4EAE\u7740\u6696\u9EC4\u8272\u7684\u706F\uFF0C\u53EA\u542C\u89C1\u753B\u7B14\u5728\u6570\u4F4D\u677F\u4E0A\u6C99\u6C99\u4F5C\u54CD\u3002\u5979\u63A5\u7684\u5355\u5B50\u79CD\u7C7B\u5F88\u6742\uFF0C\u6709\u513F\u7AE5\u7ED8\u672C\u7684\u63D2\u56FE\uFF0C\u6709\u6E38\u620F\u516C\u53F8\u7684\u89D2\u8272\u8BBE\u8BA1\uFF0C\u4E5F\u6709\u5546\u4E1A\u5E7F\u544A\u7684\u89C6\u89C9\u7D20\u6750\u3002\u6536\u5165\u4E0D\u7B97\u7A33\u5B9A\uFF0C\u597D\u7684\u6708\u4EFD\u80FD\u6323\u4E0D\u5C11\uFF0C\u5DEE\u7684\u65F6\u5019\u8FDE\u623F\u79DF\u90FD\u7D27\u5DF4\u5DF4\u7684\u3002\u4F46\u5979\u4F3C\u4E4E\u5E76\u4E0D\u592A\u5728\u610F\u7269\u8D28\u751F\u6D3B\uFF0C\u53EA\u8981\u80FD\u753B\u753B\u5C31\u5FC3\u6EE1\u610F\u8DB3\u3002\n\n\u9633\u53F0\u4E0A\u662F\u6797\u5C0F\u96E8\u552F\u4E00\u7684\u793E\u4EA4\u573A\u6240\u3002\u5979\u5728\u9633\u53F0\u4E0A\u79CD\u4E86\u6EE1\u6EE1\u4E00\u76C6\u76C6\u7684\u591A\u8089\u690D\u7269\uFF0C\u54C1\u79CD\u7E41\u591A\u7433\u7405\u6EE1\u76EE\uFF0C\u6BCF\u4E00\u76C6\u90FD\u6253\u7406\u5F97\u7CBE\u81F4\u53EF\u7231\u3002\u6D47\u6C34\u3001\u65BD\u80A5\u3001\u6362\u76C6\uFF0C\u5979\u5BF9\u8FD9\u4E9B\u5C0F\u690D\u7269\u7684\u7167\u6599\u6BD4\u5BF9\u81EA\u5DF1\u8FD8\u4E0A\u5FC3\u3002\u5076\u5C14\u5929\u6C14\u597D\u7684\u65F6\u5019\uFF0C\u5979\u4F1A\u642C\u4E2A\u5C0F\u677F\u51F3\u5750\u5728\u9633\u53F0\u4E0A\uFF0C\u4E00\u8FB9\u6652\u592A\u9633\u4E00\u8FB9\u753B\u901F\u5199\u3002\u6709\u4E00\u6B21\u5979\u753B\u4E86\u697C\u4E0B\u5F20\u5927\u7237\u517B\u7684\u6A58\u732B\uFF0C\u753B\u5F97\u60DF\u5999\u60DF\u8096\uFF0C\u5F20\u5927\u7237\u770B\u5230\u540E\u8D5E\u4E0D\u7EDD\u53E3\uFF0C\u5979\u5374\u7EA2\u7740\u8138\u8DD1\u56DE\u4E86\u5C4B\u91CC\u3002\n\n\u6797\u5C0F\u96E8\u7684\u751F\u6D3B\u7B80\u5355\u5230\u8FD1\u4E4E\u5355\u8C03\u3002\u623F\u95F4\u91CC\u9664\u4E86\u753B\u5177\u548C\u7535\u8111\uFF0C\u51E0\u4E4E\u6CA1\u6709\u4EC0\u4E48\u591A\u4F59\u7684\u7269\u4EF6\u3002\u5899\u4E0A\u8D34\u6EE1\u4E86\u5979\u7684\u4F5C\u54C1\u548C\u7075\u611F\u7D20\u6750\uFF0C\u4E66\u67B6\u4E0A\u6446\u7740\u5404\u79CD\u753B\u518C\u548C\u8BBE\u8BA1\u4E66\u7C4D\u3002\u51B0\u7BB1\u91CC\u6C38\u8FDC\u662F\u901F\u51BB\u6C34\u997A\u548C\u5373\u98DF\u996D\u56E2\uFF0C\u53A8\u623F\u51E0\u4E4E\u4ECE\u4E0D\u5F00\u706B\u3002\u5979\u5F88\u5C11\u7F51\u8D2D\uFF0C\u4E0D\u8FFD\u5267\u4E0D\u5237\u77ED\u89C6\u9891\uFF0C\u552F\u4E00\u7684\u5A31\u4E50\u5C31\u662F\u542C\u97F3\u4E50\u753B\u753B\uFF0C\u5076\u5C14\u6DF1\u591C\u4F1A\u8F7B\u58F0\u54FC\u51E0\u9996\u6C11\u8C23\uFF0C\u65CB\u5F8B\u4F18\u7F8E\u5374\u900F\u7740\u4E00\u4E1D\u65C1\u4EBA\u542C\u4E0D\u61C2\u7684\u5FE7\u4F24\u3002\n\n\u90BB\u5C45\u4EEC\u5BF9\u6797\u5C0F\u96E8\u7684\u5370\u8C61\u5C31\u662F\u4E00\u4E2A\u5B89\u9759\u7684\u6587\u827A\u5973\u5B69\u3002\u5979\u4ECE\u4E0D\u5236\u9020\u566A\u97F3\uFF0C\u4ECE\u4E0D\u62D6\u6B20\u623F\u79DF\uFF0C\u4E5F\u4ECE\u4E0D\u53C2\u4E0E\u697C\u680B\u91CC\u7684\u4EFB\u4F55\u662F\u975E\u3002\u4F46\u6B63\u662F\u8FD9\u79CD\u8FC7\u5206\u7684\u5B89\u9759\u8BA9\u4EBA\u89C9\u5F97\u6709\u4E9B\u6349\u6478\u4E0D\u900F\uFF0C\u4EFF\u4F5B\u5979\u628A\u81EA\u5DF1\u5C01\u95ED\u5728\u4E00\u4E2A\u900F\u660E\u7684\u73BB\u7483\u7F69\u91CC\uFF0C\u770B\u5F97\u89C1\u5374\u89E6\u78B0\u4E0D\u5230\u3002\u6709\u4EBA\u8BF4\u5979\u53EF\u80FD\u5728\u753B\u4EC0\u4E48\u4E86\u4E0D\u8D77\u7684\u5927\u4F5C\u54C1\uFF0C\u4E5F\u6709\u4EBA\u8BF4\u5979\u53EA\u662F\u6027\u683C\u793E\u6050\u800C\u5DF2\uFF0C\u4F46\u6CA1\u4EBA\u771F\u6B63\u4E86\u89E3\u8FD9\u4E2A\u663C\u4F0F\u591C\u51FA\u7684\u5973\u5B69\u5185\u5FC3\u5728\u60F3\u4EC0\u4E48\u3002"
