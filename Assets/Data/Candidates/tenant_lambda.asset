  candidateId: tenant_lambda
  portrait: {fileID: 0}
  ability: 6
  activityType: 0
  displayName: "\u5b59\u5927\u5723"
  avatarColor: {r: 0.4, g: 0.7, b: 0.4, a: 1}
  shortDescription: "\u5b59\u5927\u5723\uff0c\u56db\u5341\u5c81\uff0c\u57ce\u4e1c\"\u98de\u6bdb\u817f\"\u5feb\u9012\u7ad9\u70b9\u8d1f\u8d23\u4eba\u3002\u540d\u5b57\u53d6\u5f97\u9738\u6c14\uff0c\u505a\u8d77\u4e8b\u6765\u66f4\u4e0d\u542b\u7cca\uff0c\u65b9\u5706\u4e09\u6761\u8857\u7684\u5feb\u9012\u4ef6\u4ed6\u90fd\u95e8\u513f\u6e05\u3002\u8bb0\u5fc6\u529b\u60ca\u4eba\uff0c\u8c01\u5bb6\u4f4f\u51e0\u680b\u51e0\u5355\u5143\u3001\u5e38\u4e70\u4ec0\u4e48\u4e1c\u897f\uff0c\u4ed6\u6bd4\u5feb\u9012\u5355\u53f7\u7cfb\u7edf\u8bb0\u5f97\u8fd8\u6e05\u695a\u3002\n\u4e3a\u4eba\u53e4\u9053\u70ed\u80a0\uff0c\u5e2e\u8857\u574a\u4ee3\u6536\u5305\u88f9\u4ece\u4e0d\u6536\u4e00\u5206\u94b1\uff0c\u8fd8\u4f1a\u8d34\u5fc3\u5730\u53d1\u77ed\u4fe1\u63d0\u9192\u53d6\u4ef6\u65f6\u95f4\u3002\u552f\u4e00\u7684\u6bdb\u75c5\u5c31\u662f\u597d\u5947\u5fc3\u592a\u91cd\uff0c\u603b\u5fcd\u4e0d\u4f4f\u6382\u91cf\u522b\u4eba\u7684\u5305\u88f9\u731c\u91cc\u9762\u662f\u4ec0\u4e48\uff0c\u5076\u5c14\u8fd8\u4f1a\u65c1\u6572\u4fa7\u51fb\u5730\u6253\u542c\uff0c\u88ab\u6295\u8bc9\u8fc7\u51e0\u6b21\u4ecd\u7136\u6539\u4e0d\u4e86\u3002\n\u6ca1\u4e8b\u5c31\u8e72\u5728\u7ad9\u70b9\u95e8\u53e3\u8ddf\u5927\u7237\u5927\u5988\u5520\u55d1\uff0c\u662f\u6574\u6761\u8857\u6d88\u606f\u6700\u7075\u901a\u7684\u4eba\uff0c\u6ca1\u6709\u4e4b\u4e00\u3002"
  detailedDescription: "\u5b59\u5927\u5723\uff0c\u672c\u540d\u5b59\u80dc\u5229\uff0c\u56db\u5341\u5c81\u51fa\u5934\uff0c\u8001\u5bb6\u6cb3\u5357\uff0c\u6765\u8fd9\u5ea7\u57ce\u5e02\u6253\u62fc\u5feb\u4e8c\u5341\u5e74\u4e86\u3002\u4ece\u6700\u521d\u9a91\u7740\u4e09\u8f6e\u8f66\u9001\u5feb\u9012\uff0c\u5230\u73b0\u5728\u627f\u5305\u4e86\u57ce\u4e1c\u4e00\u6574\u7247\u533a\u57df\u7684\u5feb\u9012\u7ad9\u70b9\uff0c\u5168\u9760\u4e00\u53cc\u624b\u548c\u4e00\u526f\u597d\u8bb0\u6027\u8d77\u5bb6\u3002\u7ad9\u70b9\u53d6\u540d\"\u98de\u6bdb\u817f\"\uff0c\u867d\u7136\u95e8\u8138\u4e0d\u5927\uff0c\u4f46\u6bcf\u5929\u7ecf\u624b\u7684\u5305\u88f9\u5c11\u8bf4\u4e5f\u6709\u56db\u4e94\u767e\u4ef6\uff0c\u9022\u53cc\u5341\u4e00\u3001\u516d\u4e00\u516b\u8fd9\u79cd\u5927\u4fc3\uff0c\u5806\u5f97\u8ddf\u5c0f\u5c71\u4f3c\u7684\uff0c\u4ed6\u7167\u6837\u80fd\u51c6\u786e\u65e0\u8bef\u5730\u5206\u62e3\u6d3e\u9001\u3002\n\u5b59\u5927\u5723\u6700\u5927\u7684\u672c\u4e8b\u5c31\u662f\u8bb0\u6027\u597d\u3002\u4ed6\u8111\u5b50\u91cc\u4eff\u4f5b\u88c5\u4e86\u4e00\u53f0\u6d3b\u4f53\u6570\u636e\u5e93\uff0c\u54ea\u4e2a\u5ba2\u6237\u4f4f\u51e0\u680b\u51e0\u697c\u3001\u95e8\u724c\u53f7\u662f\u591a\u5c11\u3001\u559c\u6b22\u4ec0\u4e48\u65f6\u5019\u6536\u4ef6\u3001\u5305\u88f9\u5927\u6982\u591a\u91cd\uff0c\u4ed6\u5168\u8bb0\u5f97\u4e00\u6e05\u4e8c\u695a\u3002\u6709\u65b0\u6765\u7684\u5feb\u9012\u5458\u641e\u4e0d\u6e05\u695a\u7247\u533a\uff0c\u4ed6\u968f\u53e3\u5c31\u80fd\u62a5\u51fa\u6bcf\u5bb6\u6bcf\u6237\u7684\u4fe1\u606f\uff0c\u6bd4\u5bfc\u822a\u8f6f\u4ef6\u8fd8\u51c6\u3002\u8857\u574a\u4eec\u90fd\u8bf4\uff0c\u8981\u662f\u5b59\u5927\u5723\u53bb\u53c2\u52a0\u6700\u5f3a\u5927\u8111\uff0c\u51a0\u519b\u975e\u4ed6\u83ab\u5c5e\u3002\n\u4ed6\u4e3a\u4eba\u70ed\u5fc3\uff0c\u7ad9\u70b9\u9664\u4e86\u6536\u53d1\u5feb\u9012\uff0c\u8fd8\u517c\u7740\u534a\u4e2a\u793e\u533a\u670d\u52a1\u4e2d\u5fc3\u7684\u529f\u80fd\u3002\u8001\u4eba\u5bb6\u4e0d\u4f1a\u7528\u624b\u673a\u67e5\u7269\u6d41\uff0c\u4ed6\u5e2e\u7740\u67e5\uff1b\u5e74\u8f7b\u4eba\u4e0a\u73ed\u6ca1\u7a7a\u53d6\u4ef6\uff0c\u4ed6\u514d\u8d39\u4ee3\u6536\uff0c\u8fd8\u6309\u65e5\u671f\u6574\u9f50\u7801\u597d\u3002\u6709\u65f6\u5019\u5305\u88f9\u592a\u591a\u653e\u4e0d\u4e0b\uff0c\u4ed6\u5c31\u81ea\u5df1\u638f\u94b1\u79df\u4e86\u9694\u58c1\u4e00\u95f4\u5c0f\u4ed3\u5e93\u3002\u90bb\u5c45\u4eec\u8fc7\u610f\u4e0d\u53bb\u8981\u7ed9\u4ed6\u8f9b\u82e6\u8d39\uff0c\u4ed6\u6446\u6446\u624b\u8bf4\u90fd\u662f\u987a\u624b\u7684\u4e8b\uff0c\u4e0d\u503c\u5f53\u63d0\u94b1\u3002\n\u4e0d\u8fc7\u5b59\u5927\u5723\u6709\u4e2a\u8ba9\u4eba\u54ed\u7b11\u4e0d\u5f97\u7684\u6bdb\u75c5\u2014\u2014\u597d\u5947\u5fc3\u592a\u91cd\u3002\u4ed6\u5bf9\u6bcf\u4e2a\u5305\u88f9\u91cc\u88c5\u4e86\u4ec0\u4e48\u90fd\u5145\u6ee1\u5174\u8da3\uff0c\u603b\u5fcd\u4e0d\u4f4f\u7528\u624b\u6382\u91cf\u3001\u7528\u9f3b\u5b50\u95fb\uff0c\u751a\u81f3\u5bf9\u7740\u5149\u770b\u5f62\u72b6\u3002\u6709\u6b21\u4ed6\u65ad\u5b9a\u4e00\u4e2a\u5305\u88f9\u91cc\u662f\u69b4\u83b2\uff0c\u7ed3\u679c\u6253\u5f00\u53d1\u73b0\u662f\u81ed\u8c46\u8150\uff0c\u95f9\u4e86\u5927\u7b11\u8bdd\u3002\u66f4\u6709\u4e00\u6b21\u4ed6\u95fb\u5230\u4e00\u4e2a\u5305\u88f9\u6709\u5f02\u5473\uff0c\u4ee5\u4e3a\u662f\u8fdd\u7981\u54c1\uff0c\u5174\u51b2\u51b2\u62a5\u544a\u4e86\u7269\u4e1a\uff0c\u6700\u540e\u53d1\u73b0\u662f\u90bb\u5c45\u7f51\u8d2d\u7684\u87ba\u86f3\u7c89\u3002\u4e3a\u6b64\u88ab\u6295\u8bc9\u4e86\u597d\u51e0\u56de\uff0c\u4f46\u5c31\u662f\u6539\u4e0d\u4e86\u3002\n\u95f2\u6687\u65f6\u5019\uff0c\u5b59\u5927\u5723\u559c\u6b22\u642c\u4e2a\u5c0f\u677f\u51f3\u5750\u5728\u7ad9\u70b9\u95e8\u53e3\uff0c\u6ce1\u4e00\u676f\u6d53\u8336\uff0c\u8ddf\u6765\u6765\u5f80\u5f80\u7684\u8857\u574a\u5520\u55d1\u3002\u4e1c\u5bb6\u957f\u897f\u5bb6\u77ed\uff0c\u8c01\u5bb6\u5b69\u5b50\u8003\u4e0a\u5927\u5b66\u4e86\u3001\u8c01\u5bb6\u8001\u4eba\u751f\u75c5\u4f4f\u9662\u4e86\uff0c\u4ed6\u5168\u77e5\u9053\u3002\u4ed6\u5e38\u8bf4\u81ea\u5df1\u867d\u7136\u53ea\u662f\u4e2a\u9001\u5feb\u9012\u7684\uff0c\u4f46\u8fd9\u6761\u8857\u4e0a\u7684\u5927\u4e8b\u5c0f\u4e8b\u90fd\u9003\u4e0d\u8fc7\u4ed6\u7684\u8033\u6735\u3002\u6bcf\u5e74\u4e2d\u79cb\u8282\u4ed6\u90fd\u4f1a\u81ea\u8d39\u4e70\u6708\u997c\u5206\u7ed9\u8857\u574a\u4eec\uff0c\u867d\u7136\u90fd\u662f\u8d85\u5e02\u6253\u6298\u7684\u6563\u88c5\u6708\u997c\uff0c\u4f46\u90a3\u4efd\u5fc3\u610f\u6bd4\u4ec0\u4e48\u90fd\u91d1\u8d35\u3002\u90bb\u5c45\u4eec\u79c1\u5e95\u4e0b\u53eb\u4ed6\"\u6d3b\u96f7\u8fbe\"\uff0c\u4ed6\u542c\u4e86\u4e0d\u607c\uff0c\u53cd\u800c\u633a\u5f97\u610f\u3002"
