  candidateId: tenant_nu
  displayName: "\u9A6C\u5927\u59D0"
  avatarKey: female_05
  portrait: {fileID: 21300000, guid: 0bd6409549bf22e4187aef203c6843e9, type: 3}
  avatarColor: {r: 0.9, g: 0.85, b: 0.5, a: 1}
  ability: 5
  activityType: 0
  shortDescription: "\u9A6C\u5927\u59D0\uFF0C\u4E94\u5341\u5C81\uFF0C\u793E\u533A\u5C45\u59D4\u4F1A\u4E3B\u4EFB\uFF0C\u5728\u8FD9\u7247\u5C0F\u533A\u624E\u6839\u5FEB\u4E09\u5341\u5E74\u4E86\u3002\u9000\u4F11\u524D\u662F\u7EBA\u7EC7\u5382\u7684\u8F66\u95F4\u4E3B\u4EFB\uFF0C\u7BA1\u4EBA\u7BA1\u4E60\u60EF\u4E86\uFF0C\u9000\u4E0B\u6765\u4E5F\u95F2\u4E0D\u4F4F\u3002\u8C03\u89E3\u90BB\u91CC\u7EA0\u7EB7\u662F\u4E00\u628A\u597D\u624B\uFF0C\u8BF4\u8BDD\u6709\u7406\u6709\u636E\u8BA9\u4EBA\u4FE1\u670D\uFF0C\u8FDE\u7269\u4E1A\u7ECF\u7406\u89C1\u4E86\u5979\u90FD\u5F97\u5BA2\u5BA2\u6C14\u6C14\u3002\n\u4F46\u7BA1\u5F97\u5B9E\u5728\u592A\u5BBD\uFF0C\u4ECE\u90BB\u5C45\u5BB6\u5B69\u5B50\u8003\u4E86\u51E0\u5206\u5230\u4E24\u53E3\u5B50\u4E3A\u4EC0\u4E48\u5435\u67B6\uFF0C\u5979\u90FD\u8981\u8FC7\u95EE\u3002\u53E3\u5934\u7985\u662F\"\u6211\u662F\u4E3A\u4F60\u597D\"\uFF0C\u914D\u4E0A\u90A3\u8BED\u91CD\u5FC3\u957F\u7684\u8BED\u6C14\uFF0C\u4EFB\u8C01\u90FD\u62DB\u67B6\u4E0D\u4F4F\u3002\n\u517B\u4E86\u4E00\u6761\u53EB\u65FA\u8D22\u7684\u91D1\u6BDB\u72AC\uFF0C\u7ECF\u5E38\u5728\u697C\u9053\u91CC\u905B\u8FBE\uFF0C\u65FA\u8D22\u7684\u793E\u4EA4\u5708\u6BD4\u5979\u8FD8\u5E7F\u3002"
  detailedDescription: "\u9A6C\u5927\u59D0\uFF0C\u672C\u540D\u9A6C\u79C0\u5170\uFF0C\u4E94\u5341\u5C81\u6574\uFF0C\u5728\u8FD9\u4E2A\u5C0F\u533A\u4ECE\u5EFA\u6210\u90A3\u5929\u8D77\u5C31\u4F4F\u7740\uFF0C\u662F\u540D\u526F\u5176\u5B9E\u7684\u5143\u8001\u7EA7\u4F4F\u6237\u3002\u4E8C\u5341\u5E74\u524D\u88AB\u9009\u4E3A\u5C45\u59D4\u4F1A\u4E3B\u4EFB\uFF0C\u4ECE\u6B64\u628A\u8FD9\u7247\u5C0F\u533A\u5F53\u6210\u4E86\u81EA\u5DF1\u7684\u7B2C\u4E8C\u4E2A\u5BB6\u3002\u5979\u5BF9\u5C0F\u533A\u91CC\u7684\u6BCF\u680B\u697C\u3001\u6BCF\u6237\u4EBA\u5BB6\u90FD\u4E86\u5982\u6307\u638C\uFF0C\u8C01\u5BB6\u51E0\u53E3\u4EBA\u3001\u505A\u4EC0\u4E48\u5DE5\u4F5C\u3001\u5B69\u5B50\u591A\u5927\uFF0C\u5979\u5168\u95E8\u513F\u6E05\u3002\u6709\u4EBA\u8BF4\u5979\u6BD4\u6D3E\u51FA\u6240\u7684\u6237\u7C4D\u8B66\u8FD8\u4E86\u89E3\u8FD9\u7247\u5C0F\u533A\u3002\n\u9A6C\u5927\u59D0\u6700\u64C5\u957F\u7684\u5C31\u662F\u8C03\u89E3\u90BB\u91CC\u77DB\u76FE\u3002\u697C\u4E0A\u6F0F\u6C34\u6DF9\u4E86\u697C\u4E0B\u3001\u9694\u58C1\u88C5\u4FEE\u566A\u97F3\u592A\u5927\u3001\u516C\u5171\u533A\u57DF\u5806\u653E\u6742\u7269\u2026\u2026\u4F46\u51E1\u6709\u4EBA\u627E\u5230\u5979\uFF0C\u5979\u90FD\u80FD\u8010\u5FC3\u542C\u53CC\u65B9\u8BF4\u5B8C\uFF0C\u7136\u540E\u6761\u5206\u7F15\u6790\u5730\u8BB2\u9053\u7406\uFF0C\u76F4\u5230\u4E24\u8FB9\u90FD\u5FC3\u670D\u53E3\u670D\u3002\u5979\u6709\u4E2A\u968F\u8EAB\u643A\u5E26\u7684\u5C0F\u672C\u5B50\uFF0C\u4E0A\u9762\u5BC6\u5BC6\u9EBB\u9EBB\u8BB0\u7740\u5404\u79CD\u7EA0\u7EB7\u7684\u5904\u7406\u7ECF\u8FC7\uFF0C\u636E\u8BF4\u5230\u73B0\u5728\u5DF2\u7ECF\u5199\u6EE1\u4E86\u4E03\u672C\u3002\u7269\u4E1A\u7ECF\u7406\u79C1\u4E0B\u8BF4\uFF0C\u5C0F\u533A\u80FD\u8FD9\u4E48\u592A\u5E73\uFF0C\u9A6C\u5927\u59D0\u529F\u4E0D\u53EF\u6CA1\u3002\n\u4E0D\u8FC7\u9A6C\u5927\u59D0\u6709\u4E2A\u8BA9\u4EBA\u53C8\u7231\u53C8\u5934\u75BC\u7684\u7279\u70B9\u2014\u2014\u7BA1\u5F97\u592A\u5BBD\u3002\u90BB\u5C45\u5BB6\u4E24\u53E3\u5B50\u62CC\u5634\uFF0C\u5979\u8981\u53BB\u529D\u548C\uFF1B\u8C01\u5BB6\u5B69\u5B50\u6210\u7EE9\u4E0B\u6ED1\uFF0C\u5979\u8981\u53BB\u5BB6\u8BBF\uFF1B\u751A\u81F3\u8C01\u5BB6\u4ECA\u5929\u6CA1\u505A\u996D\u70B9\u4E86\u5916\u5356\uFF0C\u5979\u90FD\u8981\u5173\u5FC3\u4E24\u53E5\u662F\u4E0D\u662F\u8EAB\u4F53\u4E0D\u8212\u670D\u3002\u5979\u7684\u53E3\u5934\u7985\"\u6211\u662F\u4E3A\u4F60\u597D\"\u914D\u4E0A\u90A3\u8BED\u91CD\u5FC3\u957F\u7684\u8868\u60C5\uFF0C\u5DF2\u7ECF\u6210\u4E3A\u5C0F\u533A\u5C45\u6C11\u7684\u96C6\u4F53\u8BB0\u5FC6\u3002\u5E74\u8F7B\u4EBA\u79C1\u5E95\u4E0B\u53EB\u5979\"\u5C45\u59D4\u4F1A\u5988\u5988\"\uFF0C\u867D\u7136\u5634\u4E0A\u62B1\u6028\uFF0C\u4F46\u771F\u9047\u5230\u4E8B\u7B2C\u4E00\u4E2A\u60F3\u5230\u7684\u8FD8\u662F\u5979\u3002\n\u9A6C\u5927\u59D0\u517B\u4E86\u4E00\u6761\u91D1\u6BDB\u72AC\uFF0C\u53D6\u540D\u53EB\u65FA\u8D22\u3002\u65FA\u8D22\u8DDF\u5979\u4E3B\u4EBA\u4E00\u6837\u793E\u4EA4\u80FD\u529B\u8D85\u5F3A\uFF0C\u6BCF\u5929\u5728\u697C\u9053\u91CC\u6E9C\u8FBE\u4E00\u5708\uFF0C\u80FD\u8DDF\u4E03\u516B\u6237\u4EBA\u5BB6\u6253\u62DB\u547C\u3002\u5B83\u4F1A\u81EA\u5DF1\u5750\u7535\u68AF\uFF0C\u4F1A\u8BA4\u95E8\u724C\u53F7\uFF0C\u751A\u81F3\u77E5\u9053\u54EA\u6237\u4EBA\u5BB6\u7ED9\u5B83\u7559\u4E86\u96F6\u98DF\u3002\u6709\u4F4F\u6237\u5F00\u73A9\u7B11\u8BF4\uFF0C\u65FA\u8D22\u624D\u662F\u5C0F\u533A\u771F\u6B63\u7684\u5C45\u59D4\u4F1A\u526F\u4E3B\u4EFB\u3002\u9A6C\u5927\u59D0\u542C\u4E86\u4E5F\u4E0D\u751F\u6C14\uFF0C\u7B11\u7740\u8BF4\u65FA\u8D22\u968F\u5979\uFF0C\u5929\u751F\u7231\u64CD\u5FC3\u3002\n\u9022\u5E74\u8FC7\u8282\u662F\u9A6C\u5927\u59D0\u6700\u5FD9\u7684\u65F6\u5019\u3002\u7EC4\u7EC7\u5305\u997A\u5B50\u3001\u641E\u8054\u6B22\u3001\u6170\u95EE\u72EC\u5C45\u8001\u4EBA\uFF0C\u6BCF\u4E00\u6837\u5979\u90FD\u4EB2\u529B\u4EB2\u4E3A\u3002\u5C0F\u533A\u7684\u5FAE\u4FE1\u7FA4\u5979\u5EFA\u4E86\u597D\u51E0\u4E2A\u2014\u2014\u4E1A\u4E3B\u7FA4\u3001\u5BA0\u7269\u7FA4\u3001\u4E8C\u624B\u95F2\u7F6E\u7FA4\u3001\u5065\u8EAB\u6253\u5361\u7FA4\uFF0C\u6BCF\u6761\u6D88\u606F\u5979\u90FD\u8981\u770B\uFF0C\u6BCF\u4EF6\u4E8B\u5979\u90FD\u8981\u8FC7\u95EE\u3002\u6709\u4EBA\u89C9\u5F97\u5979\u7BA1\u5F97\u592A\u591A\uFF0C\u4F46\u66F4\u591A\u4EBA\u6253\u5FC3\u5E95\u91CC\u611F\u6FC0\uFF0C\u56E0\u4E3A\u8FD9\u4E2A\u5C0F\u533A\u4E4B\u6240\u4EE5\u50CF\u4E2A\u5927\u5BB6\u5EAD\uFF0C\u5168\u9760\u9A6C\u5927\u59D0\u5728\u4E2D\u95F4\u7275\u7EBF\u642D\u6865\u3002"
