  candidateId: tenant_kappa
  displayName: "\u5C0F\u751C\u751C"
  avatarKey: female_04
  portrait: {fileID: 21300000, guid: fc0a8be3a8c31f9468b548109fa62e5e, type: 3}
  avatarColor: {r: 0.9, g: 0.6, b: 0.6, a: 1}
  ability: 2
  activityType: 1
  shortDescription: "\u5C0F\u751C\u751C\uFF0C\u4E09\u5341\u4E94\u5C81\uFF0C\u697C\u4E0B\u751C\u54C1\u5E97\u8001\u677F\u5A18\uFF0C\u4EBA\u5982\u5176\u540D\u8BF4\u8BDD\u751C\u505A\u4E8B\u751C\u8FDE\u547C\u5438\u90FD\u662F\u751C\u7684\u3002\u6BCF\u5929\u51CC\u6668\u4E09\u70B9\u5C31\u8D77\u5E8A\u51C6\u5907\u70D8\u7119\u6750\u6599\uFF0C\u70E4\u7BB1\u91CC\u7684\u9999\u6C14\u98D8\u6EE1\u6574\u6761\u697C\u9053\uFF0C\u6210\u4E86\u90BB\u5C45\u4EEC\u7684\u5929\u7136\u95F9\u949F\u3002\u505A\u7684\u63D0\u62C9\u7C73\u82CF\u662F\u9547\u5E97\u62DB\u724C\uFF0C\u636E\u8BF4\u914D\u65B9\u4ECE\u610F\u5927\u5229\u5E08\u5085\u90A3\u91CC\u5B66\u6765\uFF0C\u4ECE\u4E0D\u5916\u4F20\u79D8\u65B9\u3002\u6027\u683C\u5F00\u6717\u7231\u7B11\uFF0C\u5634\u4E0A\u5929\u5929\u558A\u51CF\u80A5\uFF0C\u8EAB\u4F53\u5374\u8BDA\u5B9E\u5730\u628A\u6BCF\u6B3E\u65B0\u54C1\u90FD\u5C1D\u4E86\u4E2A\u904D\u3002"
  detailedDescription: "\u5C0F\u751C\u751C\uFF0C\u5927\u540D\u7530\u751C\uFF0C\u4E09\u5341\u4E94\u5C81\uFF0C\u697C\u4E0B\u751C\u54C1\u5E97\u871C\u7CD6\u65F6\u5149\u7684\u8001\u677F\u5A18\u3002\u4EBA\u5982\u5176\u540D\uFF0C\u8BF4\u8BDD\u751C\u505A\u4E8B\u751C\uFF0C\u8FDE\u547C\u5438\u90FD\u662F\u751C\u7684\uFF0C\u6BCF\u5929\u51CC\u6668\u4E09\u70B9\u5C31\u8D77\u5E8A\u5728\u53A8\u623F\u91CC\u5FD9\u6D3B\uFF0C\u70E4\u7BB1\u91CC\u7684\u9EC4\u6CB9\u548C\u7126\u7CD6\u9999\u6C14\u98D8\u6EE1\u6574\u6761\u697C\u9053\uFF0C\u6210\u4E86\u90BB\u5C45\u4EEC\u96F7\u6253\u4E0D\u52A8\u7684\u5929\u7136\u95F9\u949F\u3002\u5979\u8BF4\u505A\u751C\u54C1\u5C31\u50CF\u8C08\u604B\u7231\uFF0C\u8981\u7528\u5FC3\u7528\u60C5\u7528\u6599\u5B9E\u5728\uFF0C\u9A6C\u864E\u4E0D\u5F97\u3002\n\n\u505A\u7684\u63D0\u62C9\u7C73\u82CF\u662F\u9547\u5E97\u62DB\u724C\uFF0C\u636E\u8BF4\u914D\u65B9\u662F\u4ECE\u4E00\u4F4D\u610F\u5927\u5229\u8001\u5E08\u5085\u90A3\u91CC\u5B66\u6765\u7684\uFF0C\u4F46\u5979\u4ECE\u4E0D\u544A\u8BC9\u4EFB\u4F55\u4EBA\u5177\u4F53\u79D8\u8BC0\uFF0C\u8C01\u95EE\u90FD\u7B11\u7740\u8BF4\u8FD9\u662F\u5546\u4E1A\u673A\u5BC6\uFF0C\u544A\u8BC9\u4F60\u6211\u5C31\u5931\u4E1A\u4E86\u3002\u7528\u6599\u6781\u5176\u8BB2\u7A76\uFF0C\u9EC4\u6CB9\u5FC5\u987B\u662F\u65B0\u897F\u5170\u8FDB\u53E3\u7684\uFF0C\u5DE7\u514B\u529B\u53EA\u7528\u6BD4\u5229\u65F6\u7684\uFF0C\u5976\u6CB9\u975E\u6CD5\u56FD\u8D27\u4E0D\u7528\u3002\u6210\u672C\u9AD8\u5F97\u540C\u884C\u770B\u4E86\u76F4\u6447\u5934\uFF0C\u4F46\u5979\u8BF4\u5B81\u613F\u5C11\u8D5A\u4E5F\u4E0D\u80FD\u7838\u4E86\u62DB\u724C\u3002\n\n\u5E97\u9762\u88C5\u4FEE\u662F\u5979\u4EB2\u624B\u8BBE\u8BA1\u7684\uFF0C\u7C89\u8272\u788E\u82B1\u5899\u7EB8\u914D\u767D\u8272\u94C1\u827A\u684C\u6905\uFF0C\u5230\u5904\u6446\u7740\u5E72\u82B1\u548C\u6BDB\u7ED2\u5C0F\u6446\u4EF6\uFF0C\u6E29\u99A8\u5F97\u50CF\u8D70\u8FDB\u4E86\u4E00\u4E2A\u751C\u871C\u7684\u7AE5\u8BDD\u4E16\u754C\u3002\u5899\u89D2\u6C38\u8FDC\u6446\u7740\u4E00\u675F\u65B0\u9C9C\u7684\u82B1\uFF0C\u636E\u8BF4\u662F\u5979\u6BCF\u5929\u65E9\u4E0A\u4ECE\u82B1\u5E02\u987A\u8DEF\u4E70\u7684\uFF0C\u8BF4\u662F\u5E97\u91CC\u8981\u6709\u82B1\u9999\u624D\u5B8C\u7F8E\u3002\u987E\u5BA2\u4EEC\u90FD\u8BF4\u5149\u662F\u5750\u5728\u91CC\u9762\u5FC3\u60C5\u5C31\u4F1A\u53D8\u597D\uFF0C\u54EA\u6015\u4E0D\u4E70\u4E1C\u897F\u4E5F\u60F3\u6765\u5750\u5750\u6B47\u6B47\u811A\u3002\n\n\u6027\u683C\u5F00\u6717\u7231\u7B11\uFF0C\u89C1\u8C01\u90FD\u751C\u751C\u5730\u6253\u62DB\u547C\uFF0C\u7B11\u5BB9\u80FD\u751C\u5230\u4EBA\u5FC3\u574E\u91CC\u53BB\u3002\u4F46\u79C1\u5E95\u4E0B\u5176\u5B9E\u662F\u4E2A\u6781\u5176\u7CBE\u660E\u7684\u751F\u610F\u4EBA\uFF0C\u4ECE\u6700\u521D\u4E00\u95F4\u5341\u5E73\u7C73\u7684\u5C0F\u94FA\u5B50\u53D1\u5C55\u5230\u73B0\u5728\u7684\u4E09\u5BB6\u5206\u5E97\uFF0C\u5168\u9760\u5979\u4E00\u70B9\u4E00\u70B9\u7CBE\u6253\u7EC6\u7B97\u6512\u51FA\u6765\u7684\u3002\u8FDB\u8D27\u6E20\u9053\u662F\u5979\u82B1\u4E86\u534A\u5E74\u65F6\u95F4\u4E00\u5BB6\u4E00\u5BB6\u8DD1\u4E0B\u6765\u7684\uFF0C\u7269\u6D41\u6210\u672C\u538B\u5F97\u6BD4\u540C\u884C\u4F4E\u4E86\u4E24\u6210\u3002\u5458\u5DE5\u4EEC\u79C1\u4E0B\u90FD\u8BF4\u8001\u677F\u5A18\u770B\u7740\u751C\u7F8E\u65E0\u5BB3\uFF0C\u505A\u8D77\u751F\u610F\u6765\u6BD4\u8C01\u90FD\u5389\u5BB3\u3002\n\n\u5979\u575A\u4FE1\u751C\u98DF\u80FD\u6CBB\u6108\u4E00\u5207\u4E0D\u5F00\u5FC3\uFF0C\u9047\u5230\u5FC3\u60C5\u4F4E\u843D\u7684\u987E\u5BA2\u603B\u4F1A\u6084\u6084\u591A\u9001\u4E00\u5757\u5C0F\u86CB\u7CD5\uFF0C\u6E29\u67D4\u5730\u8BF4\u5403\u4E86\u5C31\u4F1A\u597D\u8D77\u6765\u7684\u3002\u6709\u4E2A\u5E38\u5BA2\u6BCF\u6B21\u5931\u604B\u5C31\u6765\u627E\u5979\u54ED\u8BC9\uFF0C\u5979\u5C31\u966A\u7740\u804A\u5929\u5403\u751C\u54C1\u76F4\u5230\u5BF9\u65B9\u7834\u6D95\u4E3A\u7B11\u3002\u552F\u4E00\u7684\u70E6\u607C\u5C31\u662F\u81EA\u5DF1\u7684\u4F53\u91CD\uFF0C\u5634\u4E0A\u5929\u5929\u558A\u7740\u8981\u51CF\u80A5\uFF0C\u4F46\u6BCF\u6B21\u7814\u53D1\u65B0\u54C1\u65F6\u8EAB\u4F53\u5374\u8BDA\u5B9E\u5730\u628A\u6BCF\u6B3E\u90FD\u5C1D\u4E86\u4E2A\u904D\uFF0C\u8FD8\u632F\u632F\u6709\u8BCD\u5730\u8BF4\u8BD5\u5403\u662F\u8001\u677F\u7684\u672C\u804C\u5DE5\u4F5C\u3002"
