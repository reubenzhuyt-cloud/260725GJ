  displayName: "\u738B\u5927\u5988"
  avatarKey: elder_female_01
  portrait: {fileID: 21300000, guid: dfc80da1baedb214a80acdb584e05c50, type: 3}
  avatarColor: {r: 0.3, g: 0.4, b: 0.9, a: 1}
  ability: 0
  activityType: 0
  shortDescription: "\u738B\u5927\u5988\uFF0C\u4E94\u5341\u4E94\u5C81\uFF0C\u9000\u4F11\u5C0F\u5B66\u8BED\u6587\u6559\u5E08\uFF0C\u5728\u8FD9\u4E2A\u5C0F\u533A\u4F4F\u4E86\u5FEB\u4E8C\u5341\u5E74\u3002\u5C0F\u533A\u91CC\u516C\u8BA4\u7684\u4E07\u4E8B\u901A\uFF0C\u8C01\u5BB6\u5B69\u5B50\u4E0A\u5B66\u3001\u8C01\u5BB6\u8001\u4EBA\u770B\u75C5\u3001\u8C01\u5BB6\u592B\u59BB\u5435\u67B6\u62CC\u5634\u5979\u90FD\u95E8\u513F\u6E05\uFF0C\u6BD4\u5C45\u59D4\u4F1A\u4E3B\u4EFB\u8FD8\u4E86\u89E3\u60C5\u51B5\u3002\u6BCF\u5929\u508D\u665A\u516D\u70B9\u534A\u51C6\u65F6\u5728\u697C\u4E0B\u9886\u821E\u5E7F\u573A\u821E\uFF0C\u97F3\u54CD\u58F0\u97F3\u504F\u5927\uFF0C\u4F4E\u5C42\u4F4F\u6237\u82E6\u4E0D\u582A\u8A00\uFF0C\u6295\u8BC9\u4E0D\u65AD\u5979\u5374\u6211\u884C\u6211\u7D20\u3002\u4E3A\u4EBA\u70ED\u5FC3\u80A0\uFF0C\u4F46\u70ED\u5FC3\u8FC7\u5934\uFF0C\u9022\u4EBA\u5C31\u95EE\u6709\u6CA1\u6709\u5BF9\u8C61\uFF0C\u4E3B\u52A8\u5E2E\u90BB\u5C45\u5F20\u7F57\u4ECB\u7ECD\u76F8\u4EB2\uFF0C\u53E3\u5934\u7985\u662F\u6211\u8FD9\u90FD\u662F\u4E3A\u4F60\u597D\u3002\u55D3\u95E8\u867D\u7136\u4E0D\u5982\u8D75\u94C1\u67F1\u5927\uFF0C\u4F46\u80DC\u5728\u8BDD\u591A\u5634\u788E\uFF0C\u80FD\u62C9\u7740\u8DEF\u8FC7\u7684\u90BB\u5C45\u804A\u4E0A\u4E00\u4E2A\u5C0F\u65F6\u4E0D\u5E26\u91CD\u6837\u7684\u3002\u7A7F\u7740\u6253\u626E\u8BB2\u7A76\u4F53\u9762\uFF0C\u6C38\u8FDC\u70EB\u7740\u6574\u9F50\u7684\u5377\u53D1\uFF0C\u51FA\u95E8\u5FC5\u7A7F\u788E\u82B1\u8FDE\u8863\u88D9\u914D\u73CD\u73E0\u9879\u94FE\uFF0C\u6D3B\u8131\u8131\u4E00\u4E2A\u7CBE\u81F4\u7684\u8001\u592A\u592A\u3002"
  detailedDescription: "\u738B\u5927\u5988\uFF0C\u4E94\u5341\u4E94\u5C81\uFF0C\u9000\u4F11\u5C0F\u5B66\u8BED\u6587\u6559\u5E08\u3002\u5728\u8FD9\u4E2A\u5C0F\u533A\u4F4F\u4E86\u5FEB\u4E8C\u5341\u5E74\uFF0C\u582A\u79F0\u6574\u680B\u697C\u7684\u6D3B\u6863\u6848\u3002\u8C01\u5BB6\u51E0\u53E3\u4EBA\u3001\u5B69\u5B50\u5728\u54EA\u4E0A\u5B66\u3001\u8001\u4EBA\u8EAB\u4F53\u600E\u4E48\u6837\u3001\u592B\u59BB\u611F\u60C5\u597D\u4E0D\u597D\uFF0C\u5979\u90FD\u4E86\u5982\u6307\u638C\u3002\u9000\u4F11\u540E\u66F4\u662F\u628A\u5168\u90E8\u7CBE\u529B\u90FD\u6295\u5165\u5230\u4E86\u5173\u5FC3\u90BB\u5C45\u8FD9\u9879\u4F1F\u5927\u4E8B\u4E1A\u4E2D\uFF0C\u6BCF\u5929\u5728\u5C0F\u533A\u91CC\u6765\u56DE\u8F6C\u60A0\uFF0C\u89C1\u4EBA\u5C31\u62C9\u7740\u5618\u5BD2\u95EE\u6696\uFF0C\u70ED\u60C5\u5F97\u8BA9\u4EBA\u62DB\u67B6\u4E0D\u4F4F\u3002\n\n\u5E7F\u573A\u821E\u662F\u738B\u5927\u5988\u9000\u4F11\u540E\u6700\u5927\u7684\u7231\u597D\u548C\u9A84\u50B2\u3002\u6BCF\u5929\u508D\u665A\u516D\u70B9\u534A\uFF0C\u5979\u51C6\u65F6\u62CE\u7740\u4FBF\u643A\u97F3\u54CD\u51FA\u73B0\u5728\u697C\u4E0B\u7A7A\u5730\u4E0A\uFF0C\u5E26\u9886\u4E00\u5E2E\u963F\u59E8\u4EEC\u7FE9\u7FE9\u8D77\u821E\u3002\u97F3\u54CD\u58F0\u97F3\u5F00\u5F97\u504F\u5927\uFF0C\u4F4F\u5728\u4F4E\u5C42\u7684\u4F4F\u6237\u82E6\u4E0D\u582A\u8A00\uFF0C\u591A\u6B21\u6295\u8BC9\u5230\u7269\u4E1A\u3002\u7269\u4E1A\u6765\u534F\u8C03\u8FC7\u597D\u51E0\u56DE\uFF0C\u738B\u5927\u5988\u6BCF\u6B21\u90FD\u4E49\u6B63\u8A00\u8F9E\u5730\u8BF4\u953B\u70BC\u8EAB\u4F53\u662F\u8001\u5E74\u4EBA\u7684\u6743\u5229\uFF0C\u6700\u540E\u97F3\u54CD\u58F0\u97F3\u8C61\u5F81\u6027\u5730\u8C03\u5C0F\u4E86\u4E00\u70B9\uFF0C\u53EF\u8FC7\u4E0D\u4E86\u4E24\u5929\u5C31\u53C8\u6062\u590D\u539F\u6837\u4E86\u3002\u5979\u8DF3\u821E\u7684\u65F6\u5019\u7279\u522B\u6295\u5165\uFF0C\u52A8\u4F5C\u5938\u5F20\uFF0C\u8868\u60C5\u4E30\u5BCC\uFF0C\u4EFF\u4F5B\u5728\u821E\u53F0\u4E0A\u8868\u6F14\u4E00\u822C\u3002\n\n\u738B\u5927\u5988\u6700\u8BA9\u4EBA\u53C8\u7231\u53C8\u6068\u7684\u5C31\u662F\u5979\u90A3\u8FC7\u5206\u7684\u70ED\u5FC3\u80A0\u3002\u5979\u70ED\u8877\u4E8E\u7ED9\u4EBA\u505A\u5A92\uFF0C\u5C0F\u533A\u91CC\u9002\u9F84\u7684\u5355\u8EAB\u9752\u5E74\u51E0\u4E4E\u90FD\u88AB\u5979\u60E6\u8BB0\u8FC7\u3002\u4E0D\u7BA1\u5BF9\u65B9\u6709\u6CA1\u6709\u610F\u613F\uFF0C\u5979\u90FD\u4F1A\u60F3\u65B9\u8BBE\u6CD5\u5B89\u6392\u76F8\u4EB2\uFF0C\u53E3\u5934\u7985\u662F\u8FD9\u90FD\u662F\u4E3A\u4F60\u597D\u3002\u6709\u4E00\u56DE\u5979\u7ED9\u697C\u4E0A\u7684\u7A0B\u5E8F\u5458\u5C0F\u5218\u7CBE\u5FC3\u4ECB\u7ECD\u4E86\u4E00\u4E2A\u59D1\u5A18\uFF0C\u7ED3\u679C\u4E24\u4EBA\u4E0D\u5408\u9002\uFF0C\u5979\u53CD\u5012\u602A\u5C0F\u5218\u4E0D\u61C2\u73CD\u60DC\u3002\u9664\u4E86\u505A\u5A92\uFF0C\u5979\u8FD8\u559C\u6B22\u4E3B\u52A8\u4ECB\u5165\u90BB\u5C45\u5BB6\u7684\u5927\u5C0F\u4E8B\u52A1\uFF0C\u4ECE\u88C5\u4FEE\u9009\u6750\u5230\u5B69\u5B50\u62A5\u8865\u4E60\u73ED\uFF0C\u5979\u90FD\u8981\u53D1\u8868\u4E00\u756A\u610F\u89C1\u3002\n\n\u5728\u793E\u4EA4\u65B9\u9762\uFF0C\u738B\u5927\u5988\u7684\u6218\u6597\u529B\u582A\u79F0\u6050\u6016\u3002\u5979\u80FD\u5728\u5C0F\u533A\u95E8\u53E3\u62C9\u7740\u4EFB\u4F55\u4E00\u4E2A\u8DEF\u8FC7\u7684\u90BB\u5C45\u804A\u4E0A\u4E00\u4E2A\u5C0F\u65F6\uFF0C\u8BDD\u9898\u4ECE\u83DC\u4EF7\u6DA8\u8DCC\u804A\u5230\u56FD\u5BB6\u5927\u4E8B\uFF0C\u4E2D\u95F4\u8FD8\u80FD\u7A7F\u63D2\u4E09\u4E94\u4E2A\u90BB\u5C45\u5BB6\u7684\u516B\u5366\u3002\u5979\u7684\u4FE1\u606F\u7F51\u7EDC\u904D\u5E03\u6574\u4E2A\u5C0F\u533A\uFF0C\u697C\u4E0B\u8D85\u5E02\u7684\u8001\u677F\u5A18\u3001\u95E8\u53E3\u7684\u4FDD\u5B89\u5927\u53D4\u3001\u751A\u81F3\u9644\u8FD1\u7684\u83DC\u8D29\u5B50\u90FD\u662F\u5979\u7684\u7EBF\u4EBA\u3002\u6709\u4EBA\u8BF4\u5979\u6BD4\u5C45\u59D4\u4F1A\u738B\u4E3B\u4EFB\u8FD8\u4E86\u89E3\u8FD9\u4E2A\u5C0F\u533A\u65B9\u65B9\u9762\u9762\u7684\u60C5\u51B5\u3002\n\n\u5C3D\u7BA1\u70ED\u5FC3\u8FC7\u5934\u62DB\u4EBA\u70E6\uFF0C\u4F46\u738B\u5927\u5988\u672C\u6027\u5584\u826F\uFF0C\u51FA\u53D1\u70B9\u786E\u5B9E\u662F\u597D\u7684\u3002\u8C01\u5BB6\u771F\u9047\u4E0A\u56F0\u96BE\uFF0C\u5979\u8DD1\u5F97\u6BD4\u8C01\u90FD\u5FEB\uFF0C\u53C8\u9001\u996D\u53C8\u5E2E\u5FD9\u7167\u987E\u5B69\u5B50\u3002\u5C0F\u533A\u91CC\u72EC\u5C45\u7684\u8001\u4EBA\u5979\u9694\u4E09\u5DEE\u4E94\u5C31\u53BB\u63A2\u671B\uFF0C\u4E70\u83DC\u7684\u65F6\u5019\u987A\u624B\u5E2E\u4EBA\u634E\u4E00\u4EFD\u3002\u90BB\u5C45\u4EEC\u5634\u4E0A\u5ACC\u5979\u591A\u7BA1\u95F2\u4E8B\uFF0C\u5FC3\u91CC\u90FD\u77E5\u9053\u8FD9\u4E2A\u788E\u5634\u7684\u8001\u592A\u592A\u5176\u5B9E\u662F\u4E2A\u597D\u4EBA\u3002\u53EA\u662F\u90A3\u5E7F\u573A\u821E\u7684\u97F3\u54CD\u58F0\uFF0C\u5B9E\u5728\u662F\u8BA9\u4EBA\u5934\u75BC\u3002"
