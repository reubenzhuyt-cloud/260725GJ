  candidateId: tenant_sigma
  displayName: "\u5434\u7F8E\u4E3D"
  avatarKey: female_02
  portrait: {fileID: 21300000, guid: 51a1851899937494d88c64c6a8010377, type: 3}
  avatarColor: {r: 0.55, g: 0.55, b: 0.55, a: 1}
  ability: 6
  activityType: 0
  shortDescription: "\u5434\u7F8E\u4E3D\uFF0C\u4E09\u5341\u4E00\u5C81\uFF0C\u4E13\u4E1A\u7F8E\u5BB9\u5E08\u517C\u7F8E\u5BB9\u9662\u8001\u677F\u5A18\uFF0C\u6BCF\u5929\u51FA\u95E8\u524D\u81F3\u5C11\u5316\u5986\u4E00\u4E2A\u534A\u5C0F\u65F6\uFF0C\u4ECE\u4E0D\u7D20\u989C\u89C1\u4EBA\uFF0C\u8FDE\u4E0B\u697C\u5012\u5783\u573E\u90FD\u8981\u6D82\u53E3\u7EA2\u8865\u7C89\u5E95\u3002\u4E3A\u4EBA\u70ED\u60C5\u5954\u653E\u7231\u4EA4\u670B\u53CB\uFF0C\u603B\u60F3\u7ED9\u90BB\u5C45\u505A\u514D\u8D39\u7F8E\u5BB9\u62A4\u7406\uFF0C\u4F46\u5979\u7684\u7F8E\u5BB9\u4EA7\u54C1\u6C14\u5473\u592A\u91CD\uFF0C\u6574\u680B\u697C\u9053\u90FD\u662F\u85B0\u8863\u8349\u548C\u73AB\u7470\u7CBE\u6CB9\u6DF7\u5408\u7684\u5473\u9053\uFF0C\u6709\u90BB\u5C45\u8BF4\u95FB\u7740\u50CF\u6389\u8FDB\u4E86\u9999\u6C34\u7F38\u91CC\u3002\u5979\u8BF4\u7231\u7F8E\u662F\u5973\u4EBA\u7684\u5929\u6027\uFF0C\u4E5F\u662F\u5BF9\u751F\u6D3B\u54C1\u8D28\u7684\u8FFD\u6C42\uFF0C\u8C01\u8981\u662F\u8BF4\u5979\u6253\u626E\u592A\u5938\u5F20\uFF0C\u5979\u80FD\u62C9\u7740\u4EBA\u5BB6\u8BB2\u4E24\u4E2A\u5C0F\u65F6\u7684\u62A4\u80A4\u8BFE\u4E0D\u5E26\u91CD\u6837\u7684\u3002"
  detailedDescription: "\u5434\u7F8E\u4E3D\uFF0C\u4E09\u5341\u4E00\u5C81\uFF0C\u5728\u5546\u4E1A\u8857\u5F00\u4E86\u4E00\u5BB6\u5C0F\u578B\u7F8E\u5BB9\u9662\uFF0C\u751F\u610F\u8FD8\u7B97\u8FC7\u5F97\u53BB\u3002\u5979\u5BF9\u81EA\u5DF1\u7684\u5916\u8C8C\u8981\u6C42\u6781\u9AD8\uFF0C\u6BCF\u5929\u65E9\u4E0A\u516D\u70B9\u8D77\u5E8A\u5F00\u59CB\u62A4\u80A4\u5316\u5986\uFF0C\u5149\u662F\u5E95\u5986\u5C31\u8981\u6253\u4E09\u5C42\uFF0C\u773C\u5F71\u7684\u914D\u8272\u8981\u6839\u636E\u5F53\u5929\u7684\u8863\u88F3\u6765\u642D\u914D\uFF0C\u51FA\u95E8\u524D\u81F3\u5C11\u8981\u5728\u955C\u5B50\u524D\u7AD9\u4E00\u4E2A\u534A\u5C0F\u65F6\u3002\u5979\u8BF4\u8FD9\u662F\u5BF9\u804C\u4E1A\u7684\u5C0A\u91CD\uFF0C\u4E5F\u662F\u5BF9\u751F\u6D3B\u7684\u70ED\u7231\u3002\n\n\u5979\u662F\u90A3\u79CD\u89C1\u8C01\u90FD\u81EA\u6765\u719F\u7684\u70ED\u5FC3\u4EBA\u3002\u642C\u8FDB\u5C0F\u533A\u7B2C\u4E00\u5929\uFF0C\u5979\u5C31\u7AEF\u7740\u4E00\u76D8\u81EA\u5236\u9762\u819C\u53BB\u6572\u90BB\u5C45\u7684\u95E8\uFF0C\u8BF4\u662F\u8981\u8DDF\u5927\u5BB6\u6253\u597D\u5173\u7CFB\u3002\u4ECE\u90A3\u4EE5\u540E\uFF0C\u5979\u9694\u4E09\u5DEE\u4E94\u5C31\u7ED9\u697C\u91CC\u7684\u5973\u90BB\u5C45\u9001\u8BD5\u7528\u88C5\uFF0C\u4EC0\u4E48\u7CBE\u534E\u6DB2\u3001\u9762\u971C\u3001\u773C\u819C\uFF0C\u54C1\u79CD\u7E41\u591A\u3002\u95EE\u9898\u662F\u5979\u7684\u4EA7\u54C1\u5927\u591A\u662F\u7F8E\u5BB9\u9662\u7684\u9AD8\u7AEF\u7EBF\uFF0C\u6C14\u5473\u7279\u522B\u6D53\u90C1\uFF0C\u6574\u5C42\u697C\u9053\u90FD\u5F25\u6F2B\u7740\u4E00\u80A1\u85B0\u8863\u8349\u548C\u73AB\u7470\u7CBE\u6CB9\u6DF7\u5408\u7684\u6D53\u9999\u3002\u6709\u90BB\u5C45\u59D4\u5A49\u5730\u63D0\u8FC7\u610F\u89C1\uFF0C\u5979\u5634\u4E0A\u7B54\u5E94\u5F97\u597D\u597D\u7684\uFF0C\u4E0B\u6B21\u7167\u6837\u9001\uFF0C\u53EA\u662F\u6362\u4E86\u4E2A\u5473\u9053\u3002\n\n\u5434\u7F8E\u4E3D\u8BF4\u8BDD\u55D3\u95E8\u4E0D\u5C0F\uFF0C\u7B11\u8D77\u6765\u66F4\u662F\u54CD\u4EAE\uFF0C\u9694\u7740\u4E24\u5C42\u697C\u90FD\u80FD\u542C\u89C1\u3002\u5979\u7279\u522B\u559C\u6B22\u8DDF\u4EBA\u5206\u4EAB\u81EA\u5DF1\u7684\u62A4\u80A4\u5FC3\u5F97\uFF0C\u4E00\u5F00\u53E3\u5C31\u505C\u4E0D\u4E0B\u6765\uFF0C\u4ECE\u73BB\u5C3F\u9178\u8BB2\u5230\u70DF\u9170\u80FA\uFF0C\u4ECE\u65E9C\u665AA\u8BB2\u5230\u4EE5\u6CB9\u517B\u80A4\uFF0C\u4E13\u4E1A\u672F\u8BED\u4E00\u5957\u4E00\u5957\u7684\u3002\u90BB\u5C45\u738B\u5927\u59D0\u6709\u4E00\u6B21\u968F\u53E3\u8BF4\u4E86\u53E5\"\u76AE\u80A4\u5E72\"\uFF0C\u7ED3\u679C\u88AB\u5979\u62C9\u4F4F\u8BB2\u4E86\u6574\u6574\u4E24\u4E2A\u5C0F\u65F6\u7684\u62A4\u80A4\u6D41\u7A0B\uFF0C\u6700\u540E\u62CE\u7740\u4E00\u5927\u888B\u4EA7\u54C1\u56DE\u5BB6\uFF0C\u82B1\u4E86\u534A\u4E2A\u6708\u7684\u83DC\u94B1\u3002\n\n\u867D\u7136\u6709\u65F6\u5019\u70ED\u60C5\u5F97\u8BA9\u4EBA\u62DB\u67B6\u4E0D\u4F4F\uFF0C\u4F46\u5434\u7F8E\u4E3D\u5FC3\u773C\u4E0D\u574F\u3002\u5C0F\u533A\u91CC\u8C01\u5BB6\u6709\u7EA2\u767D\u559C\u4E8B\uFF0C\u5979\u603B\u662F\u7B2C\u4E00\u4E2A\u5230\u573A\u5E2E\u5FD9\uFF0C\u8FD8\u4F1A\u514D\u8D39\u5E2E\u65B0\u5A18\u5316\u5986\uFF0C\u624B\u827A\u786E\u5B9E\u4E0D\u9519\u3002\u5979\u8BF4\u8FD9\u4E2A\u884C\u4E1A\u6700\u5927\u7684\u6210\u5C31\u611F\uFF0C\u5C31\u662F\u770B\u5230\u5BA2\u4EBA\u7167\u955C\u5B50\u65F6\u9732\u51FA\u6EE1\u610F\u7684\u7B11\u5BB9\u3002\n\n\u5979\u6709\u4E2A\u6539\u4E0D\u6389\u7684\u4E60\u60EF\uFF0C\u5C31\u662F\u8D70\u5230\u54EA\u90FD\u8981\u638F\u51FA\u5C0F\u955C\u5B50\u7167\u4E00\u7167\uFF0C\u8865\u4E2A\u5986\u3002\u54EA\u6015\u53EA\u662F\u4E0B\u697C\u5012\u4E2A\u5783\u573E\uFF0C\u5979\u4E5F\u8981\u6D82\u597D\u53E3\u7EA2\u3001\u6574\u7406\u597D\u53D1\u578B\u624D\u80AF\u51FA\u95E8\u3002\u90BB\u5C45\u4EEC\u79C1\u5E95\u4E0B\u5F00\u73A9\u7B11\u8BF4\uFF0C\u5434\u7F8E\u4E3D\u5012\u5783\u573E\u90FD\u50CF\u53BB\u8D70\u7EA2\u6BEF\u3002\u5979\u542C\u4E86\u4E5F\u4E0D\u607C\uFF0C\u53CD\u800C\u5F97\u610F\u5730\u8BF4\uFF1A\"\u751F\u6D3B\u9700\u8981\u4EEA\u5F0F\u611F\u561B\u3002\"\u6709\u4E00\u6B21\u5C0F\u533A\u505C\u7535\uFF0C\u5979\u6253\u7740\u624B\u673A\u7684\u624B\u7535\u7B52\u4E5F\u8981\u5BF9\u7740\u5C4F\u5E55\u5316\u5B8C\u5986\u624D\u51FA\u95E8\uFF0C\u90BB\u5C45\u4EEC\u90FD\u670D\u4E86\u5979\u8FD9\u4EFD\u5BF9\u7F8E\u7684\u6267\u7740\u3002\u5979\u5E38\u8BF4\u7684\u4E00\u53E5\u8BDD\u5C31\u662F\uFF1A\"\u5973\u4EBA\u7684\u8138\u5C31\u662F\u81EA\u5DF1\u7684\u540D\u7247\uFF0C\u4EFB\u4F55\u65F6\u5019\u90FD\u4E0D\u80FD\u9A6C\u864E\u5BF9\u5F85\u3002\""
