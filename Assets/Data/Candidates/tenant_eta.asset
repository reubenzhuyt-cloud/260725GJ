  candidateId: tenant_eta
  portrait: {fileID: 0}
  ability: 4
  activityType: 0
  displayName: "\u5F20\u5C0F\u9F99"
  avatarColor: {r: 0.95, g: 0.55, b: 0.25, a: 1}
  shortDescription: "\u5f20\u5c0f\u9f99\uff0c\u4e8c\u5341\u516b\u5c81\uff0c\u5065\u8eab\u623f\u79c1\u6559\uff0c\u8eab\u578b\u5065\u7855\u808c\u8089\u7ebf\u6761\u5206\u660e\uff0c\u8d70\u5728\u8def\u4e0a\u56de\u5934\u7387\u6781\u9ad8\u3002\u6bcf\u5929\u51cc\u6668\u4e94\u70b9\u8d77\u5e8a\u8dd1\u6b65\u96f7\u6253\u4e0d\u52a8\uff0c\u51b0\u7bb1\u91cc\u585e\u6ee1\u4e86\u9e21\u80f8\u8089\u548c\u897f\u5170\u82b1\uff0c\u4ece\u4e0d\u5403\u96f6\u98df\u548c\u5783\u573e\u98df\u54c1\u3002\u4e3a\u4eba\u70ed\u60c5\u5f00\u6717\uff0c\u603b\u60f3\u62c9\u7740\u90bb\u5c45\u4e00\u8d77\u5065\u8eab\u8fd0\u52a8\uff0c\u5c0f\u533a\u91cc\u5df2\u7ecf\u88ab\u4ed6\u6210\u529f\u5e26\u52a8\u4e86\u597d\u51e0\u6279\u4eba\u6668\u8dd1\u953b\u70bc\u3002\u66fe\u5728\u697c\u9053\u91cc\u505a\u5f15\u4f53\u5411\u4e0a\u628a\u6d88\u9632\u7ba1\u62c9\u65ad\u4e86\uff0c\u8d54\u4e86\u4e0d\u5c11\u94b1\uff0c\u4ece\u6b64\u88ab\u7269\u4e1a\u91cd\u70b9\u76ef\u9632\u3002"
  detailedDescription: "\u5f20\u5c0f\u9f99\uff0c\u4e8c\u5341\u516b\u5c81\uff0c\u5065\u8eab\u623f\u79c1\u4eba\u6559\u7ec3\u3002\u8eab\u578b\u5065\u7855\u808c\u8089\u7ebf\u6761\u5206\u660e\uff0c\u8d70\u5728\u8def\u4e0a\u56de\u5934\u7387\u6781\u9ad8\uff0c\u5c0f\u533a\u91cc\u7684\u5927\u5988\u4eec\u79c1\u5e95\u4e0b\u90fd\u53eb\u4ed6\u808c\u8089\u5c0f\u5e05\u54e5\u3002\u6bcf\u5929\u51cc\u6668\u4e94\u70b9\u8d77\u5e8a\u8dd1\u6b65\uff0c\u96f7\u6253\u4e0d\u52a8\uff0c\u4e0d\u7ba1\u522e\u98ce\u4e0b\u96e8\u4ece\u4e0d\u95f4\u65ad\uff0c\u8dd1\u5b8c\u5341\u516c\u91cc\u8fd8\u8981\u5728\u5c0f\u533a\u82b1\u56ed\u505a\u4e00\u767e\u4e2a\u4fef\u5367\u6491\u624d\u5fc3\u6ee1\u610f\u8db3\u5730\u56de\u5bb6\u3002\u51b0\u7bb1\u91cc\u585e\u6ee1\u4e86\u9e21\u80f8\u8089\u548c\u897f\u5170\u82b1\uff0c\u96f6\u98df\u548c\u5783\u573e\u98df\u54c1\u4e00\u6982\u4e0d\u78b0\uff0c\u8fde\u8fc7\u5e74\u805a\u9910\u90fd\u53ea\u5403\u6c34\u716e\u83dc\u548c\u7626\u8089\uff0c\u670b\u53cb\u4eec\u90fd\u89c9\u5f97\u4ed6\u6d3b\u5f97\u50cf\u4e2a\u82e6\u884c\u50e7\u3002\n\n\u4e3a\u4eba\u70ed\u60c5\u5f00\u6717\uff0c\u89c1\u5230\u8c01\u90fd\u7b11\u563b\u563b\u7684\uff0c\u603b\u60f3\u62c9\u7740\u90bb\u5c45\u4e00\u8d77\u5065\u8eab\u3002\u5728\u4ed6\u575a\u6301\u4e0d\u61c8\u7684\u5b89\u5229\u4e0b\uff0c\u5c0f\u533a\u91cc\u5df2\u7ecf\u6709\u597d\u51e0\u6279\u5927\u7237\u5927\u5988\u52a0\u5165\u4e86\u6668\u8dd1\u961f\u4f0d\uff0c\u6bcf\u5929\u65e9\u4e0a\u4e94\u70b9\u534a\u51c6\u65f6\u5728\u4ed6\u5e26\u9886\u4e0b\u7ed5\u7740\u5c0f\u533a\u8dd1\u5708\u3002\u4ed6\u8fd8\u81ea\u638f\u8170\u5305\u4e70\u4e86\u4e24\u526f\u54d1\u94c3\u548c\u4e00\u5f20\u745c\u4f3d\u57ab\u653e\u5728\u82b1\u56ed\u51c9\u4ead\u91cc\uff0c\u8bf4\u662f\u4f9b\u5927\u5bb6\u514d\u8d39\u4f7f\u7528\u3002\u8c01\u5bb6\u8981\u662f\u4e70\u4e86\u5065\u8eab\u5668\u6750\u4e0d\u4f1a\u7528\uff0c\u4e00\u4e2a\u7535\u8bdd\u4ed6\u5c31\u8e6c\u8e6c\u8e6c\u8dd1\u4e0a\u697c\u5e2e\u5fd9\u5b89\u88c5\u8c03\u8bd5\u3002\n\n\u66fe\u5728\u697c\u9053\u91cc\u505a\u5f15\u4f53\u5411\u4e0a\uff0c\u628a\u6d88\u9632\u7ba1\u9053\u7684\u652f\u67b6\u7ed9\u62c9\u65ad\u4e86\uff0c\u6c34\u7ba1\u5dee\u70b9\u7206\u88c2\uff0c\u8d54\u4e86\u4e0d\u5c11\u94b1\u3002\u7269\u4e1a\u4ece\u6b64\u770b\u5230\u4ed6\u5c31\u5934\u75bc\uff0c\u5f00\u4f1a\u65f6\u4e13\u95e8\u63d0\u4e86\u4ed6\u597d\u51e0\u6b21\u3002\u4ed6\u81ea\u5df1\u4e5f\u89c9\u5f97\u4e0d\u597d\u610f\u601d\uff0c\u4ece\u90a3\u4ee5\u540e\u6539\u5728\u5c0f\u533a\u82b1\u56ed\u953b\u70bc\uff0c\u518d\u4e5f\u4e0d\u6562\u5728\u697c\u9053\u91cc\u641e\u5927\u52a8\u4f5c\u4e86\u3002\u4e0d\u8fc7\u4ed6\u7ecf\u5e38\u5728\u670b\u53cb\u5708\u53d1\u5065\u8eab\u89c6\u9891\u548c\u98df\u8c31\uff0c\u914d\u6587\u6c38\u8fdc\u662f\u90a3\u53e5\u81ea\u5f8b\u7ed9\u6211\u81ea\u7531\uff0c\u5df2\u7ecf\u88ab\u670b\u53cb\u4eec\u9ed8\u9ed8\u5c4f\u853d\u4e86\u65e0\u6570\u6b21\u3002\n\n\u8bf4\u8bdd\u4e09\u53e5\u4e0d\u79bb\u5065\u8eab\u548c\u86cb\u767d\u8d28\uff0c\u52a8\u4e0d\u52a8\u5c31\u7ed9\u4eba\u5236\u5b9a\u8bad\u7ec3\u8ba1\u5212\u548c\u996e\u98df\u65b9\u6848\u3002\u53bb\u83dc\u5e02\u573a\u4e70\u83dc\u90fd\u8981\u8ddf\u644a\u4e3b\u8ba8\u8bba\u54ea\u79cd\u852c\u83dc\u8425\u517b\u4ef7\u503c\u6700\u9ad8\uff0c\u641e\u5f97\u5356\u83dc\u5927\u59d0\u770b\u89c1\u4ed6\u5c31\u7ed5\u9053\u8d70\u3002\u5c0f\u533a\u91cc\u6709\u4e2a\u4e0a\u73ed\u65cf\u5c0f\u738b\uff0c\u539f\u6765\u4e00\u767e\u516b\u5341\u65a4\uff0c\u5728\u4ed6\u7684\u9b54\u9b3c\u8bad\u7ec3\u4e0b\u786c\u662f\u51cf\u5230\u4e86\u4e00\u767e\u56db\u5341\u65a4\uff0c\u4ece\u6b64\u6210\u4e86\u4ed6\u7684\u94c1\u6746\u7c89\u4e1d\uff0c\u9022\u4eba\u5c31\u8bf4\u5f20\u6559\u7ec3\u6539\u53d8\u4e86\u4ed6\u7684\u4eba\u751f\u3002\n\n\u867d\u7136\u770b\u8d77\u6765\u5927\u5927\u54a7\u54a7\uff0c\u4f46\u5176\u5b9e\u5fc3\u5f88\u7ec6\u3002\u8c01\u5bb6\u8001\u4eba\u8170\u9178\u80cc\u75db\uff0c\u4ed6\u90fd\u4f1a\u4e3b\u52a8\u4e0a\u95e8\u6559\u51e0\u4e2a\u7b80\u5355\u7684\u62c9\u4f38\u52a8\u4f5c\uff0c\u4ece\u4e0d\u6536\u4e00\u5206\u94b1\u3002\u53bb\u5e74\u51ac\u5929\u9694\u58c1\u697c\u7684\u8d75\u5927\u7237\u6454\u4e86\u4e00\u8de4\u9aa8\u6298\u4e86\uff0c\u4ed6\u81ea\u8d39\u4e70\u4e86\u4e00\u5957\u5eb7\u590d\u5668\u6750\u9001\u4e0a\u95e8\uff0c\u6bcf\u5929\u4e0b\u73ed\u540e\u51c6\u65f6\u53bb\u5e2e\u5fd9\u505a\u590d\u5065\uff0c\u575a\u6301\u4e86\u6574\u6574\u4e09\u4e2a\u6708\u3002\u4ed6\u8bf4\u5f53\u6559\u7ec3\u4e0d\u53ea\u662f\u6559\u4eba\u7ec3\u808c\u8089\uff0c\u80fd\u5e2e\u52a9\u522b\u4eba\u62e5\u6709\u5065\u5eb7\u7684\u8eab\u4f53\u624d\u662f\u6700\u5927\u7684\u6210\u5c31\u611f\u3002"
