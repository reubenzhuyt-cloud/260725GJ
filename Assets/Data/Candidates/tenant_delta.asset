  candidateId: tenant_delta
  displayName: "\u9648\u6D69\u7136"
  avatarKey: male_01
  portrait: {fileID: 21300000, guid: 3b4b70afdef3af04dbaf03fefe3460fe, type: 3}
  avatarColor: {r: 0.95, g: 0.75, b: 0.2, a: 1}
  ability: 5
  activityType: 0
  shortDescription: "\u9648\u6D69\u7136\uFF0C\u4E09\u5341\u5C81\uFF0C\u5916\u5356\u9A91\u624B\uFF0C\u6765\u81EA\u6CB3\u5357\u519C\u6751\u7684\u4E00\u4E2A\u5C0F\u53BF\u57CE\u3002\u6BCF\u5929\u65E9\u51FA\u665A\u5F52\uFF0C\u98CE\u96E8\u65E0\u963B\uFF0C\u9A91\u7740\u7535\u52A8\u8F66\u7A7F\u68AD\u5728\u57CE\u5E02\u7684\u5927\u8857\u5C0F\u5DF7\u3002\u4E3A\u4EBA\u8001\u5B9E\u672C\u5206\uFF0C\u4ECE\u4E0D\u62D6\u6B20\u623F\u79DF\uFF0C\u6BCF\u4E2A\u6708\u4E00\u53F7\u51C6\u65F6\u8F6C\u8D26\uFF0C\u6C34\u7535\u8D39\u4E5F\u4ECE\u6765\u4E0D\u8D56\u8D26\u3002\u623F\u95F4\u91CC\u5806\u6EE1\u4E86\u5404\u79CD\u5916\u5356\u4FDD\u6E29\u7BB1\uFF0C\u5927\u5927\u5C0F\u5C0F\u4E94\u516D\u4E2A\uFF0C\u8BF4\u662F\u516C\u53F8\u5907\u7528\u7684\uFF0C\u5B9E\u9645\u4E0A\u5DF2\u7ECF\u5360\u4E86\u534A\u4E2A\u5BA2\u5385\u3002\u5076\u5C14\u6DF1\u66F4\u534A\u591C\u56DE\u6765\uFF0C\u697C\u9053\u91CC\u78B0\u5012\u81EA\u884C\u8F66\uFF0C\u52A8\u9759\u5927\u5F97\u50CF\u5C0F\u578B\u5730\u9707\uFF0C\u60F9\u5F97\u697C\u4E0B\u4F4F\u6237\u76F4\u9A82\u3002\u624B\u673A\u91CC\u88C5\u4E86\u597D\u51E0\u4E2A\u63A5\u5355\u8F6F\u4EF6\uFF0C\u5403\u996D\u6C38\u8FDC\u5728\u8D76\u65F6\u95F4\uFF0C\u72FC\u541E\u864E\u54BD\u4E94\u5206\u949F\u89E3\u51B3\u4E00\u987F\u996D\u3002\u76AE\u80A4\u6652\u5F97\u9EDD\u9ED1\uFF0C\u624B\u4E0A\u5168\u662F\u88AB\u5BD2\u98CE\u5439\u88C2\u7684\u53E3\u5B50\uFF0C\u4F46\u4ECE\u4E0D\u53EB\u82E6\u53EB\u7D2F\u3002"
  detailedDescription: "\u9648\u6D69\u7136\uFF0C\u4E09\u5341\u5C81\uFF0C\u6765\u81EA\u6CB3\u5357\u519C\u6751\u7684\u5916\u5356\u9A91\u624B\u3002\u9AD8\u4E2D\u6BD5\u4E1A\u540E\u5728\u5DE5\u5382\u6253\u8FC7\u51E0\u5E74\u5DE5\uFF0C\u540E\u6765\u89C9\u5F97\u9001\u5916\u5356\u81EA\u7531\u4E9B\uFF0C\u5C31\u6765\u5230\u8FD9\u5EA7\u57CE\u5E02\u5F53\u4E86\u9A91\u624B\u3002\u4ED6\u79DF\u7684\u662F\u5C0F\u533A\u91CC\u6700\u5C0F\u7684\u4E00\u5C45\u5BA4\uFF0C\u6708\u79DF\u4E00\u5343\u4E8C\uFF0C\u5BF9\u4ED6\u6765\u8BF4\u5DF2\u7ECF\u7B97\u662F\u4E0D\u9519\u7684\u6761\u4EF6\u4E86\u3002\u6BCF\u5929\u65E9\u4E0A\u4E03\u70B9\u51FA\u95E8\uFF0C\u665A\u4E0A\u5341\u70B9\u4EE5\u540E\u624D\u56DE\u6765\uFF0C\u9AD8\u5CF0\u671F\u7ECF\u5E38\u5FD9\u5230\u51CC\u6668\uFF0C\u4E00\u5468\u4E03\u5929\u51E0\u4E4E\u4E0D\u4F11\u606F\u3002\n\n\u9001\u5916\u5356\u8FD9\u884C\u770B\u7740\u7B80\u5355\uFF0C\u5B9E\u9645\u4E0A\u8F9B\u82E6\u5F97\u5F88\u3002\u9648\u6D69\u7136\u6BCF\u5929\u8981\u5728\u5916\u9762\u8DD1\u5341\u51E0\u4E2A\u5C0F\u65F6\uFF0C\u9A91\u7740\u7535\u52A8\u8F66\u5728\u8F66\u6D41\u91CC\u7A7F\u68AD\uFF0C\u98CE\u5439\u65E5\u6652\u96E8\u6DCB\u662F\u5BB6\u5E38\u4FBF\u996D\u3002\u590F\u5929\u5730\u8868\u6E29\u5EA6\u56DB\u4E94\u5341\u5EA6\uFF0C\u51AC\u5929\u96F6\u4E0B\u5341\u51E0\u5EA6\u7167\u6837\u51FA\u5355\u3002\u4ED6\u624B\u673A\u91CC\u88C5\u4E86\u4E09\u56DB\u4E2A\u63A5\u5355\u8F6F\u4EF6\uFF0C\u540C\u65F6\u62A2\u5355\uFF0C\u4E00\u523B\u4E5F\u4E0D\u6562\u505C\u3002\u5E73\u53F0\u7684\u7B97\u6CD5\u8D8A\u6765\u8D8A\u82DB\u523B\uFF0C\u8D85\u65F6\u5C31\u8981\u6263\u94B1\uFF0C\u5DEE\u8BC4\u66F4\u662F\u8981\u547D\uFF0C\u4ED6\u53EA\u80FD\u62FC\u547D\u8D76\u65F6\u95F4\u3002\u6709\u4E00\u6B21\u4E3A\u4E86\u4E0D\u8D85\u65F6\u95EF\u4E86\u7EA2\u706F\uFF0C\u5DEE\u70B9\u88AB\u8F66\u649E\u5230\uFF0C\u73B0\u5728\u60F3\u8D77\u6765\u8FD8\u540E\u6015\u3002\n\n\u9648\u6D69\u7136\u4E3A\u4EBA\u8001\u5B9E\u672C\u5206\uFF0C\u8FD9\u662F\u623F\u4E1C\u548C\u90BB\u5C45\u4EEC\u516C\u8BA4\u7684\u4F18\u70B9\u3002\u6BCF\u4E2A\u6708\u623F\u79DF\u96F7\u6253\u4E0D\u52A8\u51C6\u65F6\u8F6C\u8D26\uFF0C\u4ECE\u4E0D\u62D6\u6B20\u4E00\u5929\u3002\u6C34\u7535\u8D39\u4E5F\u4ECE\u6765\u4E0D\u8D56\uFF0C\u7528\u591A\u5C11\u4EA4\u591A\u5C11\u3002\u4ED6\u5728\u697C\u9053\u91CC\u78B0\u89C1\u4EBA\u603B\u662F\u5BA2\u5BA2\u6C14\u6C14\u5730\u6253\u62DB\u547C\uFF0C\u867D\u7136\u8BDD\u4E0D\u591A\uFF0C\u4F46\u7B11\u5BB9\u771F\u8BDA\u3002\u552F\u4E00\u7684\u6BDB\u75C5\u5C31\u662F\u623F\u95F4\u91CC\u7684\u4FDD\u6E29\u7BB1\u592A\u591A\u4E86\uFF0C\u5927\u5927\u5C0F\u5C0F\u4E94\u516D\u4E2A\uFF0C\u8BF4\u662F\u516C\u53F8\u53D1\u7684\u5907\u7528\uFF0C\u5B9E\u9645\u4E0A\u5DF2\u7ECF\u5806\u4E86\u534A\u4E2A\u5BA2\u5385\uFF0C\u623F\u4E1C\u6765\u770B\u8FC7\u4E00\u6B21\uFF0C\u6447\u6447\u5934\u4E5F\u6CA1\u8BF4\u4EC0\u4E48\u3002\n\n\u56E0\u4E3A\u5DE5\u4F5C\u65F6\u95F4\u4E0D\u56FA\u5B9A\uFF0C\u9648\u6D69\u7136\u7684\u751F\u6D3B\u4F5C\u606F\u548C\u6B63\u5E38\u4EBA\u4E0D\u592A\u4E00\u6837\u3002\u7ECF\u5E38\u6DF1\u66F4\u534A\u591C\u624D\u56DE\u6765\uFF0C\u697C\u9053\u91CC\u9ED1\u706F\u778E\u706B\u7684\uFF0C\u4ED6\u9A91\u56DE\u6765\u7684\u7535\u52A8\u8F66\u5076\u5C14\u4F1A\u78B0\u5012\u505C\u5728\u697C\u9053\u91CC\u7684\u81EA\u884C\u8F66\uFF0C\u52A8\u9759\u5927\u5F97\u50CF\u53D1\u751F\u4E86\u5C0F\u578B\u5730\u9707\uFF0C\u60F9\u5F97\u697C\u4E0B\u4F4F\u6237\u76F4\u9A82\u5A18\u3002\u4ED6\u6BCF\u6B21\u90FD\u5F88\u62B1\u6B49\u5730\u9053\u6B49\uFF0C\u7B2C\u4E8C\u5929\u53C8\u56E0\u4E3A\u592A\u665A\u56DE\u6765\u5FD8\u8BB0\u628A\u8F66\u632A\u5F00\u3002\u5403\u996D\u66F4\u662F\u4E00\u584C\u7CCA\u6D82\uFF0C\u4ECE\u6765\u6CA1\u6709\u6B63\u7ECF\u5750\u4E0B\u6765\u597D\u597D\u5403\u8FC7\u4E00\u987F\u996D\uFF0C\u6C38\u8FDC\u662F\u5728\u7B49\u5355\u7684\u95F4\u9699\u72FC\u541E\u864E\u54BD\uFF0C\u4E94\u5206\u949F\u89E3\u51B3\u6218\u6597\u3002\n\n\u9648\u6D69\u7136\u7684\u5916\u8868\u4E00\u770B\u5C31\u662F\u5E38\u5E74\u5728\u5916\u5954\u6CE2\u7684\u4EBA\u3002\u76AE\u80A4\u6652\u5F97\u9EDD\u9ED1\u53D1\u4EAE\uFF0C\u8138\u4E0A\u6709\u660E\u663E\u7684\u53E3\u7F69\u5370\u5B50\uFF0C\u624B\u4E0A\u5168\u662F\u88AB\u5BD2\u98CE\u5439\u88C2\u7684\u53E3\u5B50\uFF0C\u51AC\u5929\u7684\u65F6\u5019\u88C2\u5F97\u66F4\u6DF1\uFF0C\u78B0\u6C34\u5C31\u75BC\u3002\u4ED6\u4ECE\u4E0D\u5728\u4EBA\u524D\u63D0\u8FD9\u4E9B\u82E6\uFF0C\u5076\u5C14\u8DDF\u5BB6\u91CC\u6253\u7535\u8BDD\u4E5F\u662F\u62A5\u559C\u4E0D\u62A5\u5FE7\u3002\u4ED6\u5FC3\u91CC\u6709\u4E2A\u76EE\u6807\uFF0C\u60F3\u6512\u591F\u94B1\u56DE\u8001\u5BB6\u76D6\u623F\u5B50\u5A36\u5AB3\u5987\uFF0C\u6240\u4EE5\u518D\u82E6\u518D\u7D2F\u4E5F\u54AC\u7259\u6491\u7740\u3002\u8FD9\u4E2A\u6C89\u9ED8\u5BE1\u8A00\u7684\u5E74\u8F7B\u4EBA\uFF0C\u5C31\u50CF\u57CE\u5E02\u91CC\u5343\u5343\u4E07\u4E07\u7684\u5916\u5356\u9A91\u624B\u4E00\u6837\uFF0C\u7528\u6C57\u6C34\u548C\u65F6\u95F4\u6362\u7740\u5FAE\u8584\u7684\u5E0C\u671B\u3002"
