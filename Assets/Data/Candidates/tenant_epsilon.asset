  candidateId: tenant_epsilon
  displayName: "\u82CF\u5A49\u513F"
  avatarKey: female_02
  portrait: {fileID: 21300000, guid: 51a1851899937494d88c64c6a8010377, type: 3}
  avatarColor: {r: 0.8, g: 0.3, b: 0.8, a: 1}
  ability: 6
  activityType: 1
  shortDescription: "\u82CF\u5A49\u513F\uFF0C\u4E8C\u5341\u56DB\u5C81\uFF0C\u7F51\u7EDC\u76F4\u64AD\u4E3B\u64AD\uFF0C\u4E3B\u8981\u5728\u67D0\u77ED\u89C6\u9891\u5E73\u53F0\u505A\u5A31\u4E50\u76F4\u64AD\u3002\u76F4\u64AD\u65F6\u6D3B\u529B\u56DB\u5C04\uFF0C\u7B11\u5BB9\u751C\u7F8E\u8FF7\u4EBA\uFF0C\u58F0\u97F3\u55F2\u55F2\u7684\u7279\u522B\u597D\u542C\uFF0C\u7C89\u4E1D\u4EEC\u90FD\u4EB2\u5207\u5730\u53EB\u5979\u5A49\u513F\u5B9D\u8D1D\u3002\u955C\u5934\u4E00\u5173\u5224\u82E5\u4E24\u4EBA\uFF0C\u5B89\u9759\u5F97\u50CF\u53EA\u732B\uFF0C\u8138\u4E0A\u6CA1\u4EC0\u4E48\u8868\u60C5\uFF0C\u4F4E\u5934\u5237\u624B\u673A\u4E00\u8A00\u4E0D\u53D1\u3002\u7ECF\u5E38\u534A\u591C\u76F4\u64AD\u65F6\u7A81\u7136\u6FC0\u52A8\u5927\u558A\uFF0C\u90BB\u5C45\u62A5\u8B66\u4EE5\u4E3A\u53D1\u751F\u4E86\u5211\u4E8B\u6848\u4EF6\u3002\u623F\u95F4\u91CC\u5806\u6EE1\u4E86\u5316\u5986\u54C1\u548C\u5404\u79CD\u6253\u5149\u8BBE\u5907\uFF0C\u8865\u5149\u706F\u534A\u591C\u8FD8\u4EAE\u7740\uFF0C\u900F\u8FC7\u95E8\u7F1D\u5C04\u51FA\u6765\u683C\u5916\u8BE1\u5F02\u3002\u7A7F\u7740\u6253\u626E\u7CBE\u81F4\u65F6\u5C1A\uFF0C\u5986\u5BB9\u6C38\u8FDC\u4E00\u4E1D\u4E0D\u82DF\uFF0C\u4F46\u79C1\u4E0B\u91CC\u5176\u5B9E\u908B\u9062\u5F97\u5F88\uFF0C\u5916\u5356\u76D2\u5B50\u5806\u4E86\u4E00\u684C\u5B50\u4ECE\u6765\u4E0D\u6536\u62FE\u3002"
  detailedDescription: "\u82CF\u5A49\u513F\uFF0C\u4E8C\u5341\u56DB\u5C81\uFF0C\u7F51\u7EDC\u76F4\u64AD\u4E3B\u64AD\uFF0C\u4E3B\u8981\u5728\u67D0\u77ED\u89C6\u9891\u5E73\u53F0\u505A\u5A31\u4E50\u76F4\u64AD\u3002\u5979\u957F\u7740\u4E00\u5F20\u6807\u51C6\u7684\u751C\u7F8E\u5A03\u5A03\u8138\uFF0C\u7B11\u8D77\u6765\u6709\u4E24\u4E2A\u5C0F\u9152\u7A9D\uFF0C\u8BF4\u8BDD\u58F0\u97F3\u55F2\u55F2\u7684\uFF0C\u76F4\u64AD\u95F4\u91CC\u7C89\u4E1D\u4EEC\u90FD\u4EB2\u5207\u5730\u53EB\u5979\u5A49\u513F\u5B9D\u8D1D\u3002\u6BCF\u5929\u665A\u4E0A\u516B\u70B9\u51C6\u65F6\u5F00\u64AD\uFF0C\u5531\u6B4C\u3001\u804A\u5929\u3001\u8DDF\u7C89\u4E1D\u4E92\u52A8\uFF0C\u4E00\u76F4\u64AD\u5230\u51CC\u6668\u4E00\u4E24\u70B9\u3002\u76F4\u64AD\u95F4\u4EBA\u6C14\u6700\u9AD8\u7684\u65F6\u5019\uFF0C\u540C\u65F6\u5728\u7EBF\u4EBA\u6570\u80FD\u6709\u597D\u51E0\u5343\uFF0C\u6253\u8D4F\u6536\u5165\u76F8\u5F53\u53EF\u89C2\u3002\n\n\u7136\u800C\u955C\u5934\u524D\u540E\u7684\u82CF\u5A49\u513F\u5B8C\u5168\u662F\u4E24\u4E2A\u4EBA\u3002\u76F4\u64AD\u65F6\u5979\u6D3B\u529B\u56DB\u5C04\u3001\u70ED\u60C5\u6D0B\u6EA2\uFF0C\u8DDF\u6BCF\u4E00\u4E2A\u8FDB\u76F4\u64AD\u95F4\u7684\u7C89\u4E1D\u6253\u62DB\u547C\uFF0C\u6492\u5A07\u5356\u840C\u4FE1\u624B\u62C8\u6765\u3002\u53EF\u4E00\u65E6\u5173\u6389\u6444\u50CF\u5934\u548C\u9EA6\u514B\u98CE\uFF0C\u5979\u5C31\u50CF\u53D8\u4E86\u4E2A\u4EBA\u4F3C\u7684\uFF0C\u8138\u4E0A\u7684\u7B11\u5BB9\u77AC\u95F4\u6D88\u5931\uFF0C\u6574\u4E2A\u4EBA\u9677\u5165\u4E00\u79CD\u75B2\u60EB\u7684\u6C89\u9ED8\u3002\u5750\u5728\u6905\u5B50\u4E0A\u4E00\u8A00\u4E0D\u53D1\u5730\u5237\u624B\u673A\uFF0C\u5076\u5C14\u5BF9\u7740\u955C\u5B50\u5378\u5986\uFF0C\u773C\u795E\u7A7A\u6D1E\u5F97\u50CF\u662F\u5728\u53D1\u5446\u3002\u5BA4\u53CB\u8BF4\u5979\u79C1\u4E0B\u91CC\u5B89\u9759\u5F97\u50CF\u53EA\u732B\uFF0C\u51E0\u5929\u4E0D\u8BF4\u4E00\u53E5\u8BDD\u90FD\u6B63\u5E38\u3002\n\n\u82CF\u5A49\u513F\u6700\u8BA9\u90BB\u5C45\u5934\u75BC\u7684\u5C31\u662F\u76F4\u64AD\u65F6\u7684\u566A\u97F3\u3002\u5979\u76F4\u64AD\u65F6\u60C5\u7EEA\u5BB9\u6613\u6FC0\u52A8\uFF0C\u7279\u522B\u662F\u6536\u5230\u5927\u989D\u6253\u8D4F\u7684\u65F6\u5019\uFF0C\u4F1A\u7A81\u7136\u5C16\u53EB\u5927\u558A\u8C22\u8C22\u54E5\u54E5\uFF0C\u58F0\u97F3\u5C16\u9510\u523A\u8033\u3002\u6709\u4E00\u6B21\u51CC\u6668\u4E00\u70B9\u591A\u5979\u7A81\u7136\u6FC0\u52A8\u5730\u5927\u558A\u4E86\u597D\u51E0\u58F0\uFF0C\u9694\u58C1\u90BB\u5C45\u5413\u5F97\u76F4\u63A5\u62A5\u4E86\u8B66\uFF0C\u4EE5\u4E3A\u53D1\u751F\u4E86\u4EC0\u4E48\u5211\u4E8B\u6848\u4EF6\u3002\u8B66\u5BDF\u4E0A\u95E8\u624D\u53D1\u73B0\u53EA\u662F\u5728\u76F4\u64AD\uFF0C\u54ED\u7B11\u4E0D\u5F97\u3002\u7269\u4E1A\u4E3A\u6B64\u627E\u5979\u8C08\u4E86\u597D\u51E0\u6B21\uFF0C\u5979\u7B54\u5E94\u4F1A\u6CE8\u610F\u97F3\u91CF\uFF0C\u4F46\u5174\u594B\u8D77\u6765\u5C31\u5FD8\u4E86\u3002\n\n\u82CF\u5A49\u513F\u7684\u623F\u95F4\u582A\u79F0\u6218\u573A\u3002\u5BA2\u5385\u88AB\u6539\u9020\u6210\u4E86\u76F4\u64AD\u80CC\u666F\u5899\uFF0C\u5806\u6EE1\u4E86\u5404\u79CD\u6253\u5149\u706F\u3001\u73AF\u5F62\u706F\u3001\u8865\u5149\u677F\u548C\u6444\u50CF\u5934\u652F\u67B6\u3002\u5316\u5986\u53F0\u4E0A\u6446\u6EE1\u4E86\u74F6\u74F6\u7F50\u7F50\u7684\u5316\u5986\u54C1\uFF0C\u5730\u4E0A\u6563\u843D\u7740\u6362\u4E0B\u6765\u7684\u8863\u670D\u548C\u914D\u9970\u3002\u51B0\u7BB1\u91CC\u5168\u662F\u5916\u5356\u5269\u996D\u548C\u5976\u8336\u676F\u5B50\uFF0C\u53A8\u623F\u4ECE\u6765\u6CA1\u5F00\u8FC7\u706B\u3002\u5979\u7684\u751F\u6D3B\u5B8C\u5168\u56F4\u7ED5\u76F4\u64AD\u8F6C\uFF0C\u767D\u5929\u7761\u89C9\uFF0C\u4E0B\u5348\u51C6\u5907\u5986\u5BB9\u548C\u8BDD\u672F\uFF0C\u665A\u4E0A\u76F4\u64AD\uFF0C\u51CC\u6668\u6536\u5DE5\u540E\u7EE7\u7EED\u5237\u540C\u884C\u7684\u89C6\u9891\u7814\u7A76\u6570\u636E\u3002\n\n\u5C3D\u7BA1\u79C1\u4E0B\u91CC\u5224\u82E5\u4E24\u4EBA\uFF0C\u4F46\u82CF\u5A49\u513F\u5BF9\u76F4\u64AD\u8FD9\u4EFD\u5DE5\u4F5C\u662F\u8BA4\u771F\u7684\u3002\u5979\u6BCF\u5929\u82B1\u5927\u91CF\u65F6\u95F4\u7814\u7A76\u70ED\u95E8\u5185\u5BB9\uFF0C\u5206\u6790\u7C89\u4E1D\u753B\u50CF\uFF0C\u8C03\u6574\u76F4\u64AD\u7B56\u7565\u3002\u5979\u5FC3\u91CC\u6E05\u695A\u8FD9\u884C\u5403\u7684\u662F\u9752\u6625\u996D\uFF0C\u4E00\u76F4\u5728\u76D8\u7B97\u7740\u6512\u591F\u94B1\u8F6C\u578B\u505A\u7535\u5546\u6216\u8005\u5F00\u5B9E\u4F53\u5E97\u3002\u90BB\u5C45\u4EEC\u5BF9\u5979\u7684\u8BC4\u4EF7\u8912\u8D2C\u4E0D\u4E00\uFF0C\u6709\u4EBA\u89C9\u5F97\u5979\u4E0D\u52A1\u6B63\u4E1A\uFF0C\u6709\u4EBA\u89C9\u5F97\u5979\u81EA\u98DF\u5176\u529B\u6CA1\u4EC0\u4E48\u4E0D\u597D\u3002\u4F46\u4E0D\u7BA1\u522B\u4EBA\u600E\u4E48\u770B\uFF0C\u6BCF\u5929\u665A\u4E0A\u516B\u70B9\uFF0C\u90A3\u4E2A\u751C\u7F8E\u6D3B\u6CFC\u7684\u5A49\u513F\u5B9D\u8D1D\u90FD\u4F1A\u51C6\u65F6\u51FA\u73B0\u5728\u955C\u5934\u524D\uFF0C\u5F00\u59CB\u65B0\u4E00\u5929\u7684\u8868\u6F14\u3002"
