  candidateId: tenant_pi
  portrait: {fileID: 0}
  ability: 4
  activityType: 2
  displayName: "\u9EC4\u5C0F\u660E"
  avatarColor: {r: 0.85, g: 0.45, b: 0.15, a: 1}
  shortDescription: "\u9EC4\u5C0F\u660E\uFF0C\u56DB\u5341\u4E94\u5C81\uFF0C\u4E00\u540D\u8D44\u6DF1\u51FA\u79DF\u8F66\u53F8\u673A\uFF0C\u98CE\u91CC\u6765\u96E8\u91CC\u53BB\u4E8C\u5341\u5E74\uFF0C\u5BF9\u8FD9\u5EA7\u57CE\u5E02\u7684\u6BCF\u6761\u8857\u5DF7\u4E86\u5982\u6307\u638C\u3002\u6027\u683C\u5F00\u6717\u5916\u5411\uFF0C\u8BDD\u5323\u5B50\u4E00\u6253\u5F00\u5C31\u6536\u4E0D\u4F4F\uFF0C\u4ECE\u5929\u6C14\u804A\u5230\u56FD\u9645\u5F62\u52BF\uFF0C\u4ECE\u83DC\u4EF7\u804A\u5230\u4EBA\u751F\u54F2\u5B66\uFF0C\u4E58\u5BA2\u4E0A\u8F66\u57FA\u672C\u4E0D\u7528\u5BFC\u822A\uFF0C\u9760\u4ED6\u4E00\u5F20\u5634\u5C31\u591F\u4E86\u3002\u505C\u8F66\u6280\u672F\u4E00\u6D41\uFF0C\u518D\u7A84\u7684\u8F66\u4F4D\u90FD\u80FD\u4E00\u628A\u5165\u5E93\u3002\u4E0D\u8FC7\u8BDD\u591A\u4E5F\u6709\u8BDD\u591A\u7684\u70E6\u607C\uFF0C\u6709\u65F6\u4E58\u5BA2\u60F3\u5B89\u9759\u4F11\u606F\uFF0C\u4ED6\u80FD\u4ECE\u4E0A\u8F66\u804A\u5230\u4E0B\u8F66\uFF0C\u5168\u7A0B\u4E0D\u505C\u6B47\u3002\u70ED\u5FC3\u80A0\uFF0C\u9047\u5230\u8001\u4EBA\u5C0F\u5B69\u603B\u4F1A\u591A\u7B49\u4E00\u4F1A\u513F\uFF0C\u4ECE\u4E0D\u50AC\u4FC3\u3002"
  detailedDescription: "\u9EC4\u5C0F\u660E\uFF0C\u4ECA\u5E74\u56DB\u5341\u4E94\u5C81\uFF0C\u662F\u4E00\u540D\u6709\u7740\u4E8C\u5341\u4E09\u5E74\u9A7E\u9F84\u7684\u8001\u51FA\u79DF\u8F66\u53F8\u673A\u3002\u6BCF\u5929\u51CC\u6668\u4E94\u70B9\u534A\u51C6\u65F6\u51FA\u8F66\uFF0C\u665A\u4E0A\u5341\u4E00\u70B9\u6536\u5DE5\uFF0C\u98CE\u96E8\u65E0\u963B\u3002\u4ED6\u8BF4\u8FD9\u4EFD\u5DE5\u4F5C\u6700\u5927\u7684\u597D\u5904\u5C31\u662F\u81EA\u7531\uFF0C\u4E0D\u7528\u770B\u8001\u677F\u8138\u8272\uFF0C\u65B9\u5411\u76D8\u5728\u81EA\u5DF1\u624B\u91CC\uFF0C\u60F3\u53BB\u54EA\u5C31\u53BB\u54EA\u3002\u867D\u7136\u6536\u5165\u4E0D\u7B97\u9AD8\uFF0C\u4F46\u4ED6\u4ECE\u6765\u4E0D\u62B1\u6028\uFF0C\u89C9\u5F97\u80FD\u517B\u6D3B\u4E00\u5BB6\u4EBA\u5C31\u5DF2\u7ECF\u5F88\u6EE1\u8DB3\u4E86\u3002\n\n\u4ED6\u662F\u90A3\u79CD\u5929\u751F\u81EA\u6765\u719F\u7684\u4EBA\uFF0C\u4E58\u5BA2\u4E00\u4E0A\u8F66\uFF0C\u4ED6\u5C31\u5F00\u59CB\u642D\u8BDD\u3002\u4ECE\u4ECA\u5929\u5929\u6C14\u4E0D\u9519\u804A\u5230\u9694\u58C1\u5C0F\u533A\u65B0\u5F00\u4E86\u4E00\u5BB6\u706B\u9505\u5E97\uFF0C\u4ECE\u6700\u8FD1\u7684\u6CB9\u4EF7\u6DA8\u4E86\u804A\u5230\u4ED6\u5E74\u8F7B\u65F6\u5019\u7684\u6545\u4E8B\u3002\u6709\u4E9B\u4E58\u5BA2\u559C\u6B22\u542C\u4ED6\u4F83\u5927\u5C71\uFF0C\u6709\u4E9B\u5219\u6068\u4E0D\u5F97\u628A\u8033\u673A\u97F3\u91CF\u8C03\u5230\u6700\u5927\u3002\u4F46\u4ED6\u5B8C\u5168\u611F\u53D7\u4E0D\u5230\u522B\u4EBA\u7684\u6697\u793A\uFF0C\u4F9D\u7136\u70ED\u60C5\u6D0B\u6EA2\u5730\u8BF4\u4E2A\u4E0D\u505C\u3002\u8F66\u961F\u91CC\u7684\u540C\u884C\u90FD\u53EB\u4ED6\"\u9EC4\u5927\u5634\"\uFF0C\u4ED6\u975E\u4F46\u4E0D\u751F\u6C14\uFF0C\u53CD\u800C\u89C9\u5F97\u8FD9\u662F\u5BF9\u4ED6\u793E\u4EA4\u80FD\u529B\u7684\u80AF\u5B9A\u3002\n\n\u522B\u770B\u8BDD\u591A\uFF0C\u9EC4\u5C0F\u660E\u7684\u9A7E\u9A76\u6280\u672F\u5728\u6574\u4E2A\u51FA\u79DF\u8F66\u516C\u53F8\u662F\u6570\u4E00\u6570\u4E8C\u7684\u3002\u4E8C\u5341\u591A\u5E74\u7684\u7ECF\u9A8C\u79EF\u7D2F\uFF0C\u8BA9\u4ED6\u5BF9\u8FD9\u5EA7\u57CE\u5E02\u7684\u9053\u8DEF\u7F51\u7EDC\u70C2\u719F\u4E8E\u5FC3\u3002\u54EA\u6761\u8DEF\u5728\u4FEE\u5730\u94C1\uFF0C\u54EA\u6761\u5DF7\u5B50\u80FD\u6284\u8FD1\u8DEF\uFF0C\u54EA\u4E2A\u8DEF\u53E3\u5728\u51E0\u70B9\u51E0\u5206\u6700\u5835\uFF0C\u4ED6\u5168\u90FD\u95E8\u513F\u6E05\u3002\u4ED6\u7684\u5012\u8F66\u5165\u5E93\u66F4\u662F\u4E00\u7EDD\uFF0C\u4FA7\u65B9\u4F4D\u505C\u8F66\u4ECE\u6765\u4E0D\u9700\u8981\u7B2C\u4E8C\u628A\u65B9\u5411\uFF0C\u540C\u884C\u4EEC\u770B\u4E86\u90FD\u81EA\u6127\u4E0D\u5982\u3002\n\n\u9EC4\u5C0F\u660E\u4F4F\u5728\u8FD9\u4E2A\u5C0F\u533A\u5DF2\u7ECF\u516B\u5E74\u4E86\uFF0C\u5E73\u65F6\u548C\u90BB\u5C45\u4EEC\u5173\u7CFB\u90FD\u4E0D\u9519\u3002\u8C01\u5BB6\u8981\u642C\u4E2A\u4E1C\u897F\u3001\u63A5\u9001\u4E2A\u5B69\u5B50\uFF0C\u53EB\u4ED6\u4E00\u58F0\u51C6\u5230\u3002\u4ED6\u8001\u5A46\u5728\u83DC\u5E02\u573A\u5356\u6C34\u679C\uFF0C\u4E24\u53E3\u5B50\u8D77\u65E9\u8D2A\u9ED1\u4F9B\u513F\u5B50\u4E0A\u5927\u5B66\u3002\u867D\u7136\u65E5\u5B50\u8FC7\u5F97\u4E0D\u7B97\u5BCC\u88D5\uFF0C\u4F46\u9EC4\u5C0F\u660E\u603B\u662F\u4E50\u5475\u5475\u7684\uFF0C\u4ED6\u8BF4\u5F00\u5FC3\u4E5F\u662F\u4E00\u5929\uFF0C\u4E0D\u5F00\u5FC3\u4E5F\u662F\u4E00\u5929\uFF0C\u5E72\u561B\u4E0D\u5F00\u5F00\u5FC3\u5FC3\u5730\u8FC7\u5462\u3002\n\n\u4ED6\u6709\u4E2A\u5C0F\u6BDB\u75C5\uFF0C\u5C31\u662F\u7279\u522B\u7231\u542C\u5E7F\u64AD\uFF0C\u800C\u4E14\u53EA\u542C\u4EA4\u901A\u53F0\u3002\u8F66\u91CC\u4ECE\u65E9\u5230\u665A\u90FD\u662F\u5E7F\u64AD\u7684\u58F0\u97F3\uFF0C\u4E58\u5BA2\u4E0A\u8F66\u5C31\u80FD\u542C\u5230\u6700\u65B0\u7684\u8DEF\u51B5\u4FE1\u606F\u548C\u5404\u79CD\u5947\u95FB\u8F76\u4E8B\u3002\u4ED6\u81EA\u5DF1\u8FD8\u6512\u4E86\u4E00\u809A\u5B50\u5E7F\u64AD\u91CC\u542C\u6765\u7684\u6BB5\u5B50\uFF0C\u65F6\u4E0D\u65F6\u62FF\u51FA\u6765\u8BB2\u7ED9\u4E58\u5BA2\u542C\u3002\u4E0D\u8FC7\u4ED6\u7684\u7B11\u8BDD\u603B\u662F\u51B7\u5230\u8BA9\u4EBA\u6253\u54C6\u55E6\uFF0C\u504F\u504F\u4ED6\u81EA\u5DF1\u7B11\u5F97\u6700\u5927\u58F0\u3002\u5C0F\u533A\u95E8\u53E3\u7684\u4FDD\u5B89\u90FD\u8BF4\uFF0C\u6BCF\u5929\u65E9\u4E0A\u4E94\u70B9\u534A\uFF0C\u4E0D\u7528\u770B\u8868\uFF0C\u542C\u9EC4\u5C0F\u660E\u53D1\u52A8\u8F66\u5B50\u7684\u58F0\u97F3\u5C31\u77E5\u9053\u51E0\u70B9\u4E86\u3002"
