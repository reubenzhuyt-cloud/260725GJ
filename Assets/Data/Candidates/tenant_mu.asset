  m_Script: {fileID: 11500000, guid: 6a725b000eb23c446b734e1ebfb811a4, type: 3}
  m_Name: tenant_mu
  m_EditorClassIdentifier: 
  candidateId: tenant_mu
  displayName: "\u6768\u5c0f\u51e1"
  avatarColor: {r: 0.5, g: 0.5, b: 0.9, a: 1}
  shortDescription: "\u6768\u5c0f\u51e1\uff0c\u4e8c\u5341\u4e5d\u5c81\uff0c\u4e92\u8054\u7f51\u516c\u53f8\u540e\u7aef\u7a0b\u5e8f\u5458\u3002\u5e73\u65f6\u6c89\u9ed8\u5be1\u8a00\uff0c\u8ddf\u4eba\u8bf4\u8bdd\u4e0d\u8d85\u8fc7\u4e09\u4e2a\u5b57\uff0c\u4f46\u4e00\u804a\u8d77\u4ee3\u7801\u80fd\u6ed4\u6ed4\u4e0d\u7edd\u8bb2\u4e24\u5c0f\u65f6\u3002\n\u4f5c\u606f\u6781\u5176\u4e0d\u89c4\u5f8b\uff0c\u51cc\u6668\u4e09\u70b9\u623f\u95f4\u7684\u706f\u8fd8\u4eae\u7740\u662f\u5e38\u6001\uff0c\u90bb\u5c45\u4e00\u5ea6\u6000\u7591\u4ed6\u5728\u641e\u4ec0\u4e48\u975e\u6cd5\u52fe\u5f53\u3002\u623f\u95f4\u91cc\u4e09\u53f0\u663e\u793a\u5668\u540c\u65f6\u8fd0\u884c\uff0c\u673a\u7bb1\u98ce\u6247\u55e1\u55e1\u4f5c\u54cd\uff0c\u590f\u5929\u4e0d\u5f00\u7a7a\u8c03\u5ba4\u5185\u6e29\u5ea6\u90fd\u80fd\u5230\u4e09\u5341\u4e94\u5ea6\u3002\n\u5916\u5356\u76d2\u5b50\u5728\u684c\u89d2\u5806\u6210\u5c0f\u5c71\uff0c\u6700\u4e45\u7684\u4e00\u6b21\u653e\u4e86\u4e00\u4e2a\u661f\u671f\u624d\u6254\u3002\u684c\u4e0a\u5e38\u5e74\u6446\u7740\u4e09\u7f50\u4e0d\u540c\u53e3\u5473\u7684\u5496\u5561\u7c89\uff0c\u662f\u4ed6\u7eed\u547d\u7684\u5fc5\u9700\u54c1\u3002\u5176\u5b9e\u4ed6\u53ea\u662f\u5728\u5199\u4ee3\u7801\uff0c\u5927\u6982\u3002"
  detailedDescription: "\u6768\u5c0f\u51e1\uff0c\u4e8c\u5341\u4e5d\u5c81\uff0c\u6bd5\u4e1a\u4e8e\u67d0985\u9ad8\u6821\u8ba1\u7b97\u673a\u7cfb\uff0c\u76ee\u524d\u5728\u4e00\u5bb6\u4e92\u8054\u7f51\u516c\u53f8\u505a\u540e\u7aef\u5f00\u53d1\u3002\u957f\u76f8\u6e05\u79c0\uff0c\u6234\u7740\u4e00\u526f\u9ed1\u6846\u773c\u955c\uff0c\u5934\u53d1\u5e38\u5e74\u4e0d\u6253\u7406\uff0c\u4e71\u84ec\u84ec\u5730\u652f\u68f1\u7740\uff0c\u540c\u4e8b\u8bf4\u4ed6\u6bcf\u5929\u7684\u53d1\u578b\u90fd\u4e0d\u4e00\u6837\uff0c\u4f46\u6bcf\u4e00\u79cd\u90fd\u5f88\u62bd\u8c61\u3002\u5e73\u65f6\u8bdd\u5f88\u5c11\uff0c\u8ddf\u90bb\u5c45\u78b0\u9762\u9876\u591a\u70b9\u4e2a\u5934\uff0c\u8981\u662f\u4e3b\u52a8\u8bf4\u4e00\u53e5\"\u4f60\u597d\"\uff0c\u5bf9\u65b9\u53cd\u800c\u4f1a\u5413\u4e00\u8df3\u3002\n\u4ed6\u7684\u4f5c\u606f\u582a\u79f0\u5c0f\u533a\u91cc\u7684\u4e00\u5927\u5947\u89c2\u3002\u767d\u5929\u57fa\u672c\u770b\u4e0d\u5230\u4eba\u5f71\uff0c\u4e00\u5230\u665a\u4e0a\u5c31\u7cbe\u795e\u6296\u64de\uff0c\u952e\u76d8\u6572\u5f97\u567c\u91cc\u556a\u5566\u54cd\u3002\u51cc\u6668\u4e24\u4e09\u70b9\u623f\u95f4\u8fd8\u706f\u706b\u901a\u660e\uff0c\u663e\u793a\u5668\u7684\u84dd\u5149\u900f\u8fc7\u7a97\u5e18\u7f1d\u9699\u6f0f\u51fa\u6765\uff0c\u8fdc\u8fdc\u770b\u53bb\u50cf\u662f\u4e00\u76f4\u5728\u53d1\u5149\u7684\u5e7d\u7075\u3002\u9694\u58c1\u90bb\u5c45\u8001\u738b\u6709\u6b21\u534a\u591c\u8d77\u6765\u4e0a\u5395\u6240\uff0c\u770b\u5230\u4ed6\u7a97\u6237\u8fd8\u4eae\u7740\uff0c\u7b2c\u4e8c\u5929\u5fe7\u5fc3\u5fe1\u5fe1\u5730\u95ee\u7269\u4e1a\u662f\u4e0d\u662f\u90a3\u6237\u4eba\u5bb6\u51fa\u4e86\u4ec0\u4e48\u4e8b\u3002\n\u6768\u5c0f\u51e1\u7684\u623f\u95f4\u662f\u5178\u578b\u7684\u7a0b\u5e8f\u5458\u5b85\u7537\u98ce\u683c\u3002\u4e09\u53f0\u663e\u793a\u5668\u4e00\u5b57\u6392\u5f00\uff0c\u5de6\u8fb9\u5199\u4ee3\u7801\uff0c\u4e2d\u95f4\u8c03\u8bd5\uff0c\u53f3\u8fb9\u6302\u7740\u5404\u79cd\u76d1\u63a7\u9762\u677f\u3002\u684c\u4e0a\u6c38\u8fdc\u5806\u7740\u5916\u5356\u76d2\u5b50\u548c\u7a7a\u996e\u6599\u74f6\uff0c\u6905\u5b50\u65c1\u8fb9\u7acb\u7740\u4e24\u7bb1\u65b9\u4fbf\u9762\uff0c\u662f\u4ed6\u5bf9\u6297\u52a0\u73ed\u7684\u540e\u52e4\u4fdd\u969c\u3002\u6709\u4e00\u6b21\u7269\u4e1a\u4e0a\u95e8\u68c0\u67e5\u6d88\u9632\u5b89\u5168\uff0c\u5dee\u70b9\u4ee5\u4e3a\u8fdb\u4e86\u7f51\u5427\u3002\u5730\u4e0a\u9664\u4e86\u7535\u7ebf\u5c31\u662f\u6570\u636e\u7ebf\uff0c\u8d70\u9053\u4ec5\u5bb9\u4e00\u4eba\u4fa7\u8eab\u901a\u8fc7\u3002\n\u867d\u7136\u770b\u8d77\u6765\u908b\u91cc\u908b\u9062\uff0c\u4f46\u6768\u5c0f\u51e1\u7684\u6280\u672f\u6c34\u5e73\u5728\u516c\u53f8\u91cc\u662f\u516c\u8ba4\u7684\u5f3a\u3002\u4ed6\u5199\u7684\u4ee3\u7801\u89c4\u8303\u6574\u6d01\uff0c\u6ce8\u91ca\u8be6\u7ec6\uff0c\u540c\u4e8b\u4eec\u90fd\u613f\u610f\u8ddf\u4ed6\u5408\u4f5c\u3002\u53ea\u662f\u4ed6\u6709\u4e2a\u6bdb\u75c5\uff0c\u9047\u5230\u7a0b\u5e8f\u51fa\u9519\u5c31\u8fdb\u5165\u5fd8\u6211\u72b6\u6001\uff0c\u4e0d\u5403\u4e0d\u559d\u4e0d\u7761\u89c9\uff0c\u76f4\u5230\u95ee\u9898\u89e3\u51b3\u4e3a\u6b62\u3002\u6700\u5938\u5f20\u7684\u4e00\u6b21\u8fde\u7eed\u5de5\u4f5c\u4e86\u4e09\u5341\u516d\u4e2a\u5c0f\u65f6\uff0c\u6700\u540e\u662f\u88ab\u540c\u4e8b\u4ece\u5de5\u4f4d\u4e0a\u62ac\u53bb\u533b\u52a1\u5ba4\u7684\u3002\u9192\u6765\u7b2c\u4e00\u53e5\u8bdd\u95ee\u7684\u662f\u7a0b\u5e8f\u51fa\u9519\u4fee\u597d\u4e86\u6ca1\u6709\u3002\n\u751f\u6d3b\u4e2d\u7684\u6768\u5c0f\u51e1\u5176\u5b9e\u5fc3\u5730\u5584\u826f\uff0c\u53ea\u662f\u4e0d\u5584\u8868\u8fbe\u3002\u6709\u6b21\u697c\u4e0a\u6f0f\u6c34\u6df9\u4e86\u4ed6\u7684\u7535\u8111\u8bbe\u5907\uff0c\u4ed6\u4e00\u53e5\u91cd\u8bdd\u6ca1\u8bf4\uff0c\u81ea\u5df1\u9ed8\u9ed8\u6536\u62fe\u4e86\u4e00\u6574\u591c\u3002\u5076\u5c14\u9047\u5230\u90bb\u5c45\u642c\u4e1c\u897f\uff0c\u4ed6\u4f1a\u4e00\u58f0\u4e0d\u542d\u5730\u4e0a\u53bb\u5e2e\u5fd9\uff0c\u642c\u5b8c\u5c31\u8d70\uff0c\u8fde\u53e5\u5ba2\u6c14\u8bdd\u90fd\u4e0d\u7559\u3002\u4ed6\u517b\u4e86\u4e00\u53ea\u6a58\u732b\u53eb\"\u7f16\u8bd1\"\uff0c\u662f\u4ed6\u552f\u4e00\u7684\u5ba4\u53cb\uff0c\u6bcf\u5929\u8db4\u5728\u4ed6\u952e\u76d8\u65c1\u8fb9\u966a\u4ed6\u52a0\u73ed\u3002\u90bb\u5c45\u4eec\u5bf9\u4ed6\u7684\u8bc4\u4ef7\u51fa\u5947\u5730\u4e00\u81f4\uff1a\u4eba\u662f\u4e2a\u597d\u4eba\uff0c\u5c31\u662f\u4e0d\u592a\u50cf\u6b63\u5e38\u4eba\u3002"
