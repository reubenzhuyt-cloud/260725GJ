  m_Script: {fileID: 11500000, guid: 6a725b000eb23c446b734e1ebfb811a4, type: 3}
  m_Name: tenant_xi
  m_EditorClassIdentifier: 
  candidateId: tenant_xi
  portrait: {fileID: 0}
  ability: 0
  activityType: 1
  displayName: "\u90d1\u5c0f\u9ed1"
  avatarColor: {r: 0.6, g: 0.3, b: 0.6, a: 1}
  shortDescription: "\u90d1\u5c0f\u9ed1\uff0c\u4e09\u5341\u4e8c\u5c81\uff0c\u5730\u4e0b\u6447\u6eda\u4e50\u961f\u5409\u4ed6\u624b\u517c\u8bcd\u66f2\u521b\u4f5c\u3002\u7559\u7740\u53ca\u80a9\u957f\u53d1\u7a7f\u7740\u94c6\u9489\u76ae\u5939\u514b\uff0c\u5916\u8868\u770b\u8d77\u6765\u5f88\u9177\u5f88\u53db\u9006\uff0c\u5176\u5b9e\u6027\u683c\u6e29\u548c\u5230\u4e0d\u50cf\u8bdd\uff0c\u4ece\u4e0d\u8ddf\u4eba\u7ea2\u8138\u3002\n\u5e73\u65f6\u8bf4\u8bdd\u8f7b\u58f0\u7ec6\u8bed\uff0c\u8ddf\u821e\u53f0\u4e0a\u90a3\u4e2a\u7529\u5934\u5636\u543c\u7684\u5f62\u8c61\u5224\u82e5\u4e24\u4eba\uff0c\u90bb\u5c45\u4eec\u600e\u4e48\u4e5f\u65e0\u6cd5\u628a\u697c\u9053\u91cc\u90a3\u4e2a\u817c\u8146\u7684\u5e74\u8f7b\u4eba\u548c\u821e\u53f0\u4e0a\u7684\u72c2\u4eba\u8054\u7cfb\u5230\u4e00\u8d77\u3002\u7ec3\u5409\u4ed6\u662f\u771f\u7684\u5435\uff0c\u90bb\u5c45\u4ee5\u4e3a\u88c5\u4fee\u961f\u6765\u4e86\uff0c\u6295\u8bc9\u4fe1\u5199\u4e86\u597d\u51e0\u5c01\u3002\n\u73b0\u5728\u6539\u7528\u8033\u673a\u7ec3\u4e60\u7b97\u662f\u8fdb\u6b65\u4e86\uff0c\u4f46\u5076\u5c14\u7075\u611f\u6765\u4e86\u8fd8\u662f\u4f1a\u5fcd\u4e0d\u4f4f\u5916\u653e\uff0c\u7136\u540e\u6328\u5bb6\u6328\u6237\u9053\u6b49\u3002"
  detailedDescription: "\u90d1\u5c0f\u9ed1\uff0c\u672c\u540d\u90d1\u78ca\uff0c\u4e09\u5341\u4e8c\u5c81\uff0c\u670b\u53cb\u4eec\u90fd\u53eb\u4ed6\u5c0f\u9ed1\u3002\u4ed6\u662f\u672c\u5730\u4e00\u652f\u5730\u4e0b\u6447\u6eda\u4e50\u961f\u7684\u5409\u4ed6\u624b\u517c\u4e3b\u521b\uff0c\u4e50\u961f\u53eb\"\u5348\u591c\u5217\u8f66\"\uff0c\u5728\u5c0f\u4f17\u97f3\u4e50\u5708\u5b50\u91cc\u5c0f\u6709\u540d\u6c14\u3002\u4ed6\u7559\u7740\u4e00\u5934\u53ca\u80a9\u957f\u53d1\uff0c\u5e38\u5e74\u7a7f\u7740\u9ed1\u8272\u76ae\u5939\u514b\u548c\u7834\u6d1e\u725b\u4ed4\u88e4\uff0c\u8116\u5b50\u4e0a\u6302\u7740\u4e00\u6839\u9ab7\u9ac5\u5934\u9879\u94fe\uff0c\u8d70\u5728\u8857\u4e0a\u56de\u5934\u7387\u5f88\u9ad8\u3002\n\u4f46\u5982\u679c\u4f60\u56e0\u4e3a\u4ed6\u7684\u5916\u8868\u5c31\u89c9\u5f97\u4ed6\u662f\u4e2a\u4e0d\u597d\u60f9\u7684\u4eba\uff0c\u90a3\u53ef\u5c31\u5927\u9519\u7279\u9519\u4e86\u3002\u90d1\u5c0f\u9ed1\u7684\u6027\u683c\u8ddf\u4ed6\u90a3\u526f\u6447\u6eda\u786c\u6c49\u7684\u5916\u8868\u5b8c\u5168\u662f\u4e24\u4e2a\u6781\u7aef\u3002\u4ed6\u8bf4\u8bdd\u8f7b\u58f0\u7ec6\u8bed\uff0c\u89c1\u5230\u90bb\u5c45\u4f1a\u4e3b\u52a8\u95ee\u597d\uff0c\u697c\u9053\u91cc\u9047\u5230\u8001\u4eba\u5bb6\u63d0\u91cd\u7269\u4e8c\u8bdd\u4e0d\u8bf4\u5c31\u4e0a\u53bb\u5e2e\u5fd9\u3002\u5c0f\u533a\u91cc\u7684\u5b69\u5b50\u4eec\u90fd\u559c\u6b22\u56f4\u7740\u4ed6\u8f6c\uff0c\u56e0\u4e3a\u4ed6\u4f1a\u53d8\u9b54\u672f\u4f3c\u7684\u4ece\u53e3\u888b\u91cc\u638f\u51fa\u7cd6\u679c\u3002\u6709\u4e00\u6b21\u5c0f\u533a\u91cc\u4e00\u53ea\u6d41\u6d6a\u732b\u53d7\u4f24\u4e86\uff0c\u662f\u4ed6\u5927\u534a\u591c\u62b1\u7740\u732b\u8dd1\u4e86\u4e09\u6761\u8857\u627e\u5230\u5ba0\u7269\u533b\u9662\uff0c\u57ab\u4e86\u4e24\u5343\u5757\u533b\u836f\u8d39\u3002\n\u552f\u4e00\u8ba9\u90bb\u5c45\u4eec\u5934\u75bc\u7684\u5c31\u662f\u4ed6\u7ec3\u7434\u7684\u95ee\u9898\u3002\u6447\u6eda\u4e50\u624b\u561b\uff0c\u7ec3\u4e60\u7684\u65f6\u5019\u97f3\u91cf\u786e\u5b9e\u4e0d\u5c0f\u3002\u4e4b\u524d\u4ed6\u5728\u5bb6\u91cc\u6392\u7ec3\uff0c\u7535\u5409\u4ed6\u7684\u5931\u771f\u97f3\u6548\u900f\u8fc7\u5899\u58c1\u4f20\u5230\u9694\u58c1\uff0c\u90bb\u5c45\u738b\u5927\u7237\u4ee5\u4e3a\u95f9\u5730\u9707\u4e86\uff0c\u5dee\u70b9\u6253119\u3002\u6295\u8bc9\u4fe1\u96ea\u82b1\u4e00\u6837\u98de\u5230\u7269\u4e1a\uff0c\u7269\u4e1a\u627e\u4ed6\u8c08\u4e86\u597d\u51e0\u6b21\u8bdd\u3002\u90d1\u5c0f\u9ed1\u4e5f\u89c9\u5f97\u4e0d\u597d\u610f\u601d\uff0c\u81ea\u638f\u8170\u5305\u7ed9\u623f\u95f4\u505a\u4e86\u9694\u97f3\u5904\u7406\uff0c\u53c8\u4e70\u4e86\u4e00\u5957\u4e13\u4e1a\u8033\u673a\uff0c\u5e73\u65f6\u90fd\u6234\u7740\u8033\u673a\u7ec3\u4e60\u3002\n\u4e50\u961f\u7684\u65e5\u5b50\u5e76\u4e0d\u597d\u8fc7\u3002\"\u5348\u591c\u5217\u8f66\"\u6ca1\u6709\u7b7e\u7ea6\u516c\u53f8\uff0c\u6f14\u51fa\u5168\u9760\u81ea\u5df1\u8054\u7cfb\u9152\u5427\u548c\u5c0f\u5267\u573a\uff0c\u6536\u5165\u5f88\u4e0d\u7a33\u5b9a\u3002\u90d1\u5c0f\u9ed1\u767d\u5929\u5728\u4e00\u5bb6\u7434\u884c\u505a\u517c\u804c\u5409\u4ed6\u8001\u5e08\uff0c\u6559\u5c0f\u670b\u53cb\u5f39\u7434\uff0c\u665a\u4e0a\u624d\u662f\u5c5e\u4e8e\u4ed6\u81ea\u5df1\u7684\u6447\u6eda\u65f6\u95f4\u3002\u4ed6\u8bf4\u81ea\u5df1\u8fd9\u8f88\u5b50\u6700\u5927\u7684\u68a6\u60f3\u5c31\u662f\u80fd\u529e\u4e00\u573a\u5343\u4eba\u6f14\u5531\u4f1a\uff0c\u54ea\u6015\u53ea\u6709\u4e00\u6b21\u4e5f\u597d\u3002\u4e3a\u4e86\u8fd9\u4e2a\u68a6\u60f3\uff0c\u4ed6\u5df2\u7ecf\u5728\u5730\u4e0b\u97f3\u4e50\u5708\u6478\u722c\u6eda\u6253\u4e86\u5341\u5e74\u3002\n\u90bb\u5c45\u4eec\u5bf9\u90d1\u5c0f\u9ed1\u7684\u8bc4\u4ef7\u51fa\u4eba\u610f\u6599\u5730\u597d\u3002\u867d\u7136\u5076\u5c14\u4f1a\u88ab\u4ed6\u7684\u7434\u58f0\u6253\u6270\uff0c\u4f46\u5927\u5bb6\u90fd\u77e5\u9053\u8fd9\u4e2a\u5916\u8868\u9177\u9177\u7684\u5e74\u8f7b\u4eba\u5176\u5b9e\u5fc3\u5730\u5584\u826f\u3002\u6bcf\u5e74\u5c0f\u533a\u8054\u6b22\u4f1a\u4ed6\u90fd\u4f1a\u4e3b\u52a8\u4e0a\u53f0\u8868\u6f14\uff0c\u4ece\u4e0d\u6536\u94b1\uff0c\u4e00\u9996\u300a\u6d77\u9614\u5929\u7a7a\u300b\u80fd\u8ba9\u5168\u573a\u5927\u5408\u5531\u3002\u6709\u4f4f\u6237\u5bb6\u5b69\u5b50\u60f3\u5b66\u5409\u4ed6\uff0c\u4ed6\u514d\u8d39\u6559\u4e86\u597d\u51e0\u8282\u8bfe\u3002\u4ed6\u8bf4\u6447\u6eda\u7cbe\u795e\u4e0d\u662f\u53db\u9006\u548c\u7834\u574f\uff0c\u800c\u662f\u771f\u8bda\u548c\u70ed\u7231\uff0c\u4ed6\u53ea\u662f\u957f\u5f97\u6bd4\u8f83\u6447\u6eda\u800c\u5df2\u3002"
