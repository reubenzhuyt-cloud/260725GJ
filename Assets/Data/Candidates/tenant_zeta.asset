  displayName: "\u8001\u5218\u5934"
  avatarKey: elder_male_02
  portrait: {fileID: 21300000, guid: 1a2c5cb2329b6924e911f5c358a3d930, type: 3}
  avatarColor: {r: 0.3, g: 0.85, b: 0.85, a: 1}
  ability: 0
  activityType: 0
  shortDescription: "\u8001\u5218\u5934\uFF0C\u516D\u5341\u516B\u5C81\uFF0C\u9000\u4F11\u673A\u5173\u5E72\u90E8\uFF0C\u8C61\u68CB\u6C34\u5E73\u4E00\u6D41\uFF0C\u5C0F\u533A\u91CC\u6CA1\u51E0\u4E2A\u4EBA\u4E0B\u5F97\u8FC7\u4ED6\u3002\u6027\u683C\u56FA\u6267\u5014\u5F3A\uFF0C\u8BA4\u5B9A\u7684\u4E8B\u4E5D\u5934\u725B\u4E5F\u62C9\u4E0D\u56DE\u6765\uFF0C\u6BCF\u5929\u96F7\u6253\u4E0D\u52A8\u5728\u697C\u4E0B\u77F3\u684C\u6446\u68CB\u5C40\uFF0C\u98CE\u96E8\u65E0\u963B\u3002\u8F93\u4E86\u5C31\u677F\u7740\u8138\u8BF4\"\u8BA9\u4F60\u7684\"\uFF0C\u8D62\u4E86\u5C31\u62CD\u7740\u5927\u817F\u5439\u5618\u81EA\u5DF1\u5F53\u5E74\u529B\u632B\u7FA4\u96C4\u7684\u5F80\u4E8B\u3002\u517B\u4E86\u4E09\u53EA\u732B\u5206\u522B\u53EB\u8F66\u3001\u9A6C\u3001\u70AE\uFF0C\u6BD4\u5BF9\u81EA\u5DF1\u5B59\u5B50\u8FD8\u4E0A\u5FC3\uFF0C\u6BCF\u5929\u4EB2\u81EA\u53BB\u83DC\u5E02\u573A\u6311\u6700\u65B0\u9C9C\u7684\u5C0F\u9C7C\u5582\u5B83\u4EEC\uFF0C\u81EA\u5DF1\u5374\u7ECF\u5E38\u716E\u7897\u9762\u6761\u51D1\u5408\u5EA6\u65E5\u3002\u513F\u5973\u90FD\u5728\u5916\u5730\uFF0C\u4ED6\u5634\u4E0A\u8BF4\u4E0D\u9700\u8981\u4EBA\u966A\uFF0C\u4F46\u6BCF\u6B21\u89C6\u9891\u901A\u8BDD\u90FD\u820D\u4E0D\u5F97\u5148\u6302\u65AD\u3002"
  detailedDescription: "\u8001\u5218\u5934\uFF0C\u5168\u540D\u5218\u5FB7\u5C71\uFF0C\u516D\u5341\u516B\u5C81\uFF0C\u9000\u4F11\u524D\u5728\u5E02\u673A\u5173\u4E8B\u52A1\u7BA1\u7406\u5C40\u5F53\u4E86\u4E09\u5341\u5E74\u7684\u540E\u52E4\u79D1\u957F\u3002\u8C61\u68CB\u6C34\u5E73\u4E00\u6D41\uFF0C\u636E\u8BF4\u5E74\u8F7B\u65F6\u53C2\u52A0\u8FC7\u7701\u7EA7\u6BD4\u8D5B\u8FD8\u5F97\u8FC7\u540D\u6B21\uFF0C\u5C0F\u533A\u91CC\u6CA1\u51E0\u4E2A\u4EBA\u4E0B\u5F97\u8FC7\u4ED6\u3002\u9000\u4F11\u540E\u6700\u5927\u7684\u7231\u597D\u5C31\u662F\u5728\u697C\u4E0B\u77F3\u684C\u6446\u68CB\u5C40\uFF0C\u6BCF\u5929\u65E9\u4E0A\u4E03\u70B9\u51C6\u65F6\u51FA\u73B0\uFF0C\u68CB\u76D8\u68CB\u5B50\u64E6\u5F97\u9503\u4EAE\uFF0C\u4E00\u5750\u5C31\u662F\u4E00\u6574\u5929\u3002\u6765\u6311\u6218\u7684\u4EBA\u4E0D\u5C11\uFF0C\u4F46\u80FD\u8D62\u4ED6\u7684\u4E00\u53EA\u624B\u6570\u5F97\u8FC7\u6765\u3002\u8F93\u4E86\u5C31\u677F\u7740\u8138\u8BF4\"\u8BA9\u4F60\u7684\"\uFF0C\u8D62\u4E86\u5C31\u62CD\u7740\u5927\u817F\u5439\u5618\u81EA\u5DF1\u5F53\u5E74\u5982\u4F55\u529B\u632B\u7FA4\u96C4\uFF0C\u90A3\u5F97\u610F\u52B2\u513F\u6D3B\u50CF\u4E2A\u8001\u987D\u7AE5\u3002\n\n\u517B\u4E86\u4E09\u53EA\u732B\uFF0C\u540D\u5B57\u5206\u522B\u53EB\u8F66\u3001\u9A6C\u3001\u70AE\uFF0C\u5BF9\u5E94\u8C61\u68CB\u91CC\u7684\u4E09\u4E2A\u68CB\u5B50\u3002\u8FD9\u4E09\u53EA\u732B\u6BCF\u5929\u5403\u7684\u6BD4\u8001\u5218\u5934\u81EA\u5DF1\u8FD8\u597D\uFF0C\u4ED6\u4EB2\u81EA\u53BB\u83DC\u5E02\u573A\u6311\u6700\u65B0\u9C9C\u7684\u5C0F\u9C7C\uFF0C\u56DE\u6765\u7528\u5C0F\u706B\u6162\u7096\uFF0C\u81EA\u5DF1\u5374\u7ECF\u5E38\u716E\u7897\u9762\u6761\u51D1\u5408\u3002\u90BB\u5C45\u4EEC\u6253\u8DA3\u8BF4\u4ED6\u5BF9\u732B\u6BD4\u5BF9\u4EB2\u5B59\u5B50\u8FD8\u4EB2\uFF0C\u4ED6\u4E0D\u4EE5\u4E3A\u7136\u5730\u8BF4\u732B\u4E0D\u9876\u5634\uFF0C\u6BD4\u4EBA\u5F3A\u3002\u4E09\u53EA\u732B\u91CC\u4ED6\u6700\u75BC\u70AE\uFF0C\u56E0\u4E3A\u90A3\u53EA\u6700\u8C03\u76AE\uFF0C\u603B\u7231\u8DF3\u5230\u68CB\u76D8\u4E0A\u6363\u4E71\uFF0C\u628A\u68CB\u5B50\u62E8\u5F97\u6EE1\u5730\u90FD\u662F\uFF0C\u4ED6\u5634\u4E0A\u9A82\u7740\u5C0F\u755C\u751F\uFF0C\u624B\u4E0A\u5374\u8F7B\u67D4\u5F97\u5F88\u3002\n\n\u9000\u4F11\u524D\u5728\u673A\u5173\u91CC\u4EE5\u813E\u6C14\u5014\u95FB\u540D\uFF0C\u8C01\u7684\u9762\u5B50\u90FD\u4E0D\u7ED9\u3002\u5F53\u5E74\u5355\u4F4D\u5206\u623F\u5B50\uFF0C\u4ED6\u636E\u7406\u529B\u4E89\u5E2E\u540C\u4E8B\u4E89\u53D6\u5230\u4E86\u8BE5\u6709\u7684\u9762\u79EF\uFF0C\u5F97\u7F6A\u4E86\u4E0D\u5C11\u9886\u5BFC\uFF0C\u81EA\u5DF1\u5374\u6CA1\u635E\u5230\u534A\u70B9\u597D\u5904\u3002\u8001\u4F34\u4E94\u5E74\u524D\u8D70\u4E86\u4E4B\u540E\uFF0C\u4ED6\u8BDD\u5C11\u4E86\u8BB8\u591A\uFF0C\u4F46\u813E\u6C14\u53CD\u800C\u66F4\u5927\u4E86\uFF0C\u7ECF\u5E38\u5728\u4E1A\u4E3B\u7FA4\u91CC\u53D1\u957F\u6587\u6295\u8BC9\u697C\u4E0A\u4F4F\u6237\u7684\u566A\u97F3\u95EE\u9898\uFF0C\u52A8\u8F84\u4E0A\u5343\u5B57\uFF0C\u5F15\u7ECF\u636E\u5178\uFF0C\u903B\u8F91\u6E05\u6670\u5F97\u50CF\u5728\u5199\u8BBA\u6587\u3002\u513F\u5973\u90FD\u5728\u5916\u5730\u5DE5\u4F5C\uFF0C\u9022\u5E74\u8FC7\u8282\u624D\u56DE\u6765\uFF0C\u4ED6\u5634\u4E0A\u8BF4\u4E0D\u9700\u8981\u4EBA\u966A\uFF0C\u4F46\u6BCF\u6B21\u89C6\u9891\u901A\u8BDD\u90FD\u820D\u4E0D\u5F97\u5148\u6302\u65AD\u3002\n\n\u5C0F\u533A\u91CC\u7684\u8001\u4EBA\u90FD\u77E5\u9053\u4ED6\u68CB\u827A\u9AD8\u8D85\uFF0C\u7ECF\u5E38\u6709\u4EBA\u6155\u540D\u6765\u5207\u78CB\u3002\u4ED6\u6709\u4E2A\u4E0D\u6210\u6587\u7684\u89C4\u77E9\uFF1A\u8F93\u4E86\u4E0D\u8BB8\u8D70\uFF0C\u81F3\u5C11\u8981\u590D\u76D8\u4E09\u904D\u624D\u653E\u4EBA\u3002\u6709\u4E9B\u65B0\u624B\u88AB\u4ED6\u8BAD\u5F97\u7070\u5934\u571F\u8138\uFF0C\u4F46\u4E8B\u540E\u90FD\u8BF4\u8DDF\u4ED6\u4E0B\u68CB\u786E\u5B9E\u957F\u8FDB\u5FEB\u3002\u4ED6\u81EA\u5DF1\u603B\u7ED3\u4E86\u4E00\u5957\u68CB\u8C31\u5FC3\u5F97\uFF0C\u7528\u6BDB\u7B14\u5C0F\u6977\u5DE5\u5DE5\u6574\u6574\u5730\u6284\u5728\u5BA3\u7EB8\u4E0A\uFF0C\u9501\u5728\u62BD\u5C49\u91CC\u5F53\u5B9D\u8D1D\uFF0C\u8C01\u60F3\u770B\u90FD\u4E0D\u7ED9\u3002\u5076\u5C14\u5174\u81F4\u6765\u4E86\u4E5F\u4F1A\u6559\u5C0F\u5B69\u5B50\u4E0B\u68CB\uFF0C\u6559\u8D77\u6765\u683C\u5916\u8010\u5FC3\uFF0C\u548C\u5E73\u65F6\u7684\u66B4\u813E\u6C14\u5224\u82E5\u4E24\u4EBA\u3002\n\n\u8868\u9762\u770B\u8D77\u6765\u51B7\u6F20\u4E25\u8083\uFF0C\u5176\u5B9E\u5FC3\u5730\u5584\u826F\u5F97\u5F88\u3002\u9694\u58C1\u5355\u5143\u7684\u738B\u5976\u5976\u817F\u811A\u4E0D\u65B9\u4FBF\uFF0C\u4ED6\u5634\u4E0A\u5ACC\u4EBA\u5BB6\u4E8B\u591A\uFF0C\u5374\u6BCF\u5929\u9ED8\u9ED8\u5E2E\u5FD9\u628A\u62A5\u7EB8\u548C\u5FEB\u9012\u653E\u5230\u95E8\u53E3\u3002\u697C\u4E0B\u6D41\u6D6A\u732B\u751F\u4E86\u4E00\u7A9D\u5D3D\uFF0C\u4ED6\u4E8C\u8BDD\u4E0D\u8BF4\u4E70\u4E86\u4E00\u7BB1\u732B\u7CAE\u653E\u5728\u697C\u9053\u89D2\u843D\u3002\u5C0F\u533A\u7269\u4E1A\u7684\u4EBA\u8BF4\uFF0C\u8001\u5218\u5934\u8FD9\u4E2A\u4EBA\u786E\u5B9E\u96BE\u4F3A\u5019\uFF0C\u4E09\u5929\u4E24\u5934\u6295\u8BC9\uFF0C\u4F46\u4E5F\u662F\u6700\u8BA9\u4EBA\u656C\u4F69\u7684\u4F4F\u6237\uFF0C\u662F\u90A3\u79CD\u5014\u5F97\u6709\u9AA8\u6C14\u3001\u70ED\u5FC3\u80A0\u5374\u5634\u786C\u5FC3\u8F6F\u7684\u8001\u5934\u3002"
