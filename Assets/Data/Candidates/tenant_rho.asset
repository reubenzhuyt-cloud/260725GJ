  activityType: 0
  displayName: "\u94B1\u591A\u591A"
  avatarColor: {r: 0.45, g: 0.3, b: 0.15, a: 1}
  shortDescription: "\u94B1\u591A\u591A\uFF0C\u4E09\u5341\u516D\u5C81\uFF0C\u91D1\u878D\u884C\u4E1A\u8D44\u6DF1\u7406\u8D22\u987E\u95EE\uFF0C\u6234\u7740\u91D1\u4E1D\u773C\u955C\uFF0C\u8BF4\u8BDD\u6162\u6761\u65AF\u7406\u5374\u5B57\u5B57\u73E0\u7391\uFF0C\u5BF9\u6570\u5B57\u6781\u5176\u654F\u611F\uFF0C\u4E70\u68F5\u8471\u90FD\u8981\u7B97\u6027\u4EF7\u6BD4\u3002\u4E3A\u4EBA\u7CBE\u660E\u4F46\u4E0D\u5C0F\u6C14\uFF0C\u7ECF\u5E38\u4E3B\u52A8\u7ED9\u90BB\u5C45\u5206\u6790\u57FA\u91D1\u8D70\u52BF\u548C\u7406\u8D22\u4EA7\u54C1\u7684\u6536\u76CA\u7387\uFF0C\u8BB2\u89E3\u8D77\u6765\u5934\u5934\u662F\u9053\u3002\u623F\u95F4\u91CC\u8D34\u6EE1\u4E86\u5404\u79CDK\u7EBF\u56FE\u548C\u8D22\u7ECF\u62A5\u8868\uFF0C\u7535\u8111\u5C4F\u5E55\u4E0A\u6C38\u8FDC\u5F00\u7740\u4E09\u56DB\u4E2A\u7092\u80A1\u8F6F\u4EF6\uFF0C\u90BB\u5C45\u4EEC\u90FD\u4EE5\u4E3A\u4ED6\u662F\u80A1\u795E\u8F6C\u4E16\u3002\u5176\u5B9E\u53BB\u5E74\u5728\u4E00\u53EA\u5996\u80A1\u4E0A\u4E8F\u4E86\u4E0D\u5C11\u94B1\uFF0C\u53EA\u662F\u4ECE\u6765\u4E0D\u5728\u5916\u4EBA\u9762\u524D\u627F\u8BA4\uFF0C\u53EA\u8BF4\"\u6682\u65F6\u6D6E\u4E8F\u800C\u5DF2\"\u3002"
  detailedDescription: "\u94B1\u591A\u591A\uFF0C\u4ECA\u5E74\u4E09\u5341\u516D\u5C81\uFF0C\u5728\u4E00\u5BB6\u4E2D\u578B\u8BC1\u5238\u516C\u53F8\u505A\u7406\u8D22\u987E\u95EE\u3002\u6BCF\u5929\u7A7F\u7740\u7B14\u633A\u7684\u897F\u88C5\u51FA\u95E8\uFF0C\u5934\u53D1\u68B3\u5F97\u4E00\u4E1D\u4E0D\u82DF\uFF0C\u76AE\u978B\u64E6\u5F97\u80FD\u7167\u51FA\u4EBA\u5F71\u3002\u5728\u5916\u4EBA\u770B\u6765\uFF0C\u4ED6\u5C31\u662F\u6807\u51C6\u7684\u91D1\u878D\u7CBE\u82F1\uFF0C\u4F46\u4ED6\u81EA\u5DF1\u5FC3\u91CC\u6E05\u695A\uFF0C\u6BCF\u4E2A\u6708\u7684\u5DE5\u8D44\u6263\u5B8C\u623F\u79DF\u548C\u751F\u6D3B\u8D39\uFF0C\u80FD\u5269\u4E0B\u7684\u5E76\u4E0D\u7B97\u591A\u3002\n\n\u4ED6\u5BF9\u6570\u5B57\u6709\u4E00\u79CD\u8FD1\u4E4E\u504F\u6267\u7684\u654F\u611F\u3002\u53BB\u8D85\u5E02\u4E70\u83DC\uFF0C\u4ED6\u80FD\u5728\u8111\u5B50\u91CC\u77AC\u95F4\u7B97\u51FA\u6BCF\u514B\u5355\u4EF7\uFF0C\u7136\u540E\u8D27\u6BD4\u4E09\u5BB6\u9009\u51FA\u6027\u4EF7\u6BD4\u6700\u9AD8\u7684\u90A3\u4E00\u4EFD\u3002\u6709\u4E00\u6B21\u90BB\u5C45\u5F20\u963F\u59E8\u4E70\u4E86\u4E2A\u7406\u8D22\u4EA7\u54C1\uFF0C\u5E74\u5316\u6536\u76CA\u5199\u7740\u767E\u5206\u4E4B\u4E94\u70B9\u516D\uFF0C\u4ED6\u62FF\u8FC7\u5BA3\u4F20\u5355\u770B\u4E86\u4E09\u5206\u949F\uFF0C\u786C\u662F\u5206\u6790\u51FA\u91CC\u9762\u9690\u85CF\u7684\u98CE\u9669\u6761\u6B3E\uFF0C\u628A\u5F20\u963F\u59E8\u8BF4\u5F97\u5FC3\u670D\u53E3\u670D\uFF0C\u6700\u540E\u8FD8\u771F\u542C\u4E86\u4ED6\u7684\u5EFA\u8BAE\u6362\u4E86\u4EA7\u54C1\u3002\n\n\u4ED6\u7684\u623F\u95F4\u582A\u79F0\u4E00\u4E2A\u5C0F\u578B\u8BC1\u5238\u4EA4\u6613\u6240\u3002\u5899\u4E0A\u8D34\u6EE1\u4E86\u5404\u79CDK\u7EBF\u56FE\u3001\u5747\u7EBF\u5206\u6790\u548C\u8D22\u7ECF\u526A\u62A5\uFF0C\u7535\u8111\u5C4F\u5E55\u4E0A\u6C38\u8FDC\u5F00\u7740\u4E09\u56DB\u4E2A\u7092\u80A1\u8F6F\u4EF6\u3002\u90BB\u5C45\u4EEC\u6765\u4E32\u95E8\uFF0C\u770B\u5230\u8FD9\u9635\u4ED7\u90FD\u4EE5\u4E3A\u4ED6\u662F\u9690\u85CF\u7684\u80A1\u795E\uFF0C\u7EB7\u7EB7\u6765\u8BF7\u6559\u7092\u80A1\u79D8\u8BC0\u3002\u4ED6\u603B\u662F\u63A8\u63A8\u773C\u955C\uFF0C\u4E00\u8138\u9AD8\u6DF1\u5730\u8BF4\"\u80A1\u5E02\u6709\u98CE\u9669\uFF0C\u5165\u5E02\u9700\u8C28\u614E\"\uFF0C\u7136\u540E\u7ED9\u4EBA\u63A8\u8350\u4E00\u5806\u7A33\u5065\u578B\u57FA\u91D1\u3002\u5176\u5B9E\u4ED6\u81EA\u5DF1\u53BB\u5E74\u5728\u4E00\u53EA\u5996\u80A1\u4E0A\u683D\u4E86\u8DDF\u5934\uFF0C\u4E8F\u4E86\u5C06\u8FD1\u534A\u5E74\u5DE5\u8D44\uFF0C\u8FD9\u4EF6\u4E8B\u53EA\u6709\u4ED6\u81EA\u5DF1\u77E5\u9053\u3002\n\n\u94B1\u591A\u591A\u867D\u7136\u7CBE\u6253\u7EC6\u7B97\uFF0C\u4F46\u4E3A\u4EBA\u5E76\u4E0D\u62A0\u95E8\u3002\u5C0F\u533A\u91CC\u8C01\u5BB6\u5B69\u5B50\u8981\u4EA4\u5B66\u8D39\u624B\u5934\u7D27\uFF0C\u4ED6\u4E8C\u8BDD\u4E0D\u8BF4\u5C31\u501F\u94B1\u5E2E\u5FD9\uFF0C\u4ECE\u6765\u4E0D\u50AC\u7740\u8FD8\u3002\u4ED6\u8BF4\u94B1\u8FD9\u4E1C\u897F\uFF0C\u751F\u4E0D\u5E26\u6765\u6B7B\u4E0D\u5E26\u53BB\uFF0C\u591F\u82B1\u5C31\u884C\u3002\u4F46\u8BF4\u5B8C\u8FD9\u8BDD\uFF0C\u4ED6\u53C8\u4F1A\u8865\u4E0A\u4E00\u53E5\uFF1A\"\u4E0D\u8FC7\u8BE5\u7701\u7684\u5730\u65B9\u8FD8\u662F\u8981\u7701\u7684\u3002\"\n\n\u4ED6\u6700\u5927\u7684\u7231\u597D\u5C31\u662F\u6BCF\u5929\u665A\u4E0A\u6536\u770B\u8D22\u7ECF\u9891\u9053\uFF0C\u4E00\u8FB9\u770B\u4E00\u8FB9\u5728\u672C\u5B50\u4E0A\u8BB0\u7B14\u8BB0\u3002\u7B14\u8BB0\u672C\u5DF2\u7ECF\u6512\u4E86\u539A\u539A\u4E00\u645E\uFF0C\u6309\u5E74\u4EFD\u6392\u5217\u5F97\u6574\u6574\u9F50\u9F50\u3002\u4ED6\u8BF4\u8FD9\u4E9B\u7B14\u8BB0\u662F\u4ED6\u8FD9\u4E9B\u5E74\u6700\u5B9D\u8D35\u7684\u8D22\u5BCC\uFF0C\u6BD4\u8D26\u6237\u91CC\u7684\u6570\u5B57\u503C\u94B1\u591A\u4E86\u3002\u9022\u5E74\u8FC7\u8282\u56DE\u8001\u5BB6\uFF0C\u4EB2\u621A\u4EEC\u90FD\u6392\u961F\u7B49\u7740\u4ED6\u5206\u6790\u6765\u5E74\u7684\u7ECF\u6D4E\u5F62\u52BF\uFF0C\u4ED6\u5C31\u8DDF\u5F00\u8BB2\u5EA7\u4E00\u6837\uFF0C\u6ED4\u6ED4\u4E0D\u7EDD\u5730\u8BB2\u4E0A\u4E00\u4E24\u4E2A\u5C0F\u65F6\u3002\u56DE\u5230\u57CE\u91CC\u4E4B\u540E\uFF0C\u4ED6\u8FD8\u4F1A\u4E13\u95E8\u6574\u7406\u4E00\u4EFD\"\u5E74\u5EA6\u6295\u8D44\u5C55\u671B\"\u53D1\u5230\u5BB6\u65CF\u7FA4\u91CC\uFF0C\u4EB2\u621A\u4EEC\u90FD\u5C01\u4ED6\u4E3A\"\u6C11\u95F4\u7ECF\u6D4E\u5B66\u5BB6\"\uFF0C\u4ED6\u542C\u4E86\u9887\u4E3A\u5F97\u610F\uFF0C\u8FDE\u8D70\u8DEF\u90FD\u5E26\u98CE\u3002"
