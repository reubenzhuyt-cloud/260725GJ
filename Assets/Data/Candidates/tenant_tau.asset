  activityType: 0
  displayName: "\u4F55\u5927\u58EE"
  avatarColor: {r: 0.7, g: 0.3, b: 0.5, a: 1}
  shortDescription: "\u4F55\u5927\u58EE\uFF0C\u4E09\u5341\u516B\u5C81\uFF0C\u5EFA\u7B51\u5DE5\u5730\u7684\u8001\u5E08\u5085\uFF0C\u5E72\u4E86\u5341\u4E94\u5E74\u7684\u6CE5\u74E6\u5320\uFF0C\u8EAB\u6750\u9B41\u68A7\u58EE\u5B9E\uFF0C\u8180\u5927\u8170\u5706\uFF0C\u4E00\u4E2A\u4EBA\u80FD\u642C\u52A8\u53CC\u5F00\u95E8\u51B0\u7BB1\u4E0A\u516D\u697C\u4E0D\u5E26\u6B47\u6C14\u3002\u4E3A\u4EBA\u61A8\u539A\u8001\u5B9E\uFF0C\u4ECE\u6765\u4E0D\u4E0E\u4EBA\u4E89\u6267\uFF0C\u90BB\u91CC\u95F4\u6709\u4EC0\u4E48\u529B\u6C14\u6D3B\u90FD\u627E\u4ED6\u5E2E\u5FD9\uFF0C\u4ED6\u653E\u4E0B\u7897\u7B77\u5C31\u6765\u4ECE\u4E0D\u63A8\u8F9E\u3002\u996D\u91CF\u60CA\u4EBA\uFF0C\u4E00\u987F\u80FD\u5403\u4E94\u7897\u996D\u5916\u52A0\u4E00\u76D8\u7EA2\u70E7\u8089\u548C\u4E24\u4E2A\u8377\u5305\u86CB\uFF0C\u90BB\u5C45\u770B\u4E86\u90FD\u5FC3\u75BC\u4ED6\u7684\u94B1\u5305\u3002\u4ED6\u8BF4\u5E72\u4F53\u529B\u6D3B\u4E0D\u5403\u9971\u54EA\u6709\u529B\u6C14\u5E72\u6D3B\uFF0C\u8EAB\u4F53\u624D\u662F\u9769\u547D\u7684\u672C\u94B1\uFF0C\u997F\u7740\u809A\u5B50\u4E0A\u5DE5\u5730\u5BB9\u6613\u51FA\u5B89\u5168\u4E8B\u6545\u3002"
  detailedDescription: "\u4F55\u5927\u58EE\uFF0C\u4ECA\u5E74\u4E09\u5341\u516B\u5C81\uFF0C\u662F\u4E00\u540D\u5EFA\u7B51\u5DE5\u5730\u4E0A\u7684\u8001\u5E08\u5085\uFF0C\u5E72\u8FD9\u884C\u5DF2\u7ECF\u5FEB\u5341\u4E94\u5E74\u4E86\u3002\u4ED6\u8EAB\u6750\u9AD8\u5927\u9B41\u68A7\uFF0C\u8180\u5927\u8170\u5706\uFF0C\u80F3\u818A\u6BD4\u4E00\u822C\u4EBA\u7684\u5927\u817F\u8FD8\u7C97\u3002\u5DE5\u53CB\u4EEC\u90FD\u8BF4\u4ED6\u662F\u5929\u751F\u5E72\u5DE5\u5730\u7684\u6599\uFF0C\u4E00\u767E\u65A4\u7684\u6C34\u6CE5\u625B\u4E0A\u80A9\u8DDF\u73A9\u513F\u4F3C\u7684\uFF0C\u53CC\u5F00\u95E8\u51B0\u7BB1\u4E00\u4E2A\u4EBA\u5C31\u80FD\u4ECE\u4E00\u697C\u642C\u5230\u516D\u697C\uFF0C\u4E2D\u95F4\u4E0D\u5E26\u6B47\u6C14\u7684\u3002\n\n\u522B\u770B\u4ED6\u4E94\u5927\u4E09\u7C97\uFF0C\u6027\u683C\u5374\u6E29\u987A\u5F97\u5F88\u3002\u5728\u5DE5\u5730\u4E0A\u4ECE\u6765\u4E0D\u8DDF\u4EBA\u7EA2\u8138\uFF0C\u9047\u5230\u65B0\u6765\u7684\u5E74\u8F7B\u4EBA\u4E0D\u61C2\u89C4\u77E9\uFF0C\u4ED6\u4E5F\u53EA\u662F\u7B11\u5475\u5475\u5730\u63D0\u9192\u4E24\u53E5\u3002\u5C0F\u533A\u91CC\u7684\u90BB\u5C45\u4EEC\u90FD\u559C\u6B22\u627E\u4ED6\u5E2E\u5FD9\uFF0C\u6362\u706F\u6CE1\u3001\u642C\u5BB6\u5177\u3001\u4FEE\u6C34\u7BA1\uFF0C\u53EA\u8981\u558A\u4E00\u58F0\uFF0C\u4ED6\u653E\u4E0B\u624B\u91CC\u7684\u996D\u7897\u5C31\u6765\u3002\u6709\u65F6\u5019\u5E2E\u5FD9\u5E2E\u5230\u4E00\u534A\uFF0C\u4EBA\u5BB6\u8FC7\u610F\u4E0D\u53BB\u8981\u7ED9\u4ED6\u94B1\uFF0C\u4ED6\u6446\u6446\u624B\u8BF4\u90BB\u91CC\u4E4B\u95F4\u5E2E\u4E2A\u5FD9\u7B97\u4EC0\u4E48\uFF0C\u641E\u5F97\u4EBA\u5BB6\u66F4\u4E0D\u597D\u610F\u601D\u4E86\u3002\n\n\u4F55\u5927\u58EE\u6700\u51FA\u540D\u7684\u5C31\u662F\u4ED6\u7684\u996D\u91CF\u3002\u6BCF\u5929\u4E2D\u5348\u5728\u5DE5\u5730\u4E0A\uFF0C\u522B\u4EBA\u5403\u4E00\u76D2\u76D2\u996D\u5C31\u9971\u4E86\uFF0C\u4ED6\u8981\u5403\u4E09\u76D2\u624D\u52C9\u5F3A\u591F\u3002\u56DE\u5230\u5BB6\u91CC\uFF0C\u665A\u996D\u4E00\u987F\u80FD\u6252\u62C9\u4E94\u7897\u7C73\u996D\uFF0C\u518D\u914D\u4E0A\u4E00\u5927\u76D8\u7EA2\u70E7\u8089\u548C\u4E24\u4E2A\u8377\u5305\u86CB\u3002\u4ED6\u8001\u5A46\u6BCF\u6B21\u505A\u996D\u90FD\u8981\u7528\u6700\u5927\u7684\u9505\uFF0C\u90BB\u5C45\u8DEF\u8FC7\u4ED6\u5BB6\u95E8\u53E3\u95FB\u5230\u996D\u83DC\u9999\u5473\uFF0C\u90FD\u6253\u8DA3\u8BF4\u4F55\u5927\u58EE\u5BB6\u5F00\u98DF\u5802\u5462\u3002\u4ED6\u81EA\u5DF1\u5012\u4E0D\u89C9\u5F97\u6709\u4EC0\u4E48\uFF0C\u7406\u76F4\u6C14\u58EE\u5730\u8BF4\u5E72\u4F53\u529B\u6D3B\u6D88\u8017\u5927\uFF0C\u4E0D\u5403\u9971\u600E\u4E48\u6709\u529B\u6C14\u5E72\u6D3B\u3002\n\n\u4ED6\u6709\u4E00\u4E2A\u575A\u6301\u591A\u5E74\u7684\u4E60\u60EF\uFF0C\u5C31\u662F\u6BCF\u5929\u4E0B\u73ED\u540E\u8981\u53BB\u5C0F\u533A\u7684\u5065\u8EAB\u5668\u6750\u90A3\u91CC\u505A\u51E0\u7EC4\u5F15\u4F53\u5411\u4E0A\u3002\u522B\u770B\u90A3\u4E9B\u5668\u6750\u662F\u7ED9\u8001\u5E74\u4EBA\u8BBE\u8BA1\u7684\uFF0C\u5230\u4E86\u4ED6\u624B\u91CC\u5C31\u50CF\u4E13\u4E1A\u5065\u8EAB\u8BBE\u5907\u4E00\u6837\u3002\u5355\u81C2\u5F15\u4F53\u5411\u4E0A\u3001\u53CC\u529B\u81C2\uFF0C\u4ED6\u505A\u8D77\u6765\u9762\u4E0D\u6539\u8272\u3002\u5C0F\u533A\u91CC\u7684\u5C0F\u670B\u53CB\u4EEC\u90FD\u559C\u6B22\u56F4\u7740\u4ED6\u770B\uFF0C\u53EB\u4ED6\"\u5927\u529B\u53D4\u53D4\"\uFF0C\u4ED6\u5C31\u8D81\u673A\u6559\u5B69\u5B50\u4EEC\u505A\u4FEF\u5367\u6491\uFF0C\u8BF4\u4ECE\u5C0F\u953B\u70BC\u8EAB\u4F53\u597D\u3002\n\n\u4F55\u5927\u58EE\u7684\u8001\u5BB6\u5728\u519C\u6751\uFF0C\u7236\u6BCD\u5E74\u7EAA\u5927\u4E86\u8EAB\u4F53\u4E0D\u597D\uFF0C\u4ED6\u6BCF\u4E2A\u6708\u5DE5\u8D44\u7684\u4E00\u5927\u534A\u90FD\u5BC4\u56DE\u8001\u5BB6\u3002\u81EA\u5DF1\u7701\u5403\u4FED\u7528\uFF0C\u8863\u670D\u7834\u4E86\u7F1D\u7F1D\u8865\u8865\u7EE7\u7EED\u7A7F\u3002\u4ED6\u8BF4\u57CE\u91CC\u751F\u6D3B\u4E0D\u5BB9\u6613\uFF0C\u4F46\u53EA\u8981\u7236\u6BCD\u8EAB\u4F53\u597D\u3001\u5B69\u5B50\u80FD\u4E0A\u5B66\uFF0C\u518D\u82E6\u518D\u7D2F\u90FD\u503C\u5F97\u3002\u5DE5\u53CB\u4EEC\u90FD\u8BF4\u4F55\u5927\u58EE\u662F\u5DE5\u5730\u4E0A\u6700\u5B9E\u5728\u7684\u4EBA\uFF0C\u4ECE\u6765\u4E0D\u5077\u5978\u800D\u6ED1\uFF0C\u4EA4\u4EE3\u7684\u6D3B\u4E00\u5B9A\u5E72\u5F97\u6F02\u6F02\u4EAE\u4EAE\u3002\u6BCF\u5230\u5E74\u5E95\u7ED3\u5B8C\u5DE5\u94B1\uFF0C\u4ED6\u603B\u662F\u7B2C\u4E00\u4E2A\u7ED9\u8001\u5BB6\u6C47\u6B3E\u7684\u4EBA\uFF0C\u7136\u540E\u624D\u7ED9\u81EA\u5DF1\u6DFB\u4E00\u4EF6\u65B0\u68C9\u8884\u3002"
